<div class="mobile-header-spacer d-block d-lg-none" style="height: 70px;"></div>

@{
    ViewData["Title"] = "Управление подпиской";
    var userId = Context.Session.GetInt32("UserId");
    var userEmail = Context.Session.GetString("UserEmail");
}

<form id="antiForgeryForm" style="display: none;">
    @Html.AntiForgeryToken()
</form>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы в стиле сайта -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-envelope-open-text text-white"></i>
                </div>
                <div class="page-header-content">
                    <h1 class="page-title">
                        Управление подпиской
                    </h1>
                    <p class="page-subtitle">Управляйте вашей email-рассылкой</p>
                </div>
            </div>

            @if (userId == null)
            {
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-5 text-center">
                                <div class="mb-4">
                                    <i class="fas fa-lock text-primary" style="font-size: 4rem;"></i>
                                </div>
                                <h3 class="fw-bold mb-3">Требуется авторизация</h3>
                                <p class="text-muted mb-4">
                                    Для управления подпиской необходимо войти в аккаунт.
                                </p>
                                <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5">
                                        <i class="fas fa-sign-in-alt me-2"></i>Войти
                                    </a>
                                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-5">
                                        <i class="fas fa-user-plus me-2"></i>Зарегистрироваться
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <div id="subscriptionStatus">
                                    <div class="bg-light p-4 rounded-3">
                                        <div class="user-section">
                                            <div class="avatar-circle bg-primary" style="width: 60px; height: 60px;">
                                                <i class="fas fa-user fa-2x text-white"></i>
                                            </div>
                                            <div class="user-info-container">
                                                <h5 class="fw-bold user-email mb-1">@userEmail</h5>
                                                <p class="text-muted mb-0 small subscribed-date" id="subscribedDate">Загрузка информации...</p>
                                            </div>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button type="button" class="btn btn-danger btn-lg" id="unsubscribeBtn">
                                                <i class="fas fa-bell-slash me-2"></i>Отписаться от рассылки
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div id="successMessage" style="display: none;">
                                    <div class="text-center py-4">
                                        <div class="mb-4">
                                            <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                                        </div>
                                        <h3 class="h5 mb-3" id="successText"></h3>
                                        <p class="text-muted mb-4" id="successDetails"></p>
                                        <a href="/" class="btn btn-primary btn-lg">
                                            <i class="fas fa-home me-2"></i>На главную
                                        </a>
                                    </div>
                                </div>

                                <div id="loadingSpinner" style="display: none;" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Загрузка...</span>
                                    </div>
                                    <p class="mt-3 text-muted">Загрузка информации...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Стили для заголовка страницы (унифицированные) */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

        .page-header-icon i {
            color: white !important;
        }

    .page-header-content {
        flex: 1;
        min-width: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
        word-break: break-word;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        line-height: 1.4;
        word-break: break-word;
    }

    /* Стили для карточек */
    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

    /* Аватар */
    .avatar-circle {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg, #0379D9, #40B624);
        color: white;
        flex-shrink: 0;
    }

    /* Контейнер для информации пользователя */
    .user-info-container {
        min-width: 0;
        flex: 1;
    }

    /* Email адрес - перенос длинных строк */
    .user-email {
        word-break: break-all;
        overflow-wrap: break-word;
        margin-bottom: 0.25rem;
        font-size: 1rem;
    }

    /* Кнопки */
    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
        padding: 12px 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-primary {
        background: #0379D9;
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
        color: white;
    }

        .btn-primary:hover {
            background: #0356a8;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
            color: white;
        }

        .btn-primary i {
            color: white !important;
        }

    .btn-outline-primary {
        border: 2px solid #0379D9;
        color: #0379D9;
        background: transparent;
    }

        .btn-outline-primary:hover {
            background: #0379D9;
            color: white;
            transform: translateY(-2px);
        }

            .btn-outline-primary:hover i {
                color: white !important;
            }

    .btn-danger {
        background: #dc3545;
        border: none;
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        color: white;
    }

        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(220, 53, 69, 0.3);
            color: white;
        }

        .btn-danger i {
            color: white !important;
        }

    .btn-success {
        background: #40B624;
        border: none;
        box-shadow: 0 4px 12px rgba(64, 182, 36, 0.2);
        color: white;
    }

        .btn-success:hover {
            background: #33991b;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(64, 182, 36, 0.3);
            color: white;
        }

        .btn-success i {
            color: white !important;
        }

    .btn-lg {
        padding: 14px 30px;
        font-size: 1.1rem;
    }

    /* Фон для секции подписки */
    .bg-light {
        background: linear-gradient(135deg, #f8fafc, #f1f5f9) !important;
        border: 1px solid #e2e8f0;
    }

    .rounded-3 {
        border-radius: 16px !important;
    }

    /* Уведомления */
    .alert-warning {
        background: #fff3cd;
        border: 1px solid #ffec99;
        border-radius: 12px;
        color: #856404;
    }

        .alert-warning .alert-link {
            color: #0379D9;
            font-weight: 600;
            text-decoration: none;
        }

            .alert-warning .alert-link:hover {
                text-decoration: underline;
            }

    /* Секция с пользователем */
    .user-section {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    /* Анимации */
    .spinner-border {
        width: 3rem;
        height: 3rem;
    }

    /* ========== МОБИЛЬНАЯ АДАПТАЦИЯ ========== */

    /* Мобильный отступ (если нужен) */
    .mobile-header-spacer {
        display: none;
    }

    @@media (max-width: 768px) {
        /* Шапка */
        .page-header-section

    {
        padding: 20px;
        gap: 15px;
    }

    .page-header-section::before {
        width: 100%;
        height: 6px;
        top: 0;
        left: 0;
        background: linear-gradient(to right, #0379D9, #40B624);
    }

    .page-header-icon {
        width: 55px;
        height: 55px;
        font-size: 1.5rem;
    }

    .page-title {
        font-size: 1.6rem;
        margin-bottom: 4px;
    }

    .page-subtitle {
        font-size: 0.95rem;
    }

    /* Секция с пользователем - вертикально на мобилке */
    .user-section {
        flex-direction: column;
        text-align: center;
        gap: 12px;
    }

    /* Аватар на мобилке */
    .avatar-circle {
        width: 50px;
        height: 50px;
        margin-bottom: 0;
    }

        .avatar-circle i {
            font-size: 1.5rem;
        }

    /* Контейнер информации */
    .user-info-container {
        text-align: center;
        width: 100%;
    }

    /* Email на мобилке */
    .user-email {
        font-size: 0.9rem;
        word-break: break-all;
    }

    /* Дата подписки на мобилке */
    .subscribed-date {
        font-size: 0.75rem;
    }

    /* Кнопки */
    .btn-lg {
        padding: 12px 24px;
        font-size: 1rem;
    }

    .btn {
        width: 100%;
    }

    /* Карточка */
    .card-body {
        padding: 1.25rem;
    }

    .bg-light {
        padding: 1.25rem !important;
    }

    }

    @@media (max-width: 576px) {
        /* Шапка */
        .page-header-section

    {
        padding: 15px;
        gap: 12px;
    }

    .page-header-icon {
        width: 48px;
        height: 48px;
        font-size: 1.3rem;
    }

    .page-title {
        font-size: 1.4rem;
    }

    .page-subtitle {
        font-size: 0.85rem;
    }

    /* Email на маленьких экранах */
    .user-email {
        font-size: 0.8rem;
    }

    /* Кнопки */
    .btn-lg {
        padding: 10px 20px;
        font-size: 0.95rem;
    }

    /* Карточка */
    .card-body {
        padding: 1rem;
    }

    .bg-light {
        padding: 1rem !important;
    }

    /* Аватар */
    .avatar-circle {
        width: 45px;
        height: 45px;
    }

        .avatar-circle i {
            font-size: 1.3rem;
        }

    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const userId = @Json.Serialize(Context.Session.GetInt32("UserId"));
            const userEmail = @Json.Serialize(Context.Session.GetString("UserEmail"));

            if (!userId) return;

            const unsubscribeBtn = document.getElementById('unsubscribeBtn');
            const subscriptionStatus = document.getElementById('subscriptionStatus');
            const successMessage = document.getElementById('successMessage');
            const loadingSpinner = document.getElementById('loadingSpinner');
            const subscribedDateSpan = document.getElementById('subscribedDate');

            // Загружаем информацию о подписке
            async function loadSubscriptionStatus() {
                try {
                    loadingSpinner.style.display = 'block';
                    subscriptionStatus.style.display = 'none';

                    const response = await fetch(`/Newsletter/CheckSubscription?email=${encodeURIComponent(userEmail)}`);
                    const data = await response.json();

                    if (!data.error) {
                        if (data.isSubscribed) {
                            subscribedDateSpan.textContent = `Подписан(а) с ${new Date(data.subscribedAt).toLocaleDateString('ru-RU')}`;
                        } else {
                            subscribedDateSpan.textContent = 'Не подписан(а) на рассылку';
                            unsubscribeBtn.style.display = 'none';

                            // Добавляем кнопку подписки
                            const subscribeBtn = document.createElement('button');
                            subscribeBtn.type = 'button';
                            subscribeBtn.className = 'btn btn-success btn-lg mt-3';
                            subscribeBtn.innerHTML = '<i class="fas fa-bell me-2"></i>Подписаться';
                            subscribeBtn.onclick = subscribeToNewsletter;
                            document.querySelector('.bg-light .d-grid').appendChild(subscribeBtn);
                        }
                    } else {
                        subscribedDateSpan.textContent = 'Ошибка загрузки информации';
                    }
                } catch (error) {
                    console.error('Error loading subscription:', error);
                    subscribedDateSpan.textContent = 'Ошибка загрузки информации';
                } finally {
                    loadingSpinner.style.display = 'none';
                    subscriptionStatus.style.display = 'block';
                }
            }

            // Отписка
            async function unsubscribe() {
                if (!confirm('Вы уверены, что хотите отписаться от рассылки?')) return;

                try {
                    unsubscribeBtn.disabled = true;
                    unsubscribeBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Отписываемся...';

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const response = await fetch('/Newsletter/UnsubscribeFromAccount', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ email: userEmail })
                    });

                    const data = await response.json();

                    if (data.success) {
                        subscriptionStatus.style.display = 'none';
                        successMessage.style.display = 'block';
                        document.getElementById('successText').textContent = 'Вы отписались от рассылки';
                        document.getElementById('successDetails').textContent = 'Вы больше не будете получать наши письма.';
                    } else {
                        alert(data.message || 'Ошибка при отписке');
                        unsubscribeBtn.disabled = false;
                        unsubscribeBtn.innerHTML = '<i class="fas fa-bell-slash me-2"></i>Отписаться от рассылки';
                    }
                } catch (error) {
                    console.error('Error unsubscribing:', error);
                    alert('Произошла ошибка. Попробуйте позже.');
                    unsubscribeBtn.disabled = false;
                    unsubscribeBtn.innerHTML = '<i class="fas fa-bell-slash me-2"></i>Отписаться от рассылки';
                }
            }

            // Подписка
            async function subscribeToNewsletter() {
                try {
                    const formData = new FormData();
                    formData.append('email', userEmail);

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const response = await fetch('/Newsletter/Subscribe', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    const data = await response.json();

                    if (data.success) {
                        alert('Вы подписались на рассылку!');
                        location.reload();
                    } else {
                        alert(data.message || 'Ошибка при подписке');
                    }
                } catch (error) {
                    console.error('Error subscribing:', error);
                    alert('Произошла ошибка. Попробуйте позже.');
                }
            }

            if (unsubscribeBtn) {
                unsubscribeBtn.addEventListener('click', unsubscribe);
            }

            // Загружаем статус подписки
            loadSubscriptionStatus();
        });
    </script>
}