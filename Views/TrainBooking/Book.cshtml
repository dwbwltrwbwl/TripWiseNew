@model TripWise.Models.ViewModels.CompleteBookingViewModel
@{
    ViewData["Title"] = "Оформление билета";
    var isRoundTrip = Model.TrainInfo.IsRoundTrip;
}
<div class="mobile-header-spacer d-block d-lg-none" style="height: 70px;"></div>
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-ticket-alt text-white"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Оформление билета
                    </h1>
                    <p class="page-subtitle">Заполните данные пассажиров для покупки билета</p>
                </div>
            </div>

            <!-- Информация о поезде -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-train text-primary me-2"></i>
                        Информация о поезде
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <small class="text-muted">Направление</small>
                                <div class="fw-bold fs-5">
                                    @Model.TrainInfo.DepartureStationName → @Model.TrainInfo.ArrivalStationName
                                </div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Поезд</small>
                                <div class="fw-bold">№ @Model.TrainInfo.TrainNumber</div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Тип вагона</small>
                                <div class="fw-bold">@Model.TrainInfo.CarType (@Model.TrainInfo.CarClass)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <small class="text-muted">Отправление</small>
                                <div class="fw-bold">
                                    @Model.TrainInfo.DepartureDateTime.ToString("dd.MM.yyyy HH:mm")
                                </div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Прибытие</small>
                                <div class="fw-bold">
                                    @(Model.TrainInfo.ArrivalDateTime?.ToString("dd.MM.yyyy HH:mm") ?? "—")
                                </div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Время в пути</small>
                                <div class="fw-bold">
                                    @{
                                        var hours = Model.TrainInfo.Duration / 60;
                                        var minutes = Model.TrainInfo.Duration % 60;
                                    }
                                    @hours ч @minutes мин
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (isRoundTrip)
                    {
                        <div class="alert alert-info border-0 rounded-lg mt-3">
                            <i class="fas fa-exchange-alt me-2"></i>
                            <strong>Туда и обратно:</strong> также включен обратный билет
                        </div>
                    }

                    <div class="alert alert-success border-0 rounded-lg mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-tag me-2"></i>Стоимость:</span>
                            <span class="fw-bold fs-4 text-success">
                                @Model.TotalPrice.ToString("N0") ₽
                            </span>
                        </div>
                        <small class="text-muted">* за @Model.TrainInfo.Passengers пассажира</small>
                    </div>
                </div>
            </div>

            <!-- Форма данных пассажиров -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-users text-primary me-2"></i>
                        Данные пассажиров
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form id="bookingForm">
                        @Html.AntiForgeryToken()

                        <!-- Скрытые поля с данными поезда -->
                        <input type="hidden" id="trainNumber" value="@Model.TrainInfo.TrainNumber" />
                        <input type="hidden" id="departureStationId" value="@Model.TrainInfo.DepartureStationId" />
                        <input type="hidden" id="departureStationName" value="@Model.TrainInfo.DepartureStationName" />
                        <input type="hidden" id="arrivalStationId" value="@Model.TrainInfo.ArrivalStationId" />
                        <input type="hidden" id="arrivalStationName" value="@Model.TrainInfo.ArrivalStationName" />
                        <input type="hidden" id="departureDateTime" value="@Model.TrainInfo.DepartureDateTime.ToString("o")" />
                        <input type="hidden" id="arrivalDateTime" value="@(Model.TrainInfo.ArrivalDateTime?.ToString("o") ?? "")" />
                        <input type="hidden" id="price" value="@Model.TrainInfo.Price" />
                        <input type="hidden" id="passengersCount" value="@Model.TrainInfo.Passengers" />
                        <input type="hidden" id="carType" value="@Model.TrainInfo.CarType" />
                        <input type="hidden" id="carClass" value="@Model.TrainInfo.CarClass" />
                        <input type="hidden" id="duration" value="@Model.TrainInfo.Duration" />
                        <input type="hidden" id="isRoundTrip" value="@Model.TrainInfo.IsRoundTrip.ToString()" />
                        @if (isRoundTrip)
                        {
                            <input type="hidden" id="returnTrainNumber" value="@Model.TrainInfo.ReturnTrainNumber" />
                            <input type="hidden" id="returnDepartureDateTime" value="@(Model.TrainInfo.ReturnDepartureDateTime?.ToString("o") ?? "")" />
                            <input type="hidden" id="returnArrivalDateTime" value="@(Model.TrainInfo.ReturnArrivalDateTime?.ToString("o") ?? "")" />
                            <input type="hidden" id="returnDuration" value="@Model.TrainInfo.ReturnDuration" />
                        }

                        <!-- Контейнер для пассажиров -->
                        <div id="passengers-container">
                            @for (int i = 0; i < Model.Passengers.Count; i++)
                            {
                                <div class="passenger-card mb-4 p-3 border rounded" data-passenger-index="@i">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="mb-0 text-primary">Пассажир @(i + 1)</h5>
                                        @if (i > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-passenger">
                                                <i class="fas fa-trash-alt me-1"></i>Удалить
                                            </button>
                                        }
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Фамилия <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control passenger-lastname"
                                                       name="Passengers[@i].LastName"
                                                       value="@Model.Passengers[i].LastName"
                                                       maxlength="100">
                                                <div class="invalid-feedback">Введите фамилию (только буквы)</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Имя <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control passenger-firstname"
                                                       name="Passengers[@i].FirstName"
                                                       value="@Model.Passengers[i].FirstName"
                                                       maxlength="100">
                                                <div class="invalid-feedback">Введите имя (только буквы)</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Отчество</label>
                                                <input type="text" class="form-control passenger-middlename"
                                                       name="Passengers[@i].MiddleName"
                                                       value="@Model.Passengers[i].MiddleName"
                                                       maxlength="100">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Дата рождения <span class="text-danger">*</span></label>
                                                <input type="date" class="form-control passenger-birthdate"
                                                       name="Passengers[@i].DateOfBirth"
                                                       value="@(Model.Passengers[i].DateOfBirth.Year > 1900 ? Model.Passengers[i].DateOfBirth.ToString("yyyy-MM-dd") : "")">
                                                <div class="invalid-feedback">Дата не может быть в будущем</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Пол <span class="text-danger">*</span></label>
                                                <select class="form-select passenger-gender" name="Passengers[@i].Gender">
                                                    <option value="">Выберите</option>
                                                    <option value="M" selected="@(Model.Passengers[i].Gender == "M")">Мужской</option>
                                                    <option value="F" selected="@(Model.Passengers[i].Gender == "F")">Женский</option>
                                                </select>
                                                <div class="invalid-feedback">Выберите пол</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Гражданство <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control passenger-nationality"
                                                       name="Passengers[@i].Nationality"
                                                       value="@(Model.Passengers[i].Citizenship ?? "Россия")"
                                                       maxlength="50">
                                                <div class="invalid-feedback">Введите гражданство</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Тип документа <span class="text-danger">*</span></label>
                                                <select class="form-select passenger-document-type" name="Passengers[@i].DocumentType">
                                                    <option value="">Выберите</option>
                                                    <option value="passport" selected="@(Model.Passengers[i].DocumentType == "passport")">Паспорт РФ</option>
                                                    <option value="foreign_passport" selected="@(Model.Passengers[i].DocumentType == "foreign_passport")">Загранпаспорт</option>
                                                    <option value="birth_certificate" selected="@(Model.Passengers[i].DocumentType == "birth_certificate")">Свидетельство о рождении</option>
                                                </select>
                                                <div class="invalid-feedback">Выберите тип документа</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Номер документа <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control passenger-document-number"
                                                       name="Passengers[@i].DocumentNumber"
                                                       value="@Model.Passengers[i].DocumentNumber"
                                                       maxlength="10"
                                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                                <div class="invalid-feedback">Номер документа (только цифры, 4-10 символов)</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Кнопка добавления пассажира -->
                        <div class="mb-4">
                            <button type="button" class="btn btn-outline-primary" id="addPassengerBtn">
                                <i class="fas fa-plus me-2"></i>Добавить пассажира
                            </button>
                        </div>

                        <hr class="my-4">

                        <!-- Контактные данные -->
                        <h4 class="mb-3">Контактные данные</h4>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control form-control-lg" id="email"
                                           name="Contact.Email" value="@Model.Contact.Email" required>
                                    <div class="form-text">На этот email придет билет</div>
                                    <div class="invalid-feedback" id="emailError"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="phone" class="form-label fw-semibold">Телефон <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control form-control-lg" id="phone"
                                           name="Contact.Phone" value="@Model.Contact.Phone" required
                                           placeholder="+7 (___) ___-__-__"
                                           maxlength="18">
                                    <div class="form-text">Формат: +7 (XXX) XXX-XX-XX</div>
                                    <div class="invalid-feedback" id="phoneError"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Согласие -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="agreeTerms"
                                       name="Contact.AgreeToTerms" value="true" required>
                                <label class="form-check-label" for="agreeTerms">
                                    Я согласен с <a href="#" target="_blank" data-bs-toggle="modal" data-bs-target="#termsModal">условиями оформления билета</a> и
                                    <a href="#" target="_blank" data-bs-toggle="modal" data-bs-target="#rulesModal">правилами перевозки</a> <span class="text-danger">*</span>
                                </label>
                                <div class="invalid-feedback" id="agreeTermsError"></div>
                            </div>
                        </div>

                        <!-- Кнопки -->
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </a>
                            <button type="button" class="btn btn-success btn-lg" id="submitBtn">
                                <i class="fas fa-check me-2"></i>Забронировать билет
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Подключение jQuery и маски телефона -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

<style>
    /* ... все стили остаются как были ... */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        max-width: 600px;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .form-control-lg, .form-select-lg {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 14px 18px;
        font-family: 'Nunito', sans-serif;
    }

        .form-control-lg:focus, .form-select-lg:focus {
            border-color: #0379D9;
            box-shadow: 0 0 0 0.2rem rgba(3, 121, 217, 0.25);
        }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
    }

    .btn-success {
        background: #40B624;
        border: none;
        box-shadow: 0 4px 12px rgba(64, 182, 36, 0.2);
        padding: 14px 30px;
        font-size: 1.1rem;
    }

        .btn-success:hover {
            background: #33991b;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(64, 182, 36, 0.3);
        }

    .btn-outline-secondary {
        border: 2px solid #e2e8f0;
        color: #64748b;
        padding: 14px 30px;
        font-size: 1.1rem;
    }

        .btn-outline-secondary:hover {
            background: #f8fafc;
            border-color: #94a3b8;
            color: #334155;
        }

    .btn-outline-primary {
        border: 2px solid #0379D9;
        color: #0379D9;
        background: transparent;
    }

        .btn-outline-primary:hover {
            background: #0379D9;
            color: white;
        }

    .passenger-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0 !important;
        border-radius: 12px;
    }

        .passenger-card h5 {
            color: #0379D9;
            font-weight: 600;
        }

    .invalid-feedback {
        display: none;
        width: 100%;
        margin-top: 0.25rem;
        font-size: 0.875em;
        color: #dc3545;
    }

    .form-control.is-invalid, .form-select.is-invalid {
        border-color: #dc3545;
    }

    .form-control:focus {
        box-shadow: none;
    }

    @@media (max-width: 768px) {
        .page-header-section {
            flex-direction: column;
            text-align: center;
            padding: 20px;
            gap: 15px;
        }

            .page-header-section::before {
                width: 100%;
                height: 6px;
                top: 0;
                left: 0;
                background: linear-gradient(to right, #0379D9, #40B624);
            }

        .page-header-icon {
