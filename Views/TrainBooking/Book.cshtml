</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script>
        $(document).ready(function() {
            let passengerCount = $('.passenger-card').length;
            const totalPassengersLimit = 4;

            // Маска телефона
            $('#phone').mask('+7 (000) 000-00-00');

            // ================= ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =================
            function hasDigits(str) {
                return /\d/.test(str);
            }

            function isValidName(str) {
                return /^[a-zA-Zа-яА-ЯёЁ\s\-]+$/.test(str);
            }

            // ================= ВАЛИДАЦИЯ ОТДЕЛЬНОГО ПАССАЖИРА =================
            function validatePassenger(card) {
                let isValid = true;

                // Фамилия
                let lastName = card.find('.passenger-lastname').val().trim();
                if (!lastName) {
                    card.find('.passenger-lastname').addClass('is-invalid');
                    isValid = false;
                } else if (lastName.length < 2) {
                    card.find('.passenger-lastname').addClass('is-invalid');
                    isValid = false;
                } else if (lastName.length > 100) {
                    card.find('.passenger-lastname').addClass('is-invalid');
                    isValid = false;
                } else if (hasDigits(lastName)) {
                    card.find('.passenger-lastname').addClass('is-invalid');
                    isValid = false;
                } else if (!isValidName(lastName)) {
                    card.find('.passenger-lastname').addClass('is-invalid');
                    isValid = false;
                } else {
                    card.find('.passenger-lastname').removeClass('is-invalid');
                }

                // Имя
                let firstName = card.find('.passenger-firstname').val().trim();
                if (!firstName) {
                    card.find('.passenger-firstname').addClass('is-invalid');
                    isValid = false;
                } else if (firstName.length < 2) {
                    card.find('.passenger-firstname').addClass('is-invalid');
                    isValid = false;
                } else if (firstName.length > 100) {
                    card.find('.passenger-firstname').addClass('is-invalid');
                    isValid = false;
                } else if (hasDigits(firstName)) {
                    card.find('.passenger-firstname').addClass('is-invalid');
                    isValid = false;
                } else if (!isValidName(firstName)) {
                    card.find('.passenger-firstname').addClass('is-invalid');
                    isValid = false;
                } else {
                    card.find('.passenger-firstname').removeClass('is-invalid');
                }

                // Отчество
                let middleName = card.find('.passenger-middlename').val().trim();
                if (middleName) {
                    if (middleName.length > 100) {
                        card.find('.passenger-middlename').addClass('is-invalid');
                        isValid = false;
                    } else if (hasDigits(middleName)) {
                        card.find('.passenger-middlename').addClass('is-invalid');
                        isValid = false;
                    } else if (!isValidName(middleName)) {
                        card.find('.passenger-middlename').addClass('is-invalid');
                        isValid = false;
                    } else {
                        card.find('.passenger-middlename').removeClass('is-invalid');
                    }
                }

                // Дата рождения
                let birthdate = card.find('.passenger-birthdate').val();
                if (!birthdate) {
                    card.find('.passenger-birthdate').addClass('is-invalid');
                    isValid = false;
                } else {
                    let selectedDate = new Date(birthdate);
                    let today = new Date();
                    today.setHours(0, 0, 0, 0);
                    if (selectedDate > today) {
                        card.find('.passenger-birthdate').addClass('is-invalid');
                        isValid = false;
                    } else {
                        card.find('.passenger-birthdate').removeClass('is-invalid');
                    }
                }

                // Пол
                let gender = card.find('.passenger-gender').val();
                if (!gender) {
                    card.find('.passenger-gender').addClass('is-invalid');
                    isValid = false;
                } else {
                    card.find('.passenger-gender').removeClass('is-invalid');
                }

                // Гражданство
                let nationality = card.find('.passenger-nationality').val().trim();
                if (!nationality) {
                    card.find('.passenger-nationality').addClass('is-invalid');
                    isValid = false;
                } else if (nationality.length < 2) {
                    card.find('.passenger-nationality').addClass('is-invalid');
                    isValid = false;
                } else if (nationality.length > 50) {
                    card.find('.passenger-nationality').addClass('is-invalid');
                    isValid = false;
                } else if (hasDigits(nationality)) {
                    card.find('.passenger-nationality').addClass('is-invalid');
                    isValid = false;
                } else if (!isValidName(nationality)) {
                    card.find('.passenger-nationality').addClass('is-invalid');
                    isValid = false;
                } else {
                    card.find('.passenger-nationality').removeClass('is-invalid');
                }

                // Тип документа
                let documentType = card.find('.passenger-document-type').val();
                if (!documentType) {
                    card.find('.passenger-document-type').addClass('is-invalid');
                    isValid = false;
                } else {
                    card.find('.passenger-document-type').removeClass('is-invalid');
                }

                // Номер документа
                let docNumber = card.find('.passenger-document-number').val().trim();
                if (!docNumber) {
                    card.find('.passenger-document-number').addClass('is-invalid');
                    isValid = false;
                } else if (!/^\d+$/.test(docNumber)) {
                    card.find('.passenger-document-number').addClass('is-invalid');
                    isValid = false;
                } else if (docNumber.length < 4) {
                    card.find('.passenger-document-number').addClass('is-invalid');
                    isValid = false;
                } else if (docNumber.length > 10) {
                    card.find('.passenger-document-number').addClass('is-invalid');
                    isValid = false;
                } else {
                    card.find('.passenger-document-number').removeClass('is-invalid');
                }

                return isValid;
            }

            // ================= ИНИЦИАЛИЗАЦИЯ ВАЛИДАЦИИ ДЛЯ ПАССАЖИРА =================
            function initPassengerValidation(card) {
                card.find('.passenger-lastname, .passenger-firstname, .passenger-middlename, .passenger-nationality').on('input', function() {
                    let val = $(this).val().trim();
                    if (val && hasDigits(val)) {
                        $(this).addClass('is-invalid');
                    } else if (val && !isValidName(val)) {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                card.find('.passenger-birthdate').on('change', function() {
                    let selectedDate = new Date($(this).val());
                    let today = new Date();
                    today.setHours(0, 0, 0, 0);
                    if (selectedDate > today) {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                card.find('.passenger-gender, .passenger-document-type').on('change', function() {
                    if ($(this).val()) {
                        $(this).removeClass('is-invalid');
                    } else {
                        $(this).addClass('is-invalid');
                    }
                });

                card.find('.passenger-document-number').on('input', function() {
                    let val = $(this).val().trim();
                    if (!val || !/^\d+$/.test(val) || val.length < 4 || val.length > 10) {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });
            }

            // Применяем валидацию к существующим карточкам
            $('.passenger-card').each(function() {
                initPassengerValidation($(this));
            });

            // ================= ДОБАВЛЕНИЕ ПАССАЖИРА =================
            $('#addPassengerBtn').click(function() {
                // if (passengerCount >= totalPassengersLimit) {
                //     showMessage('warning', `Максимальное количество пассажиров: ${totalPassengersLimit}`);
                //     return;
                // }

                let i = passengerCount;
                let html = `
                    <div class="passenger-card mb-4 p-3 border rounded" data-passenger-index="${i}">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 text-primary">Пассажир ${i + 1}</h5>
                            <button type="button" class="btn btn-sm btn-outline-danger remove-passenger">
                                <i class="fas fa-trash-alt me-1"></i>Удалить
                            </button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Фамилия <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control passenger-lastname" name="Passengers[${i}].LastName" maxlength="100">
                                    <div class="invalid-feedback">Введите фамилию (только буквы)</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Имя <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control passenger-firstname" name="Passengers[${i}].FirstName" maxlength="100">
                                    <div class="invalid-feedback">Введите имя (только буквы)</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Отчество</label>
                                    <input type="text" class="form-control passenger-middlename" name="Passengers[${i}].MiddleName" maxlength="100">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Дата рождения <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control passenger-birthdate" name="Passengers[${i}].DateOfBirth">
                                    <div class="invalid-feedback">Дата не может быть в будущем</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Пол <span class="text-danger">*</span></label>
                                    <select class="form-select passenger-gender" name="Passengers[${i}].Gender">
                                        <option value="">Выберите</option>
                                        <option value="M">Мужской</option>
                                        <option value="F">Женский</option>
                                    </select>
                                    <div class="invalid-feedback">Выберите пол</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Гражданство <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control passenger-nationality" name="Passengers[${i}].Nationality" maxlength="50" value="Россия">
                                    <div class="invalid-feedback">Введите гражданство</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Тип документа <span class="text-danger">*</span></label>
                                    <select class="form-select passenger-document-type" name="Passengers[${i}].DocumentType">
                                        <option value="">Выберите</option>
                                        <option value="passport">Паспорт РФ</option>
                                        <option value="foreign_passport">Загранпаспорт</option>
                                        <option value="birth_certificate">Свидетельство о рождении</option>
                                    </select>
                                    <div class="invalid-feedback">Выберите тип документа</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">Номер документа <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control passenger-document-number" name="Passengers[${i}].DocumentNumber" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                    <div class="invalid-feedback">Номер документа (только цифры, 4-10 символов)</div>
                                </div>
                            </div>
                        </div>
                    </div>`;

                $('#passengers-container').append(html);
                let newCard = $('#passengers-container .passenger-card').last();
                initPassengerValidation(newCard);
                passengerCount++;

                newCard.find('.remove-passenger').click(function() {
                    if ($('.passenger-card').length > 1) {
                        $(this).closest('.passenger-card').remove();
                        passengerCount--;
                        // Обновляем номера пассажиров
                        $('.passenger-card').each(function(idx) {
                            $(this).find('h5').text('Пассажир ' + (idx + 1));
                            $(this).attr('data-passenger-index', idx);
                        });
                    } else {
                        showMessage('warning', 'Должен быть хотя бы один пассажир');
                    }
                });
            });

            // ================= УДАЛЕНИЕ ПАССАЖИРА =================
            $(document).on('click', '.remove-passenger', function() {
                if ($('.passenger-card').length > 1) {
                    $(this).closest('.passenger-card').remove();
                    passengerCount--;
                    $('.passenger-card').each(function(idx) {
                        $(this).find('h5').text('Пассажир ' + (idx + 1));
                        $(this).attr('data-passenger-index', idx);
                    });
                } else {
                    showMessage('warning', 'Должен быть хотя бы один пассажир');
                }
            });

            // ================= ВАЛИДАЦИЯ КОНТАКТНЫХ ДАННЫХ =================
            function validateContact() {
                let isValid = true;
                let errors = [];

                // Email
                let email = $('#email').val().trim();
                let emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!email) {
                    $('#email').addClass('is-invalid');
                    errors.push('Email не указан');
                    isValid = false;
                } else if (!emailRegex.test(email)) {
                    $('#email').addClass('is-invalid');
                    errors.push('Email указан неверно');
                    isValid = false;
                } else {
                    $('#email').removeClass('is-invalid');
                }

                // Телефон
                let phoneRaw = $('#phone').val();
                let phone = phoneRaw.replace(/\D/g, '');
                if (!phone) {
                    $('#phone').addClass('is-invalid');
                    errors.push('Телефон не указан');
                    isValid = false;
                } else if (phone.length !== 11) {
                    $('#phone').addClass('is-invalid');
                    errors.push('Телефон должен содержать 11 цифр');
                    isValid = false;
                } else {
                    $('#phone').removeClass('is-invalid');
                }

                // Согласие
                if (!$('#agreeTerms').is(':checked')) {
                    $('#agreeTerms').addClass('is-invalid');
                    errors.push('Необходимо согласиться с условиями');
                    isValid = false;
                } else {
                    $('#agreeTerms').removeClass('is-invalid');
                }

                return { isValid, errors };
            }
                    // ================= ПРОВЕРКА УНИКАЛЬНОСТИ НОМЕРОВ ДОКУМЕНТОВ =================
        function validateUniqueDocumentNumbers() {
            let isValid = true;
            let errors = [];
            let documentNumbers = [];

            $('.passenger-card').each(function(index) {
                let card = $(this);
                let passengerNum = index + 1;
                let docNumber = card.find('.passenger-document-number').val().trim();

                if (docNumber) {
                    if (documentNumbers.includes(docNumber)) {
                        const duplicateIndex = documentNumbers.indexOf(docNumber) + 1;
                        card.find('.passenger-document-number').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Номер документа "${docNumber}" совпадает с номером документа пассажира ${duplicateIndex}`);
                        isValid = false;
                    } else {
                        documentNumbers.push(docNumber);
                    }
                }
            });

            return { isValid, errors };
        }
            // ================= ВАЛИДАЦИЯ ВСЕХ ПАССАЖИРОВ =================
            function validateAllPassengers() {
                let isValid = true;
                let errors = [];
                    const uniqueCheck = validateUniqueDocumentNumbers();
        if (!uniqueCheck.isValid) {
            isValid = false;
            errors.push(...uniqueCheck.errors);
        }
                $('.passenger-card').each(function(index) {
                    let card = $(this);
                    let passengerNum = index + 1;

                    // Фамилия
                    let lastName = card.find('.passenger-lastname').val().trim();
                    if (!lastName) {
                        card.find('.passenger-lastname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Фамилия не заполнена`);
                        isValid = false;
                    } else if (lastName.length < 2) {
                        card.find('.passenger-lastname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Фамилия должна содержать минимум 2 символа`);
                        isValid = false;
                    } else if (hasDigits(lastName)) {
                        card.find('.passenger-lastname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Фамилия не может содержать цифры`);
                        isValid = false;
                    } else if (!isValidName(lastName)) {
                        card.find('.passenger-lastname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Фамилия может содержать только буквы`);
                        isValid = false;
                    } else {
                        card.find('.passenger-lastname').removeClass('is-invalid');
                    }

                    // Имя
                    let firstName = card.find('.passenger-firstname').val().trim();
                    if (!firstName) {
                        card.find('.passenger-firstname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Имя не заполнено`);
                        isValid = false;
                    } else if (firstName.length < 2) {
                        card.find('.passenger-firstname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Имя должно содержать минимум 2 символа`);
                        isValid = false;
                    } else if (hasDigits(firstName)) {
                        card.find('.passenger-firstname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Имя не может содержать цифры`);
                        isValid = false;
                    } else if (!isValidName(firstName)) {
                        card.find('.passenger-firstname').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Имя может содержать только буквы`);
                        isValid = false;
                    } else {
                        card.find('.passenger-firstname').removeClass('is-invalid');
                    }

                    // Дата рождения
                    let birthdate = card.find('.passenger-birthdate').val();
                    if (!birthdate) {
                        card.find('.passenger-birthdate').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Дата рождения не указана`);
                        isValid = false;
                    } else {
                        let selectedDate = new Date(birthdate);
                        let today = new Date();
                        today.setHours(0, 0, 0, 0);
                        if (selectedDate > today) {
                            card.find('.passenger-birthdate').addClass('is-invalid');
                            errors.push(`Пассажир ${passengerNum}: Дата рождения не может быть в будущем`);
                            isValid = false;
                        } else {
                            card.find('.passenger-birthdate').removeClass('is-invalid');
                        }
                    }

                    // Пол
                    let gender = card.find('.passenger-gender').val();
                    if (!gender) {
                        card.find('.passenger-gender').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Пол не выбран`);
                        isValid = false;
                    } else {
                        card.find('.passenger-gender').removeClass('is-invalid');
                    }

                    // Гражданство
                    let nationality = card.find('.passenger-nationality').val().trim();
                    if (!nationality) {
                        card.find('.passenger-nationality').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Гражданство не указано`);
                        isValid = false;
                    } else if (hasDigits(nationality)) {
                        card.find('.passenger-nationality').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Гражданство не может содержать цифры`);
                        isValid = false;
                    } else {
                        card.find('.passenger-nationality').removeClass('is-invalid');
                    }

                    // Тип документа
                    let documentType = card.find('.passenger-document-type').val();
                    if (!documentType) {
                        card.find('.passenger-document-type').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Тип документа не выбран`);
                        isValid = false;
                    } else {
                        card.find('.passenger-document-type').removeClass('is-invalid');
                    }

                    // Номер документа
                    let docNumber = card.find('.passenger-document-number').val().trim();
                    if (!docNumber) {
                        card.find('.passenger-document-number').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Номер документа не указан`);
                        isValid = false;
                    } else if (!/^\d+$/.test(docNumber)) {
                        card.find('.passenger-document-number').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Номер документа должен содержать только цифры`);
                        isValid = false;
                    } else if (docNumber.length < 4) {
                        card.find('.passenger-document-number').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Номер документа должен содержать минимум 4 цифры`);
                        isValid = false;
                    } else if (docNumber.length > 10) {
                        card.find('.passenger-document-number').addClass('is-invalid');
                        errors.push(`Пассажир ${passengerNum}: Номер документа не должен превышать 10 цифр`);
                        isValid = false;
                    } else {
                        card.find('.passenger-document-number').removeClass('is-invalid');
                    }
                });

                return { isValid, errors };
            }

            // ================= ОТПРАВКА ФОРМЫ =================
            $('#submitBtn').off('click').on('click', function(e) {
                e.preventDefault();

                const contactValidation = validateContact();
                const passengersValidation = validateAllPassengers();

                if (!contactValidation.isValid || !passengersValidation.isValid) {
                    let allErrors = [...contactValidation.errors, ...passengersValidation.errors];
                    let errorMessage = '❌ ОШИБКИ В ДАННЫХ:\n\n';
                    allErrors.forEach(err => {
                        errorMessage += '• ' + err + '\n';
                    });
                    alert(errorMessage);
                    return;
                }

                let btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Обработка...');

                let passengers = [];
                $('.passenger-card').each(function() {
                    let card = $(this);
                    passengers.push({
                        lastName: card.find('.passenger-lastname').val().trim(),
                        firstName: card.find('.passenger-firstname').val().trim(),
                        middleName: card.find('.passenger-middlename').val().trim(),
                        dateOfBirth: card.find('.passenger-birthdate').val(),
                        gender: card.find('.passenger-gender').val(),
                        nationality: card.find('.passenger-nationality').val().trim(),
                        documentType: card.find('.passenger-document-type').val(),
                        documentNumber: card.find('.passenger-document-number').val().trim()
                    });
                });

                let formData = {
                    TrainInfo: {
                        TrainNumber: $('#trainNumber').val(),
                        ReturnTrainNumber: $('#returnTrainNumber').val() || null,
                        DepartureStationId: $('#departureStationId').val(),
                        DepartureStationName: $('#departureStationName').val(),
                        ArrivalStationId: $('#arrivalStationId').val(),
                        ArrivalStationName: $('#arrivalStationName').val(),
                        DepartureDateTime: $('#departureDateTime').val(),
                        ArrivalDateTime: $('#arrivalDateTime').val() || null,
                        ReturnDepartureDateTime: $('#returnDepartureDateTime').val() || null,
                        ReturnArrivalDateTime: $('#returnArrivalDateTime').val() || null,
                        Price: parseFloat($('#price').val()),
                        Passengers: passengers.length,
                        CarType: $('#carType').val(),
                        CarClass: $('#carClass').val(),
                        Duration: parseInt($('#duration').val()),
                        ReturnDuration: $('#returnDuration').val() ? parseInt($('#returnDuration').val()) : null,
                        IsRoundTrip: $('#isRoundTrip').val() === 'True'
                    },
                    Passengers: passengers,
                    Contact: {
                        Email: $('#email').val().trim(),
                        Phone: $('#phone').val().trim(),
                        AgreeToTerms: $('#agreeTerms').is(':checked')
                    }
                };

                $.ajax({
                    url: '@Url.Action("ProcessPayment")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val(),
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            showMessage('success', 'Билет успешно оформлен! Перенаправляем...');
                            setTimeout(function() {
                                window.location.href = response.redirectUrl;
                            }, 2000);
                        } else {
                            let errorMessage = '❌ ОШИБКА ПРИ ОФОРМЛЕНИИ:\n\n';
                            if (response.errors && response.errors.length > 0) {
                                response.errors.forEach(err => {
                                    errorMessage += '• ' + err + '\n';
                                });
                            } else if (response.message) {
                                errorMessage += response.message;
                            } else {
                                errorMessage += 'Неизвестная ошибка';
                            }
                            alert(errorMessage);
                            btn.prop('disabled', false).html('<i class="fas fa-check me-2"></i>Забронировать билет');
                        }
                    },
                    error: function(xhr) {
                        console.error('Ошибка AJAX:', xhr);
                        let errorMsg = '❌ Ошибка сервера. Попробуйте позже.';
                        alert(errorMsg);
                        btn.prop('disabled', false).html('<i class="fas fa-check me-2"></i>Забронировать билет');
                    }
                });
            });

            function showMessage(type, text) {
                let alertClass = type === 'success' ? 'alert-success' : 'alert-warning';
                let icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle';
                let html = `
                    <div class="alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999;">
                        <i class="fas ${icon} me-2"></i>${text}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>`;
                $('body').append(html);
                setTimeout(function() { $('.alert').fadeOut('slow', function() { $(this).remove(); }); }, 3000);
            }
        });
    </script>
}

