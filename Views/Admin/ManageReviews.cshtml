@model List<TripWise.Controllers.ReviewManageViewModel>
@{
    ViewData["Title"] = "Управление отзывами";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div style="width: 100%; max-width: 100%; overflow-x: auto;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold">
            <i class="fas fa-comments me-2"></i>Управление отзывами
        </h2>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge bg-primary fs-6">Всего: @Model.Count</span>
            <span class="badge bg-warning fs-6">На модерации: @Model.Count(r => !r.IsApproved && !r.IsDeleted)</span>
            <span class="badge bg-success fs-6">Одобрено: @Model.Count(r => r.IsApproved)</span>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <div class="btn-group flex-wrap gap-2">
                    <button class="btn btn-outline-secondary filter-btn active" data-filter="all">Все</button>
                    <button class="btn btn-outline-warning filter-btn" data-filter="pending">На модерации</button>
                    <button class="btn btn-outline-success filter-btn" data-filter="approved">Одобренные</button>
                    <button class="btn btn-outline-danger filter-btn" data-filter="deleted">Удаленные</button>
                </div>

                <div class="ms-auto">
                    <div class="input-group" style="min-width: 250px;">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchReviews" class="form-control" placeholder="Поиск по имени или email...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Список отзывов -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="reviewsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px">ID</th>
                            <th>Пользователь</th>
                            <th style="width: 120px">Оценка</th>
                            <th>Отзыв</th>
                            <th style="width: 160px">Дата</th>
                            <th style="width: 100px">Статус</th>
                            <th style="width: 150px">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model)
                        {
                            // Экранируем только для атрибутов, не для отображения
                            var escapedTextForAttr = review.Text.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\"", "&quot;").Replace("\n", "\\n").Replace("\r", "\\r");
                            var escapedNameForAttr = review.UserName.Replace("'", "\\'").Replace("\"", "&quot;");
                            var escapedEmailForAttr = review.UserEmail.Replace("'", "\\'").Replace("\"", "&quot;");

                            <tr data-status="@(review.IsDeleted ? "deleted" : (review.IsApproved ? "approved" : "pending"))">
                                <td class="align-middle">@review.Id</td>
                                <td class="align-middle">
                                    <div class="fw-semibold">@review.UserName</div>
                                    <small class="text-muted">@review.UserEmail</small>
                                </td>
                                <td class="align-middle">
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        }
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <div class="review-text" style="max-width: 350px;">
                                        <p class="mb-0 small">@(review.Text.Length > 100 ? review.Text.Substring(0, 100) + "..." : review.Text)</p>
                                        <button class="btn btn-link btn-sm p-0 mt-1 view-full-review"
                                                data-id="@review.Id"
                                                data-text="@escapedTextForAttr"
                                                data-name="@escapedNameForAttr"
                                                data-rating="@review.Rating"
                                                data-email="@escapedEmailForAttr"
                                                data-date="@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")">
                                            <i class="fas fa-eye me-1"></i>Читать полностью
                                        </button>
                                    </div>
                                </td>
                                <td class="align-middle">@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="align-middle">
                                    @if (review.IsDeleted)
                                    {
                                        <span class="badge bg-danger">Удален</span>
                                    }
                                    else if (review.IsApproved)
                                    {
                                        <span class="badge bg-success">Одобрен</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">На модерации</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="btn-group btn-group-sm">
                                        @if (!review.IsApproved && !review.IsDeleted)
                                        {
                                            <button class="btn btn-success approve-review" data-id="@review.Id" title="Одобрить">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="btn btn-danger reject-review" data-id="@review.Id" title="Отклонить">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                        @if (review.IsApproved && !review.IsDeleted)
                                        {
                                            <button class="btn btn-danger delete-review" data-id="@review.Id" title="Удалить">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для просмотра полного отзыва -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <i class="fas fa-star text-warning me-2"></i>
                    <span id="modalReviewName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <span class="text-muted">Email:</span>
                    <span id="modalReviewEmail"></span>
                </div>
                <div class="mb-2">
                    <span class="text-muted">Оценка:</span>
                    <span id="modalReviewRating" class="ms-2"></span>
                </div>
                <div class="mb-2">
                    <span class="text-muted">Дата:</span>
                    <span id="modalReviewDate" class="ms-2"></span>
                </div>
                <hr>
                <div class="mt-3">
                    <p id="modalReviewText" class="mb-0" style="white-space: pre-wrap; word-break: break-word;"></p>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<style>
    .filter-btn {
        transition: all 0.2s ease;
    }

        .filter-btn.active {
            background: #0379D9;
            color: white;
            border-color: #0379D9;
        }

        .filter-btn.btn-outline-warning.active {
            background: #ffc107;
            color: #000;
        }

        .filter-btn.btn-outline-success.active {
            background: #28a745;
            color: white;
        }

        .filter-btn.btn-outline-danger.active {
            background: #dc3545;
            color: white;
        }

    .review-text {
        cursor: pointer;
    }

    .view-full-review {
        font-size: 0.75rem;
    }

    /* Адаптация для мобильных */
    @@media (max-width: 768px) {
        .btn-group {
            flex-wrap: wrap;
        }

            .btn-group .btn {
                margin-bottom: 5px;
            }

        .table-responsive {
            font-size: 0.85rem;
        }

        .table td, .table th {
            padding: 0.5rem;
        }

        .badge {
            font-size: 0.75rem;
        }

        .btn-group-sm .btn {
            padding: 0.25rem 0.5rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Фильтрация
        let currentFilter = 'all';

        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentFilter = this.getAttribute('data-filter');
                filterTable();
            });
        });

        function filterTable() {
            const searchText = document.getElementById('searchReviews')?.value.toLowerCase() || '';
            const rows = document.querySelectorAll('#reviewsTable tbody tr');

            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                const userName = row.cells[1]?.innerText.toLowerCase() || '';
                const userEmail = row.cells[1]?.querySelector('.text-muted')?.innerText.toLowerCase() || '';

                let statusMatch = false;
                if (currentFilter === 'all') statusMatch = true;
                else if (currentFilter === 'pending' && status === 'pending') statusMatch = true;
                else if (currentFilter === 'approved' && status === 'approved') statusMatch = true;
                else if (currentFilter === 'deleted' && status === 'deleted') statusMatch = true;

                const searchMatch = !searchText || userName.includes(searchText) || userEmail.includes(searchText);

                row.style.display = (statusMatch && searchMatch) ? '' : 'none';
            });
        }

        // Поиск
        document.getElementById('searchReviews')?.addEventListener('input', filterTable);

        // Просмотр полного отзыва
        document.querySelectorAll('.view-full-review').forEach(btn => {
            btn.addEventListener('click', function() {
                const name = this.getAttribute('data-name');
                const email = this.getAttribute('data-email');
                const rating = parseInt(this.getAttribute('data-rating'));
                const date = this.getAttribute('data-date');
                let text = this.getAttribute('data-text');

                // Восстанавливаем переносы строк
                if (text) {
                    text = text.replace(/\\n/g, '\n').replace(/\\r/g, '\r');
                }

                document.getElementById('modalReviewName').innerText = name;
                document.getElementById('modalReviewEmail').innerText = email;
                document.getElementById('modalReviewRating').innerHTML = getStars(rating);
                document.getElementById('modalReviewDate').innerText = date;
                document.getElementById('modalReviewText').innerText = text;

                new bootstrap.Modal(document.getElementById('reviewModal')).show();
            });
        });

        function getStars(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= rating) stars += '<i class="fas fa-star text-warning"></i> ';
                else stars += '<i class="far fa-star text-warning"></i> ';
            }
            return stars.trim();
        }

        // Одобрение отзыва
        document.querySelectorAll('.approve-review').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.getAttribute('data-id');
                if (!confirm('Одобрить этот отзыв?')) return;

                const originalHTML = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                this.disabled = true;

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                                  document.querySelector('[name="__RequestVerificationToken"]')?.value;

                    const response = await fetch(`/Admin/ApproveReview/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        }
                    });

                    const data = await response.json();
                    if (data.success) {
                        showNotification('Отзыв одобрен', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification(data.message || 'Ошибка', 'danger');
                    }
                } catch (error) {
                    showNotification('Ошибка при одобрении', 'danger');
                } finally {
                    this.innerHTML = originalHTML;
                    this.disabled = false;
                }
            });
        });

        // Отклонение отзыва
        document.querySelectorAll('.reject-review').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.getAttribute('data-id');
                if (!confirm('Отклонить этот отзыв? Он будет удален.')) return;

                const originalHTML = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                this.disabled = true;

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                                  document.querySelector('[name="__RequestVerificationToken"]')?.value;

                    const response = await fetch(`/Admin/RejectReview/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        }
                    });

                    const data = await response.json();
                    if (data.success) {
                        showNotification('Отзыв отклонен', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification(data.message || 'Ошибка', 'danger');
                    }
                } catch (error) {
                    showNotification('Ошибка при отклонении', 'danger');
                } finally {
                    this.innerHTML = originalHTML;
                    this.disabled = false;
                }
            });
        });

        // Удаление отзыва
        document.querySelectorAll('.delete-review').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.getAttribute('data-id');
                if (!confirm('Удалить этот отзыв?')) return;

                const originalHTML = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                this.disabled = true;

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                                  document.querySelector('[name="__RequestVerificationToken"]')?.value;

                    const response = await fetch(`/Admin/DeleteReview/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        }
                    });

                    const data = await response.json();
                    if (data.success) {
                        showNotification('Отзыв удален', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification(data.message || 'Ошибка', 'danger');
                    }
                } catch (error) {
                    showNotification('Ошибка при удалении', 'danger');
                } finally {
                    this.innerHTML = originalHTML;
                    this.disabled = false;
                }
            });
        });

        function showNotification(message, type) {
            const oldNotifications = document.querySelectorAll('.notification-alert');
            oldNotifications.forEach(n => n.remove());

            const notification = document.createElement('div');
            notification.className = `notification-alert alert alert-${type} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 250px; animation: slideIn 0.3s ease-out;';
            notification.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>
                    <div>${message}</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.body.appendChild(notification);

            setTimeout(() => {
                if (notification.parentElement) notification.remove();
            }, 3000);
        }
    });
</script>