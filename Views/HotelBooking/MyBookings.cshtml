@model IEnumerable<TripWise.Models.HotelBooking>
@{
    ViewData["Title"] = "Мои бронирования отелей";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4" style="font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 2.5rem; color: #0379D9;">
                Мои бронирования отелей
            </h1>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-hotel fa-4x text-muted mb-3"></i>
                    <h3>У вас пока нет бронирований</h3>
                    <p class="text-muted">Найдите отель на карте и забронируйте проживание</p>
                    <a href="@Url.Action("Index", "Hotels")" class="btn btn-primary btn-lg">
                        <i class="fas fa-search me-2"></i>Найти отель
                    </a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var booking in Model)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <h5 class="card-title text-primary">@booking.HotelName</h5>
                                            <p class="text-muted small mb-2">@booking.HotelAddress</p>
                                        </div>
                                        <span class="badge @(booking.Status == TripWise.Models.BookingStatus.Confirmed ? "bg-success" : "bg-secondary")">
                                            @(booking.Status == TripWise.Models.BookingStatus.Confirmed ? "Подтверждено" : "Отменено")
                                        </span>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <small class="text-muted d-block">Заезд</small>
                                            <strong>@booking.CheckInDate.ToString("dd.MM.yyyy")</strong>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Выезд</small>
                                            <strong>@booking.CheckOutDate.ToString("dd.MM.yyyy")</strong>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <small class="text-muted d-block">Гостей: @booking.Guests</small>
                                            <small class="text-muted d-block">Комнат: @booking.Rooms</small>
                                        </div>
                                        <div class="text-end">
                                            <strong class="text-success">@booking.TotalPrice.ToString("N0") ₽</strong>
                                            <small class="text-muted d-block">@booking.Nights ночей</small>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <small class="text-muted">Номер брони: @booking.BookingNumber</small>
                                    </div>

                                    <div class="mt-3 d-flex gap-2">
                                        <a href="@Url.Action("Details", new { bookingId = booking.Id })" class="btn btn-outline-primary btn-sm flex-grow-1">
                                            <i class="fas fa-eye me-1"></i>Детали
                                        </a>
                                        @if (booking.Status == TripWise.Models.BookingStatus.Confirmed && booking.CheckInDate > DateTime.Today)
                                        {
                                            <button class="btn btn-outline-danger btn-sm flex-grow-1" onclick="cancelBooking('@booking.Id')">
                                                <i class="fas fa-times me-1"></i>Отменить
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cancelBooking(bookingId) {
            if (confirm('Вы уверены, что хотите отменить бронирование?')) {
                $.ajax({
                    url: '@Url.Action("Cancel")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ bookingId: bookingId, reason: 'Отменено пользователем' }),
                    contentType: 'application/json',
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    }
                });
            }
        }
    </script>
}