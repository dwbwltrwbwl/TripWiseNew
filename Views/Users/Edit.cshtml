@model TripWise.Models.User

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>User</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdUser" />

            <!-- Фамилия -->
            <div class="form-group mb-3">
                <label asp-for="LastName" class="control-label">Фамилия</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <!-- Имя -->
            <div class="form-group mb-3">
                <label asp-for="FirstName" class="control-label">Имя</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <!-- Отчество -->
            <div class="form-group mb-3">
                <label asp-for="MiddleName" class="control-label">Отчество</label>
                <input asp-for="MiddleName" class="form-control" />
                <span asp-validation-for="MiddleName" class="text-danger small"></span>
            </div>

            <!-- Email -->
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Пароль (обычно не редактируется напрямую, но если нужно) -->
            <div class="form-group mb-3">
                <label asp-for="PasswordHash" class="control-label">Пароль</label>
                <input asp-for="PasswordHash" class="form-control" type="password"
                       placeholder="Оставьте пустым, если не хотите менять пароль" />
                <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                <small class="form-text text-muted">Введите новый пароль только если хотите его изменить</small>
            </div>

            <!-- Возраст -->
            <div class="form-group mb-3">
                <label asp-for="Age" class="control-label">Возраст</label>
                <input asp-for="Age" class="form-control" type="number" min="1" max="120" />
                <span asp-validation-for="Age" class="text-danger small"></span>
            </div>

            <!-- Дата создания (обычно скрытое или readonly поле) -->
            <div class="form-group mb-3">
                <label asp-for="CreatedAt" class="control-label">Дата создания</label>
                <input asp-for="CreatedAt" class="form-control" readonly />
                <small class="form-text text-muted">Дата создания не может быть изменена</small>
            </div>

            <!-- Роль -->
            <div class="form-group mb-3">
                <label asp-for="IdRole" class="control-label">Роль</label>
                <select asp-for="IdRole" class="form-control" asp-items="ViewBag.IdRole">
                    <option value="">-- Выберите роль --</option>
                </select>
                <span asp-validation-for="IdRole" class="text-danger small"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Сохранить
                </button>
                <a asp-action="Details" asp-route-id="@Model.IdUser" class="btn btn-outline-secondary ms-2">
                    <i class="fas fa-times me-2"></i>Отмена
                </a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
