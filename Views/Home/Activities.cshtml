        container.innerHTML = `<div class="text-center text-danger py-4"><i class="fas fa-exclamation-circle fa-3x mb-3"></i><h5>Ошибка загрузки активностей</h5><p class="small">Попробуйте обновить страницу</p><button class="btn btn-sm btn-outline-primary mt-2" onclick="loadPlannedActivities()"><i class="fas fa-redo me-1"></i>Повторить</button></div>`;
    }

    function retryActivitiesSearch() {
        const bounds = activitiesMap.getBounds();
        const center = bounds.getCenter();
        searchActivitiesFromMap(center.lat, center.lng);
    }

