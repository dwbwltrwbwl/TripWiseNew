    // ==================== ФУНКЦИИ ВАЛИДАЦИИ ====================
    function validateActivityForm() {
        const name = document.getElementById('activityName').value.trim();
        const date = document.getElementById('activityDate').value;
        const time = document.getElementById('activityTime').value;
        const description = document.getElementById('activityDescription').value;
        clearActivityValidationErrors();
        let isValid = true;
        let errorMessages = [];
        if (!name) {
            showActivityFieldError('activityName', 'Название активности обязательно');
            errorMessages.push('Название активности обязательно');
            isValid = false;
        } else if (name.length < 3) {
            showActivityFieldError('activityName', 'Название должно содержать минимум 3 символа');
            errorMessages.push('Название должно содержать минимум 3 символа');
            isValid = false;
        } else if (name.length > 200) {
            showActivityFieldError('activityName', 'Название не может превышать 200 символов');
            errorMessages.push('Название не может превышать 200 символов');
            isValid = false;
        }
        if (!date) {
            showActivityFieldError('activityDate', 'Дата обязательна');
            errorMessages.push('Дата обязательна');
            isValid = false;
        } else {
            const selectedDate = new Date(date);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            if (selectedDate < today) {
                showActivityFieldError('activityDate', 'Дата не может быть в прошлом');
                errorMessages.push('Дата не может быть в прошлом');
                isValid = false;
            }
        }
        if (!time) {
            showActivityFieldError('activityTime', 'Время обязательно');
            errorMessages.push('Время обязательно');
            isValid = false;
        }
        if (description && description.length > 1000) {
            showActivityFieldError('activityDescription', 'Описание не может превышать 1000 символов');
            errorMessages.push('Описание не может превышать 1000 символов');
            isValid = false;
        }
        if (!isValid) {
            alert(errorMessages.join('\n'));
        }
        return isValid;
    }

    function showActivityFieldError(fieldId, message) {
        const field = document.getElementById(fieldId);
        if (field) {
            field.classList.add('is-invalid');
            const existingError = field.parentElement.querySelector('.invalid-feedback');
            if (existingError) existingError.remove();
            const errorDiv = document.createElement('div');
            errorDiv.className = 'invalid-feedback';
            errorDiv.textContent = message;
            field.parentElement.appendChild(errorDiv);
        }
    }

    function clearActivityValidationErrors() {
        const fields = ['activityName', 'activityDate', 'activityTime', 'activityDescription'];
        fields.forEach(fieldId => {
            const field = document.getElementById(fieldId);
            if (field) {
                field.classList.remove('is-invalid');
                const error = field.parentElement.querySelector('.invalid-feedback');
                if (error) error.remove();
            }
        });
    }

