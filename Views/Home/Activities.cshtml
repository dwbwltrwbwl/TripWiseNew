    function focusActivity(index) {
        if (!currentActivities[index]) return;
        const activity = currentActivities[index];
        activitiesMap.setView([activity.lat, activity.lon], 16);
        if (activityMarkers[index]) activityMarkers[index].openPopup();
        document.querySelectorAll('.activity-item').forEach(item => item.classList.remove('active'));
        const activityElement = document.querySelector(`[data-activity-id="${activity.id}"]`);
        if (activityElement) {
            activityElement.classList.add('active');
            activityElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
