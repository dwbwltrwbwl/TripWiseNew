                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold">от 2 800₽</span>
                                <small class="text-muted">/ сутки</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="country-card card border-0 shadow-sm h-100" style="cursor: pointer;" onclick="redirectToHotelsByCity('Прага')">
                        <img src="https://avatars.mds.yandex.net/get-altay/6545454/2a000001907df6080e9edd8bdea901bf6c13/orig" class="card-img-top" alt="Чехия" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Чехия</h5>
                            <p class="card-text text-muted">Прага, пиво и готическая архитектура</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold">от 3 000₽</span>
                                <small class="text-muted">/ сутки</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="country-card card border-0 shadow-sm h-100" style="cursor: pointer;" onclick="redirectToHotelsByCity('Лиссабон')">
                        <img src="https://i.pinimg.com/originals/cd/89/0b/cd890b117c1c0b1489d6457d1894bc0e.jpg" class="card-img-top" alt="Португалия" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Португалия</h5>
                            <p class="card-text text-muted">Океан, портвейн и фаду</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold">от 3 600₽</span>
                                <small class="text-muted">/ сутки</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="testimonials-section py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div class="text-start">
                    <h2 class="fw-bold mb-3">Отзывы путешественников</h2>
                    <p class="text-muted lead">
                        @if (Model.HasReviews)
                        {
                            <text>На основе @Model.Statistics.TotalReviews @GetReviewWord(Model.Statistics.TotalReviews) • Средняя оценка @Model.Statistics.AverageRating</text>
                        }
                        else
                        {
                            <text>Что говорят наши пользователи</text>
                        }
                    </p>
                </div>
                <a asp-controller="Home" asp-action="Reviews" class="btn btn-outline-primary">Все отзывы</a>
            </div>

            @if (Model.HasReviews)
            {
                <div class="row g-4">
                    @foreach (var review in Model.RecentReviews)
                    {
                        <div class="col-md-4">
                            <div class="testimonial-card bg-light rounded-3 p-4 h-100">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                        <i class="fas fa-user text-white"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@review.Name</h6>
                                        <div class="d-flex align-items-center mt-1">
                                            <div class="text-warning me-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fas fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star"></i>
                                                    }
                                                }
                                            </div>
                                            <small class="text-muted">@review.Rating.ToString("F1")</small>
                                        </div>
                                        <small class="text-muted">@review.FormattedDate</small>
                                    </div>
                                </div>
                                <p class="mb-0">"@review.ShortText"</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">Пока нет отзывов</h4>
                    <p class="text-muted">Будьте первым, кто оставит отзыв!</p>
                    <a asp-controller="Review" asp-action="Reviews" class="btn btn-primary mt-3">
                        <i class="fas fa-pen me-2"></i>Оставить отзыв
                    </a>
                </div>
            }
        </div>
    </section>
</div>

