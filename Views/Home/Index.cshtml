</style>

@functions {
    public string GetReviewWord(int count)
    {
        if (count % 10 == 1 && count % 100 != 11) return "отзыва";
        if (count % 10 >= 2 && count % 10 <= 4 && (count % 100 < 10 || count % 100 >= 20)) return "отзыва";
        return "отзывов";
    }
}
<script>
    function redirectToHotels(accommodationType) {
        // Маппинг типов жилья для API
        const typeMapping = {
            'hotel': 'hotel',
            'apartment': 'apartment',
            'guest_house': 'guest_house',
            'camp_site': 'camp_site'
        };

        const mappedType = typeMapping[accommodationType] || 'all';

        // Сохраняем выбранный тип в sessionStorage, чтобы страница отелей могла его прочитать
        sessionStorage.setItem('selectedAccommodationType', mappedType);
        sessionStorage.setItem('autoSearchHotels', 'true');

        // Переходим на страницу отелей
        window.location.href = '/Home/Hotels';
    }

    // НОВАЯ ФУНКЦИЯ ДЛЯ ПЕРЕХОДА ПО ГОРОДУ
    function redirectToHotelsByCity(cityName) {
        console.log('Переход к поиску отелей в городе:', cityName);

        // Сохраняем город в sessionStorage
        sessionStorage.setItem('selectedCity', cityName);
        sessionStorage.setItem('autoSearchHotels', 'true');

        // Переходим на страницу отелей
        window.location.href = '/Home/Hotels';
    }
</script>