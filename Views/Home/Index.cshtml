@model TripWise.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container-fluid px-0">
    <section class="hero-section text-white">
        <div class="container">
            <div class="row align-items-center py-5">
                <div class="col-lg-6">
                    <h1 class="fw-bold mb-4" style="font-size: 2.5rem; font-family: 'Nunito', sans-serif;">Планируйте путешествия вместе</h1>
                    <p class="lead mb-4">Создавайте маршруты, делитесь идеями и открывайте новые места с друзьями и семьей</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <div class="btn btn-light btn-lg fw-medium px-4" style="cursor: default;">
                            <i class="fas fa-globe me-2"></i>Путешествия по всему миру
                        </div>
                        <div class="btn btn-outline-light btn-lg px-4" style="cursor: default;">
                            <i class="fas fa-clock me-2"></i>Экономьте время на планировании
                        </div>
                    </div>
                </div> 
                <div class="col-lg-6 text-center">
                    <div class="hero-image-container">
                        <img src="https://media.istockphoto.com/id/523259656/tr/foto%C4%9Fraf/adventures-on-the-dolomites-with-dog.jpg?s=612x612&w=0&k=20&c=jMvhRw3c4Avo6G9tAVETljkyfTCLhtbfJ4NvFIlmuSc=" alt="Путешествия" class="hero-image img-fluid">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="features-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold mb-3">Почему выбирают нас</h2>
                <p class="text-muted lead">Все инструменты для идеального путешествия в одном месте</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="feature-card text-center p-4 h-100">
                        <div class="feature-icon bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-users fa-2x text-primary"></i>
                        </div>
                        <h5 class="fw-bold">Совместное планирование</h5>
                        <p class="text-muted">Создавайте маршруты вместе с друзьями, обсуждайте идеи и голосуйте за варианты</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card text-center p-4 h-100">
                        <div class="feature-icon bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-route fa-2x text-success"></i>
                        </div>
                        <h5 class="fw-bold">Умные маршруты</h5>
                        <p class="text-muted">Автоматическое построение оптимальных маршрутов с учетом ваших предпочтений</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card text-center p-4 h-100">
                        <div class="feature-icon bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-wallet fa-2x text-warning"></i>
                        </div>
                        <h5 class="fw-bold">Бюджет и расходы</h5>
                        <p class="text-muted">Контролируйте общие расходы, делите затраты и следите за бюджетом поездки</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

