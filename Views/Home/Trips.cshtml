                    <div class="col-md-6 col-lg-4">
                        <div class="card border-warning invitation-card h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="me-3 flex-shrink-0">
                                        ${inv.inviterAvatar ?
                                            `<img src="${inv.inviterAvatar}" class="rounded-circle" width="50" height="50" style="object-fit: cover;">` :
                                            `<div class="avatar-circle-sm bg-warning" style="width:50px;height:50px; font-size:20px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">${getInitials(inviterName)}</div>`
                                        }
                                    </div>
                                    <div class="min-width-0 flex-grow-1">
                                        <h5 class="mb-0" title="${escapeHtml(tripTitle)}">${escapeHtml(shortTripTitle)}</h5>
                                        <small class="text-muted inviter-name" title="${escapeHtml(inviterName)}">
                                            <i class="fas fa-user me-1"></i>${escapeHtml(shortInviterName)}
                                        </small>
                                    </div>
                                </div>

                                ${inv.message ? `
                                    <div class="alert alert-light mt-2 p-2" title="${escapeHtml(inv.message)}">
                                        <i class="fas fa-quote-left text-muted me-1"></i>
                                        "${escapeHtml(shortMessage)}"
                                    </div>
                                ` : ''}

                                <div class="text-muted small mb-3">
                                    <i class="far fa-clock me-1"></i>${date}
                                </div>

                                <div class="d-flex gap-2">
                                    <button class="btn btn-success flex-grow-1" onclick="respondToInvitation(${inv.id}, true)">
                                        <i class="fas fa-check me-1"></i>Принять
                                    </button>
                                    <button class="btn btn-outline-danger flex-grow-1" onclick="respondToInvitation(${inv.id}, false)">
                                        <i class="fas fa-times me-1"></i>Отклонить
                                    </button>
                                </div>

                                ${inv.chatId ? `
                                    <div class="mt-2 text-center">
                                        <small class="text-muted">
                                            <i class="fas fa-comments me-1"></i>
                                            После принятия вы попадете в общий чат поездки
                                        </small>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        }

        // Ответ на приглашение
        async function respondToInvitation(invitationId, accept) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/RespondToInvitation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        invitationId: invitationId,
                        accept: accept
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, accept ? 'success' : 'info');

                    // Перезагружаем приглашения и поездки
                    await loadInvitations();
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка', 'danger');
                }
            } catch (error) {
                console.error('Error responding to invitation:', error);
                showNotification('Не удалось обработать приглашение', 'danger');
            }
        }

        // Отправка приглашения другу (для использования в openInviteModal)
        async function sendInvitation(tripId, friendId, message) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/SendInvitation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tripId: tripId,
                        friendId: friendId,
                        message: message
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, 'success');
                    return true;
                } else {
                    showNotification(data.message || 'Ошибка при отправке приглашения', 'danger');
                    return false;
                }
            } catch (error) {
                console.error('Error sending invitation:', error);
                showNotification('Не удалось отправить приглашение', 'danger');
                return false;
            }
        }
                function applyFilters(trips) {
            let filtered = [...trips];

            // Фильтр по роли
            if (filterRole !== 'all') {
                filtered = filtered.filter(trip => {
                    if (filterRole === 'organizer') {
                        return trip.createdBy.id === currentUserId;
                    } else if (filterRole === 'participant') {
                        return trip.createdBy.id !== currentUserId;
                    }
                    return true;
                });
            }

            // Фильтр по участникам
            if (filterParticipants !== 'all') {
                filtered = filtered.filter(trip => {
                    const hasFriends = trip.participants.some(p => p.isFriend && p.userId !== currentUserId);
                    const allParticipants = trip.participants.filter(p => p.userId !== currentUserId);
                    const allAreFriends = allParticipants.length > 0 && allParticipants.every(p => p.isFriend);
                    const noFriends = !hasFriends;

                    if (filterParticipants === 'with-friends') {
                        return hasFriends;
                    } else if (filterParticipants === 'only-friends') {
                        return allAreFriends;
                    } else if (filterParticipants === 'without-friends') {
                        return noFriends;
                    }
                    return true;
                });
            }

            return filtered;
        }
    </script>
}