        // Отправить приглашения
                async function sendInvites() {
            const tripId = document.getElementById('inviteTripId').value;
            const message = document.getElementById('invitationMessage')?.value || '';

            const friendIds = [];
            document.querySelectorAll('#inviteFriendsList input:checked').forEach(cb => {
                friendIds.push(parseInt(cb.value));
            });

            if (friendIds.length === 0) {
                showNotification('Выберите друзей для приглашения', 'warning');
                return;
            }

            let successCount = 0;

            for (const friendId of friendIds) {
                const success = await sendInvitation(tripId, friendId, message);
                if (success) successCount++;
            }

            if (successCount > 0) {
                showNotification(`Приглашения отправлены ${successCount} друзьям!`, 'success');

                const modal = bootstrap.Modal.getInstance(document.getElementById('inviteFriendsModal'));
                modal.hide();
            }
        }
                // Добавьте эту функцию
                function validateBudget(input) {
            let value = input.value;

            // Удаляем все кроме цифр и точки
            value = value.replace(/[^\d.]/g, '');

            // Ограничиваем длину до 10 символов
            if (value.length > 10) {
                value = value.slice(0, 10);
            }

            // Проверяем на отрицательное значение
            if (parseFloat(value) < 0) {
                value = '0';
            }

            input.value = value;
        }
