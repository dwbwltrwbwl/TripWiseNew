        // Создание поездки
        // Замените функцию createTrip
        async function createTrip(event) {
            event.preventDefault();

            const title = document.getElementById('tripName').value.trim();
            const description = document.getElementById('tripDescription').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            let totalBudget = parseFloat(document.getElementById('totalBudget').value) || 0;

            // Валидация названия
            if (!title) {
                showNotification('Введите название поездки', 'warning');
                return;
            }
            if (title.length < 3) {
                showNotification('Название должно содержать минимум 3 символа', 'warning');
                return;
            }
            if (title.length > 50) {
                showNotification('Название не может превышать 50 символов', 'warning');
                return;
            }

            // Валидация описания
            if (description && description.length > 100) {
                showNotification('Описание не может превышать 100 символов', 'warning');
                return;
            }

            // Валидация бюджета
            if (totalBudget < 0) {
                showNotification('Бюджет не может быть отрицательным', 'warning');
                return;
            }
            if (totalBudget.toString().length > 10) {
                showNotification('Бюджет не может превышать 10 знаков', 'warning');
                return;
            }

            if (!startDate || !endDate) {
                showNotification('Заполните даты поездки', 'warning');
                return;
            }

            if (new Date(endDate) <= new Date(startDate)) {
                showNotification('Дата окончания должна быть позже даты начала', 'warning');
                return;
            }

            const invitedFriends = [];
            document.querySelectorAll('#friendsForInvite input:checked').forEach(cb => {
                invitedFriends.push(parseInt(cb.value));
            });

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/CreateTrip', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        title: title,
                        description: description,
                        startDate: new Date(startDate).toISOString(),
                        endDate: new Date(endDate).toISOString(),
                        totalBudget: totalBudget,
                        isPublic: document.getElementById('isPublic').checked,
                        invitedFriends: invitedFriends
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Поездка успешно создана!', 'success');

                    const modal = bootstrap.Modal.getInstance(document.getElementById('createTripModal'));
                    modal.hide();
                    document.getElementById('createTripForm').reset();
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при создании поездки', 'danger');
                }
            } catch (error) {
                console.error('Error creating trip:', error);
                showNotification('Не удалось создать поездку', 'danger');
            }
        }

