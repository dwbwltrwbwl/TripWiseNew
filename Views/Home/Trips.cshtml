        // Обновление поездки
                // Исправленная функция обновления поездки
        async function updateTrip(event) {
            event.preventDefault();

            // Получаем ID поездки
            const tripId = document.getElementById('editTripId')?.value;
            if (!tripId) {
                showNotification('Ошибка: ID поездки не найден', 'danger');
                return;
            }

            const title = document.getElementById('editTripName')?.value?.trim() || '';
            const description = document.getElementById('editTripDescription')?.value || '';
            const startDate = document.getElementById('editStartDate')?.value;
            const endDate = document.getElementById('editEndDate')?.value;

            // Получаем бюджет (с проверкой существования поля)
            let totalBudget = 0;
            const budgetInput = document.getElementById('editTotalBudget');
            if (budgetInput) {
                totalBudget = parseFloat(budgetInput.value) || 0;
            }

            const isPublicCheckbox = document.getElementById('editIsPublic');
            const isPublic = isPublicCheckbox ? isPublicCheckbox.checked : false;

            // Валидация
            if (!title) {
                showNotification('Введите название поездки', 'warning');
                return;
            }
            if (title.length < 3) {
                showNotification('Название должно содержать минимум 3 символа', 'warning');
                return;
            }
            if (title.length > 50) {
                showNotification('Название не может превышать 50 символов', 'warning');
                return;
            }

            if (description && description.length > 100) {
                showNotification('Описание не может превышать 100 символов', 'warning');
                return;
            }

            if (totalBudget < 0) {
                showNotification('Бюджет не может быть отрицательным', 'warning');
                return;
            }
            if (totalBudget.toString().length > 10) {
                showNotification('Бюджет не может превышать 10 знаков', 'warning');
                return;
            }

            if (!startDate || !endDate) {
                showNotification('Заполните даты поездки', 'warning');
                return;
            }

            const start = new Date(startDate);
            const end = new Date(endDate);

            if (end <= start) {
                showNotification('Дата окончания должна быть позже даты начала', 'warning');
                return;
            }

            // Проверка, что поездка не завершена
            const now = new Date();
            if (end < now) {
                showNotification('Нельзя редактировать завершенные поездки', 'warning');
                return;
            }

            // Показываем индикатор загрузки
            const submitBtn = event.target?.querySelector('.btn-primary') || document.querySelector('#editTripModal .btn-primary');
            const originalText = submitBtn?.innerHTML;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Сохранение...';
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const requestBody = {
                    id: parseInt(tripId),
                    title: title,
                    description: description,
                    startDate: start.toISOString(),
                    endDate: end.toISOString(),
                    totalBudget: totalBudget,
                    isPublic: isPublic
                };

                console.log('Sending update request:', requestBody);

                const response = await fetch('/Trips/UpdateTrip', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(requestBody)
                });

                const data = await response.json();
                console.log('Update response:', data);

                if (data.success) {
                    showNotification('Поездка успешно обновлена!', 'success');

                    // Закрываем модальное окно
                    if (editTripModal) {
                        editTripModal.hide();
                    }

                    // Перезагружаем список поездок
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при обновлении поездки', 'danger');
                }
            } catch (error) {
                console.error('Error updating trip:', error);
                showNotification('Не удалось обновить поездку. Проверьте подключение к интернету.', 'danger');
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }
        }

        // Вспомогательные функции
        function getDaysWord(days) {
            if (days % 10 === 1 && days % 100 !== 11) return 'день';
            if ([2,3,4].includes(days % 10) && ![12,13,14].includes(days % 100)) return 'дня';
            return 'дней';
        }

        function formatMoney(amount) {
            if (amount === null || amount === undefined) return '0';
            return amount.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
        }

        function getInitials(fullName) {
            if (!fullName) return '?';
            const parts = fullName.split(' ');
            if (parts.length >= 2) {
                return (parts[0][0] + parts[1][0]).toUpperCase();
            }
            return parts[0][0].toUpperCase();
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showNotification(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.minWidth = '300px';
            alertDiv.style.maxWidth = '400px';
            alertDiv.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' :
                                        type === 'danger' ? 'fa-exclamation-circle' :
                                        'fa-info-circle'} me-2"></i>
                    <div class="flex-grow-1">${message}</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.classList.remove('show');
                    setTimeout(() => alertDiv.remove(), 150);
                }
            }, 3000);
        }
