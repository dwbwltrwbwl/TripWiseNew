        // Экранирование спецсимволов для регулярного выражения
        function escapeRegex(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

                // Функция сортировки поездок
        function sortTrips(trips, sortType, sortOrder, isCompleted = false) {
            return [...trips].sort((a, b) => {
                switch(sortType) {
                    case 'date':
                        const dateA = new Date(a.startDate).getTime();
                        const dateB = new Date(b.startDate).getTime();

                        if (isCompleted) {
                            // Для завершенных поездок
                            // asc = сначала новые (более поздние даты первыми)
                            // desc = сначала старые (более ранние даты первыми)
                            if (sortOrder === 'asc') {
                                return dateB - dateA;
                            } else {
                                return dateA - dateB;
                            }
                        } else {
                            // Для предстоящих поездок
                            // asc = сначала новые (более ранние даты первыми)
                            // desc = сначала старые (более поздние даты первыми)
                            if (sortOrder === 'asc') {
                                return dateA - dateB;
                            } else {
                                return dateB - dateA;
                            }
                        }

                    case 'name':
                        const nameCompare = a.title.localeCompare(b.title, 'ru');
                        return sortOrder === 'asc' ? nameCompare : -nameCompare;

                    case 'budget':
                        if (sortOrder === 'asc') {
                            // Сначала дорогие: от большего к меньшему
                            return b.totalBudget - a.totalBudget;
                        } else {
                            // Сначала бюджетные: от меньшего к большему
                            return a.totalBudget - b.totalBudget;
                        }

                    case 'duration':
                        if (sortOrder === 'asc') {
                            // Сначала короткие: от меньшего к большему
                            return a.duration - b.duration;
                        } else {
                            // Сначала длинные: от большего к меньшему
                            return b.duration - a.duration;
                        }

                    default:
                        return 0;
                }
            });
        }

                        function renderFilteredTrips() {
            const now = new Date();

            let upcoming = allTrips.filter(trip => new Date(trip.endDate) >= now);
            let completed = allTrips.filter(trip => new Date(trip.endDate) < now);

            // Применяем поиск
            if (searchTerm) {
                upcoming = filterTripsBySearch(upcoming, searchTerm);
                completed = filterTripsBySearch(completed, searchTerm);
            }

            // Применяем фильтры
            upcoming = applyFilters(upcoming);
            completed = applyFilters(completed);

            // Применяем сортировку
            upcoming = sortTrips(upcoming, sortSettings.upcoming.type, sortSettings.upcoming.order, false);
            completed = sortTrips(completed, sortSettings.completed.type, sortSettings.completed.order, true);

            renderTrips(upcoming, 'upcoming');
            renderTrips(completed, 'completed');
            updateSearchResultsInfo(upcoming.length, completed.length);
        }

                function initFilterHandlers() {
            document.querySelectorAll('.filter-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();

                    const filterType = this.dataset.filterType;
                    const filterValue = this.dataset.filterValue;

                    if (filterType === 'role') {
                        filterRole = filterValue;
                        updateFilterButtonText('roleFilterBtn', filterValue, 'Роль');
                    } else if (filterType === 'participants') {
                        filterParticipants = filterValue;
                        updateFilterButtonText('participantsFilterBtn', filterValue, 'Участники');
                    }

                    // Показываем кнопку сброса, если применен любой фильтр
                    const clearBtn = document.getElementById('clearFiltersBtn');
                    if (filterRole !== 'all' || filterParticipants !== 'all') {
                        clearBtn.style.display = 'inline-flex';
                    } else {
                        clearBtn.style.display = 'none';
                    }

                    // Применяем фильтры
                    renderFilteredTrips();
                });
            });

            // Обработчик сброса фильтров
            const clearBtn = document.getElementById('clearFiltersBtn');
            if (clearBtn) {
                clearBtn.addEventListener('click', function() {
                    filterRole = 'all';
                    filterParticipants = 'all';

                    updateFilterButtonText('roleFilterBtn', 'all', 'Роль');
                    updateFilterButtonText('participantsFilterBtn', 'all', 'Участники');

                    this.style.display = 'none';
                    renderFilteredTrips();
                });
            }
        }
                function updateFilterButtonText(buttonId, value, defaultText) {
            const button = document.getElementById(buttonId);
            if (!button) return;

            const textMap = {
                'all': defaultText,
                'organizer': 'Организатор',
                'participant': 'Участник',
                'with-friends': 'С друзьями',
                'only-friends': 'Только друзья',
                'without-friends': 'Без друзей'
            };

            const iconMap = {
                'roleFilterBtn': '<i class="fas fa-user-tag me-1"></i>',
                'participantsFilterBtn': '<i class="fas fa-users me-1"></i>'
            };

            const icon = iconMap[buttonId] || '';
            const text = textMap[value] || defaultText;
            button.innerHTML = `${icon} ${text}: ${value === 'all' ? 'Все' : text}`;
        }
        // Поиск по поездкам
        function filterTripsBySearch(trips, term) {
            if (!term || term.trim() === '') return trips;

            const searchLower = term.toLowerCase().trim();
            return trips.filter(trip =>
                trip.title.toLowerCase().includes(searchLower) ||
                (trip.description && trip.description.toLowerCase().includes(searchLower)) ||
                trip.createdBy.fullName.toLowerCase().includes(searchLower) ||
                trip.participants.some(p => p.fullName.toLowerCase().includes(searchLower))
            );
        }

        // Обновление информации о результатах поиска
                // Обновление информации о результатах поиска
        function updateSearchResultsInfo(upcomingCount, completedCount) {
            const clearButton = document.getElementById('clearSearch');
            const searchInput = document.getElementById('searchTrips');

            if (searchTerm && searchTerm.trim() !== '') {
                clearButton.style.display = 'block';
                const totalFound = upcomingCount + completedCount;

                // Обновляем плейсхолдер
                if (searchInput) {
                    searchInput.placeholder = `Поиск: "${searchTerm}" (найдено: ${totalFound})`;
                }

                if (totalFound === 0) {
                    // Уведомление уже показывается в renderTrips через пустое состояние
                } else {
                    showNotification(`Найдено поездок: ${totalFound} (предстоящих: ${upcomingCount}, завершенных: ${completedCount})`, 'info');
                }
            } else {
                clearButton.style.display = 'none';
                if (searchInput) {
                    searchInput.placeholder = 'Поиск по названию или описанию...';
                }
            }
        }

