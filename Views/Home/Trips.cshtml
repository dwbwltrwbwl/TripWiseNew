@section Scripts {
    <script src="~/js/friends.js"></script>
    <script>
        // Глобальные переменные
        let currentUserId = @Json.Serialize(userId);
        let allTrips = [];
        let deleteTripModal = null;
        let editTripModal = null;
        let searchTerm = '';
        let searchTimeout = null;
        let manageParticipantsModal = null;
        let filterRole = 'all';
        let filterParticipants = 'all';

        let sortSettings = {
            upcoming: { type: 'date', order: 'asc' },
            completed: { type: 'date', order: 'asc' }
        };
                function setupCharCountersForDescription() {
            const descriptionInput = document.getElementById('tripDescription');
            const descriptionCounter = document.getElementById('descriptionCounter');

            if (descriptionInput && descriptionCounter) {
                descriptionInput.addEventListener('input', function() {
                    const count = this.value.length;
                    descriptionCounter.textContent = `${count}/100`;
                    if (count >= 100) {
                        descriptionCounter.style.color = '#dc3545';
                    } else if (count >= 90) {
                        descriptionCounter.style.color = '#ffc107';
                    } else {
                        descriptionCounter.style.color = '#6c757d';
                    }
                });
            }
        }
                // Инициализация при загрузке страницы
                document.addEventListener('DOMContentLoaded', function() {
            console.log('Trips page loaded');
                    const editDescriptionInput = document.getElementById('editTripDescription');
        const editDescriptionCounter = document.getElementById('editDescriptionCounter');

            if (currentUserId) {
                // Загружаем поездки и друзей
                loadTrips();
                loadFriendsForInvite();

                // Загружаем приглашения (ДОБАВИТЬ ЭТУ СТРОКУ)
                loadInvitations();

                // Инициализируем модальное окно удаления
                const modalElement = document.getElementById('deleteTripModal');
                if (modalElement) {
                    deleteTripModal = new bootstrap.Modal(modalElement);
                    modalElement.addEventListener('hidden.bs.modal', function() {
                        resetDeleteModal();
                    });
                }

                // Инициализируем модальное окно участников
                const manageModalElement = document.getElementById('manageParticipantsModal');
                if (manageModalElement) {
                    manageParticipantsModal = new bootstrap.Modal(manageModalElement);
                }

                // Инициализируем модальное окно редактирования
                const editModalElement = document.getElementById('editTripModal');
                if (editModalElement) {
                    editTripModal = new bootstrap.Modal(editModalElement);
                }
                        if (editDescriptionInput && editDescriptionCounter) {
            editDescriptionInput.addEventListener('input', function() {
                const count = this.value.length;
                editDescriptionCounter.textContent = `${count}/100`;
                if (count >= 100) {
                    editDescriptionCounter.style.color = '#dc3545';
                } else if (count >= 90) {
                    editDescriptionCounter.style.color = '#ffc107';
                } else {
                    editDescriptionCounter.style.color = '#6c757d';
                }
            });
        }
                // Инициализируем поиск
                const searchInput = document.getElementById('searchTrips');
                const clearButton = document.getElementById('clearSearch');

                if (searchInput) {
                    searchInput.addEventListener('input', handleSearchInput);
                    searchInput.addEventListener('keydown', handleSearchKeyPress);
                }

                if (clearButton) {
                    clearButton.addEventListener('click', clearSearch);
                }

                // Добавляем обработчики для сортировки
                initSortHandlers();

                // Добавляем обработчики для фильтров
                initFilterHandlers();
            }
            setupCharCountersForDescription();
        });

        // Инициализация обработчиков сортировки
        function initSortHandlers() {
            document.querySelectorAll('.sort-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();

                    const sortValue = this.dataset.sort;
                    const section = this.dataset.section;
                    const [type, order] = sortValue.split('-');

                    console.log('Sort clicked:', { type, order, section });

                    // Обновляем настройки сортировки
                    sortSettings[section] = { type, order };

                    // Применяем сортировку с учетом текущего поиска
                    renderFilteredTrips();

                    // Обновляем текст кнопки
                    updateSortButtonsText();

                    // Показываем уведомление
                    const typeText = {
                        'date': 'дате',
                        'name': 'названию',
                        'budget': 'бюджету',
                        'duration': 'длительности'
                    }[type];

                    const orderText = {
                        'asc': {
                            'date': 'сначала ранние',
                            'name': 'А-Я',
                            'budget': 'сначала дорогие',
                            'duration': 'сначала короткие'
                        },
                        'desc': {
                            'date': 'сначала поздние',
                            'name': 'Я-А',
                            'budget': 'сначала бюджетные',
                            'duration': 'сначала длинные'
                        }
                    }[order][type];

                    showNotification(`Поездки отсортированы по ${typeText} (${orderText})`, 'success');
                });
            });
        }

        // Функция для сброса состояния модального окна удаления
        function resetDeleteModal() {
            document.getElementById('deleteStep1').style.display = 'block';
            document.getElementById('deleteStep2').style.display = 'none';
            document.getElementById('deleteStep1Btn').style.display = 'inline-block';
            document.getElementById('deleteStep2Btns').style.display = 'none';
            document.getElementById('deleteChatYes').checked = true;
        }

        // Загрузка поездок
        async function loadTrips() {
