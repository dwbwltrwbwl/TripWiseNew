                                                // ИСПРАВЛЕННАЯ функция formatTime
                // ИСПРАВЛЕННАЯ функция formatTime - использует локальное время браузера
                        function formatTime(dateString) {
    const date = normalizeDate(dateString);
    if (!date) return '';
    
    const options = {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
    };
    
    return date.toLocaleTimeString('ru-RU', options);
}

function normalizeDate(dateInput) {
    if (!dateInput) return null;

    try {
        let date;
        
        if (typeof dateInput === 'string') {
            // Убираем миллисекунды если есть
            let cleanDateStr = dateInput.replace(/\.\d+/, '');
            
            // Если нет Z в конце, добавляем Z для указания UTC
            if (!cleanDateStr.endsWith('Z')) {
                cleanDateStr = cleanDateStr + 'Z';
            }
            
            // Создаем дату из UTC строки
            const utcDate = new Date(cleanDateStr);
            
            if (isNaN(utcDate.getTime())) {
                return new Date(dateInput);
            }
            
            return utcDate;
        } else if (dateInput instanceof Date) {
            return dateInput;
        }
        
        return null;
    } catch {
        return null;
    }
}

        // Функция для получения даты без времени
        function getDateOnly(date) {
            if (!date) return null;
            const d = new Date(date);
            d.setHours(0, 0, 0, 0);
            return d;
        }

        // Функция для получения разницы в днях
        function getDaysDifference(date1, date2) {
            const d1 = getDateOnly(date1);
            const d2 = getDateOnly(date2);
            if (!d1 || !d2) return null;

            const diffTime = d2 - d1;
            return Math.floor(diffTime / (1000 * 60 * 60 * 24));
        }
        // ИСПРАВЛЕННАЯ функция formatMessageTime
                function formatMessageTime(dateString) {
    const date = normalizeDate(dateString);
    if (!date) return '';

    const now = new Date();
    const daysDiff = getDaysDifference(date, now);

    if (daysDiff === null) return '';

    if (daysDiff === 0) {
        // Сегодня - показываем время
        const options = {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        };
        return date.toLocaleTimeString('ru-RU', options);
    } else if (daysDiff === 1) {
        return 'Вчера';
    } else if (daysDiff < 7) {
        // Меньше недели - показываем день недели
        const options = { weekday: 'short' };
        return date.toLocaleDateString('ru-RU', options);
    } else {
        // Больше недели - показываем дату
        const options = {
            day: 'numeric',
            month: 'short'
        };
        return date.toLocaleDateString('ru-RU', options);
    }
}

        // ИСПРАВЛЕННАЯ функция formatDate для разделителей
                        // ИСПРАВЛЕННАЯ функция formatDate для разделителей
        function formatDate(dateString) {
            const date = normalizeDate(dateString);
            if (!date) return '';
    
            const now = new Date();
    
            // Получаем начало дня для обеих дат
            const dateStart = new Date(date.getFullYear(), date.getMonth(), date.getDate());
            const nowStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    
            const diffDays = Math.floor((nowStart - dateStart) / (1000 * 60 * 60 * 24));
    
            if (diffDays === 0) {
                return 'Сегодня';
            } else if (diffDays === 1) {
                return 'Вчера';
            } else if (diffDays < 7) {
                // Меньше недели - показываем день недели
                const options = { weekday: 'long' };
                return date.toLocaleDateString('ru-RU', options);
            } else {
                // Больше недели - показываем дату
                const options = {
                    day: 'numeric',
                    month: 'long'
                };
                // Добавляем год если отличается
                if (date.getFullYear() !== now.getFullYear()) {
                    options.year = 'numeric';
                }
                return date.toLocaleDateString('ru-RU', options);
            }
        }

                function shouldShowDateSeparator(prevMessageTime, currentMessageTime) {
            if (!prevMessageTime || !currentMessageTime) return true;
    
            const prevDate = normalizeDate(prevMessageTime);
