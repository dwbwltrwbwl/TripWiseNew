        // Создать голосование
                async function createVote() {
            const question = document.getElementById('voteQuestion').value.trim();
            const options = [];
            const expiresAt = document.getElementById('voteExpiresAt').value;

            document.querySelectorAll('#voteOptionsContainer input[type="text"]').forEach(input => {
                const text = input.value.trim();
                if (text) {
                    options.push(text);
                }
            });

            if (!question) {
                showNotification('Введите вопрос', 'warning');
                return;
            }

            if (options.length < 2) {
                showNotification('Добавьте минимум 2 варианта ответа', 'warning');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/CreateVote', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        chatId: currentChatId,
                        question: question,
                        options: options,
                        expiresAt: expiresAt ? new Date(expiresAt).toISOString() : null
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Голосование создано!', 'success');

                    const modal = bootstrap.Modal.getInstance(document.getElementById('createVoteModal'));
                    modal.hide();

                    // Обновляем чат (добавляем сообщение о голосовании)
                    await loadChatMessages(currentChatId);
                } else {
                    showNotification(data.message || 'Ошибка при создании', 'danger');
                }
            } catch (error) {
                console.error('Error creating vote:', error);
                showNotification('Не удалось создать голосование', 'danger');
            }
        }
              function renderVoteMessage(voteData) {
    console.log('renderVoteMessage called with:', voteData);

    if (!voteData || !voteData.options) {
        console.error('Invalid voteData:', voteData);
        return '<div class="vote-message error">Ошибка загрузки голосования</div>';
    }

    // Функция для правильного парсинга UTC даты в локальное время
    function formatExpiresDate(expiresAt) {
        if (!expiresAt) return null;
        
        try {
            // Парсим строку как UTC
            // Формат: "2026-05-11T17:34:00" или "2026-05-11T17:34:00Z"
            let cleanDateStr = expiresAt.replace(/\.\d+/, '');
            if (!cleanDateStr.endsWith('Z')) {
                cleanDateStr = cleanDateStr + 'Z';
            }
            
            const utcDate = new Date(cleanDateStr);
            if (isNaN(utcDate.getTime())) return null;
            
            // toLocaleDateString автоматически конвертирует UTC в локальное время
            return utcDate.toLocaleDateString('ru-RU', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        } catch (e) {
            console.error('Error formatting date:', e);
            return expiresAt;
        }
    }

    // Функция для правильного парсинга UTC даты для проверки истекло ли
    function isDateExpired(expiresAt) {
        if (!expiresAt) return false;

        try {
            let cleanDateStr = expiresAt.replace(/\.\d+/, '');
            if (!cleanDateStr.endsWith('Z')) {
                cleanDateStr = cleanDateStr + 'Z';
            }
            
            const expiresUTC = new Date(cleanDateStr);
            const now = new Date();
            
            return expiresUTC < now;
        } catch (e) {
            console.error('Error checking expiration:', e);
            return false;
        }
    }

    const isExpired = voteData.isExpired || isDateExpired(voteData.expiresAt);
    const totalVotes = voteData.options.reduce((sum, opt) => sum + (opt.votesCount || 0), 0);
    const userHasVoted = voteData.userHasVoted || false;

    let html = `
        <div class="vote-message">
            <div class="vote-question">
                ${escapeHtml(voteData.question)}
            </div>
            <div class="vote-options">
    `;

    voteData.options.forEach(option => {
        const percentage = totalVotes > 0 ? Math.round((option.votesCount / totalVotes) * 100) : 0;
        const isSelected = userHasVoted && voteData.userVoteOptionId === option.id;
        const disabled = isExpired || userHasVoted;
        const hasVotes = option.votesCount > 0;

        html += `
            <div class="vote-option ${isSelected ? 'selected' : ''} ${disabled ? 'disabled' : ''}"
                 data-option-id="${option.id}"
                 ${!disabled ? `onclick="submitVote(${voteData.voteId}, ${option.id})"` : ''}>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="option-text">
                        ${escapeHtml(option.text)}
                        ${isSelected ? '<span class="badge bg-success ms-2">Ваш голос</span>' : ''}
                    </div>
                    <div class="vote-count">${option.votesCount} голос(ов)</div>
                </div>
                <div class="progress">
                    <div class="progress-bar bg-primary" style="width: ${percentage}%"></div>
                </div>
                ${hasVotes ? `
                <div class="text-end mt-1">
                    <button class="btn btn-sm btn-link text-muted p-0" onclick="showVoteDetails(${voteData.voteId}, ${option.id}, '${escapeHtml(option.text)}', event)">
                        <i class="fas fa-users me-1"></i>Кто голосовал?
                    </button>
                </div>
                ` : ''}
            </div>
        `;
    });

    html += `
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="vote-total">
                    <i class="fas fa-users me-1"></i>Всего голосов: ${totalVotes}
                </div>
    `;

    if (voteData.expiresAt) {
        const formattedDate = formatExpiresDate(voteData.expiresAt);
        if (formattedDate) {
            html += `
                <div class="vote-expired">
                    ${isExpired ?
                        '<i class="fas fa-clock me-1"></i>Голосование завершено' :
                        `<i class="fas fa-hourglass-half me-1"></i>До ${formattedDate}`
                    }
                </div>
            `;
        }
    }

    html += `
            </div>
        </div>
    `;

    return html;
}
                // Показать детали голосования (кто за что голосовал)
