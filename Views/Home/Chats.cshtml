        const urlParams = new URLSearchParams(window.location.search);
        const chatIdFromUrl = urlParams.get('chatId');
        console.log('chatId из URL:', chatIdFromUrl);

        if (chatIdFromUrl) {
            // Ждем загрузки чатов
            const checkInterval = setInterval(() => {
                const chatElements = document.querySelectorAll('[data-chat-id]');

                if (chatElements.length > 0) {
                    clearInterval(checkInterval);

                    const existingChatIds = Array.from(chatElements).map(el =>
                        parseInt(el.getAttribute('data-chat-id'))
                    );

                    console.log('Существующие чаты:', existingChatIds);

                    if (existingChatIds.includes(parseInt(chatIdFromUrl))) {
                        // Чат существует, выбираем его
                        selectChat(parseInt(chatIdFromUrl), null, null);
                    } else {
                        // Чат не существует, удаляем параметр из URL
                        console.log('Чат с ID', chatIdFromUrl, 'не найден, удаляем из URL');

                        const url = new URL(window.location);
                        url.searchParams.delete('chatId');
                        window.history.replaceState({}, '', url);

                        // Если есть другие чаты, можно показать уведомление
                        if (existingChatIds.length > 0) {
                            showNotification('Чат не найден, выберите другой чат', 'warning');
                        }
                    }
                }
            }, 100);
        }

        // В начале после загрузки страницы
                        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM Content Loaded');
            console.log('Current User ID:', currentUserId);

            if (currentUserId) {
                console.log('Loading user chats...');
                loadUserChats();

                // Устанавливаем начальное состояние (currentChatId = null)
                updateChatVisibility();

