                const allImages = allFiles || [file];
                const imagesJson = JSON.stringify(allImages.map(f => ({ url: f.fileUrl, name: f.fileName })));

                return `
                    <div class="attachment-item image-item" data-file-url="${file.fileUrl}" data-all-images='${imagesJson}' data-current-index="${index}">
