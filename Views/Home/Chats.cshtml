                        function displayPinnedMessages(globalPin, userPin) {
            const chatHeader = document.getElementById('chatHeader');
            if (!chatHeader) return;

            // Удаляем старые контейнеры
            const oldContainers = document.querySelectorAll('.pinned-message-container');
            oldContainers.forEach(container => container.remove());

            // Если есть оба закрепленных сообщения, показываем оба
            if (globalPin) {
                displayPinnedMessage(globalPin, true);
            }
            if (userPin) {
                displayPinnedMessage(userPin, false);
            }
        }

                function displayPinnedMessage(message, isGlobal) {
            const chatHeader = document.getElementById('chatHeader');
            if (!chatHeader) return;

            // Функция для обрезки длинного текста
            function truncateText(text, maxLength) {
                if (!text) return '';
                if (text.length <= maxLength) return escapeHtml(text);
                return escapeHtml(text.substring(0, maxLength)) + '...';
            }

            // Функция для обрезки длинного ФИО
            function truncateName(fullName, maxLength) {
                if (!fullName) return 'Пользователь';
                if (fullName.length <= maxLength) return escapeHtml(fullName);

                // Пробуем сократить до имени + первой буквы фамилии
                const parts = fullName.split(' ');
                if (parts.length >= 2) {
                    const firstName = parts[0];
                    const lastNameInitial = parts[1].charAt(0);
                    return escapeHtml(`${firstName} ${lastNameInitial}.`);
                }

                return escapeHtml(fullName.substring(0, maxLength)) + '...';
            }

            const pinnedContainer = document.createElement('div');
            pinnedContainer.className = `pinned-message-container bg-light p-2 border-bottom ${isGlobal ? 'global-pin' : 'user-pin'}`;
            pinnedContainer.style.cursor = 'pointer';
            pinnedContainer.setAttribute('data-pinned-message-id', message.id);

            // Обрезаем ФИО отправителя (максимум 30 символов)
            const senderName = truncateName(message.senderName, 30);

            // Обрезаем текст сообщения (максимум 50 символов)
            const messageText = truncateText(message.text || 'Файл', 50);

            pinnedContainer.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas fa-thumbtack ${isGlobal ? 'text-primary' : 'text-success'} me-2" style="transform: rotate(45deg); flex-shrink: 0;"></i>
                    <div class="flex-grow-1" onclick="scrollToPinnedMessage(${message.id}, event)" style="min-width: 0;">
                        <small class="text-muted">${isGlobal ? 'Закреплено для всех' : 'Закреплено для вас'}</small>
                        <div class="d-flex align-items-center" style="min-width: 0;">
                            <span class="fw-bold me-2" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(message.senderName)}">${senderName}:</span>
                            <span class="text-truncate" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(message.text || 'Файл')}">${messageText}</span>
                        </div>
                        <small class="text-muted">
                            ${isGlobal ? `Закрепил(а) ${truncateName(message.pinnedBy, 25)}` : 'Закреплено вами'} • ${formatTime(message.pinnedAt)}
                        </small>
                    </div>
                    <button class="btn btn-sm btn-link text-danger flex-shrink-0" onclick="unpinMessage(${currentChatId}, ${isGlobal}, event)" title="Открепить">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;

            // Добавляем эффект наведения
            pinnedContainer.addEventListener('mouseenter', () => {
                pinnedContainer.style.backgroundColor = '#e9ecef';
            });

            pinnedContainer.addEventListener('mouseleave', () => {
                pinnedContainer.style.backgroundColor = '#f8f9fa';
            });

            chatHeader.after(pinnedContainer);
        }

