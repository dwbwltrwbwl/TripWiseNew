                        counter.textContent = `${this.value.length} / 50`;
                        if (this.value.length > 45) {
                            counter.classList.add('text-warning');
                        } else if (this.value.length > 48) {
                            counter.classList.add('text-danger');
                            counter.classList.remove('text-warning');
                        } else {
                            counter.classList.remove('text-warning', 'text-danger');
                        }
                    }
                });
            }

            const modal = new bootstrap.Modal(document.getElementById('createVoteModal'));
            modal.show();
        }

        // Функция для обновления счетчика вариантов
        function updateVoteOptionsCounter() {
            const container = document.getElementById('voteOptionsContainer');
            const count = container.children.length;
            const counter = document.getElementById('voteOptionsCounter');
            if (counter) {
