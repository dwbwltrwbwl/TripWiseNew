                        async function checkNewMessages(chatId) {
            try {
                const response = await fetch(`/Chats/GetNewMessages?chatId=${chatId}&lastMessageId=${lastMessageId}`);
                const data = await response.json();

                if (data.success && data.data && data.data.length > 0) {
                    const existingMessageIds = new Set();
                    document.querySelectorAll('.message').forEach(msgElement => {
                        const msgId = msgElement.getAttribute('data-message-id');
                        if (msgId) existingMessageIds.add(parseInt(msgId));
                    });

                    const newMessages = data.data.filter(msg => !existingMessageIds.has(msg.id));

                    if (newMessages.length > 0) {
                        newMessages.sort((a, b) => {
                            const dateA = normalizeDate(a.sentAt);
                            const dateB = normalizeDate(b.sentAt);
                            return dateA - dateB;
                        });

                        // Получаем время последнего сообщения в чате
                        let lastMessageTime = null;
                        const lastMessageElement = document.querySelector('.message:last-child');
                        if (lastMessageElement) {
                            const lastMsgId = lastMessageElement.getAttribute('data-message-id');
                            const lastMsg = data.data.find(m => m.id === parseInt(lastMsgId));
                            if (lastMsg) {
                                lastMessageTime = lastMsg.sentAt;
                            }
                        }

                        let lastAddedDate = null;
                
                        newMessages.forEach((msg, index) => {
                            // Проверяем нужен ли разделитель
                            const currentDateStr = formatDate(msg.sentAt);
                    
                            if (index === 0 && lastMessageTime) {
                                const lastDateStr = formatDate(lastMessageTime);
                                if (lastDateStr !== currentDateStr) {
                                    addDateSeparator(msg.sentAt);
                                    lastAddedDate = currentDateStr;
                                }
                            } else if (index > 0) {
                                const prevDateStr = formatDate(newMessages[index - 1].sentAt);
                                if (prevDateStr !== currentDateStr) {
                                    addDateSeparator(msg.sentAt);
                                    lastAddedDate = currentDateStr;
                                }
                            }

                            appendMessageToUI(msg);
                        });
                        cleanDuplicateDateSeparators();
                        await markMessagesAsRead(chatId);
                        await loadUserChats();
                        lastMessageId = Math.max(...newMessages.map(m => m.id), lastMessageId);
                    }
                }
            } catch (error) {
                console.error('Ошибка проверки новых сообщений:', error);
            }
        }
                function cleanDuplicateDateSeparators() {
            const messagesList = document.getElementById('messagesList');
            if (!messagesList) return;
    
            const separators = messagesList.querySelectorAll('.date-separator');
            let lastDate = null;
    
            separators.forEach(separator => {
                const currentDate = separator.querySelector('span')?.textContent;
                if (currentDate === lastDate) {
                    separator.remove(); // Удаляем дубликат
                } else {
                    lastDate = currentDate;
                }
            });
        }
                                function addDateSeparator(dateString) {
            const messagesList = document.getElementById('messagesList');
            if (!messagesList) return;
    
            const newDateStr = formatDate(dateString);
    
            // Проверяем, есть ли уже разделитель с такой датой в конце списка
            const existingSeparators = messagesList.querySelectorAll('.date-separator');
    
            // Проверяем последний разделитель
            const lastSeparator = existingSeparators[existingSeparators.length - 1];
            if (lastSeparator) {
                const lastDateStr = lastSeparator.querySelector('span')?.textContent;
                if (lastDateStr === newDateStr) {
                    console.log('Разделитель уже существует для даты:', newDateStr);
                    return; // Не добавляем повторно
                }
            }
    
            console.log('Добавляем новый разделитель:', newDateStr);
            const dateSeparator = document.createElement('div');
            dateSeparator.className = 'date-separator';
            dateSeparator.innerHTML = `<span>${newDateStr}</span>`;
            messagesList.appendChild(dateSeparator);
        }
