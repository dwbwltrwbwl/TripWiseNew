                        async function deleteChat() {
            if (!currentChatId) return;

            // Получаем информацию о чате для подтверждения
            const chatTitle = document.getElementById('chatTitle').textContent;

            // Спрашиваем подтверждение
            const confirmMessage = `Вы уверены, что хотите удалить чат "${chatTitle}"?\n\n` +
                `- Для группового чата: удалится весь чат для всех участников\n` +
                `- Для личного чата: вы просто покинете чат`;

            if (!confirm(confirmMessage)) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(`/Chats/DeleteChat?chatId=${currentChatId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();
                console.log('Результат удаления чата:', data);

                if (data.success) {
                    showNotification(data.message || 'Чат удален', 'success');

                    // Сбрасываем текущий чат
                    currentChatId = null;

                    // ТОЛЬКО вызываем updateChatVisibility - она сама все сделает
                    updateChatVisibility();

                    // Удаляем chatId из URL
                    const url = new URL(window.location);
                    url.searchParams.delete('chatId');
                    window.history.replaceState({}, '', url);

                    // Перезагружаем список чатов
                    await loadUserChats();
                } else {
                    showNotification(data.message || 'Ошибка при удалении чата', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при удалении чата:', error);
                showNotification('Не удалось удалить чат: ' + error.message, 'danger');
            }
        }

        // Обертка для fetch запросов
        async function fetchWithErrorHandling(url, options = {}) {
            try {
                const response = await fetch(url, {
                    ...options,
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken(),
                        ...options.headers
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                return data;
            } catch (error) {
                console.error(`Fetch error for ${url}:`, error);
                throw error;
            }
        }
                        async function selectChat(chatId, event, element) {
    // Защита от повторных вызовов
    if (isSelectingChat) {
        console.log('Уже выбираем чат, пропускаем');
        return;
    }

    // ВАЖНО: проверяем chatId
    if (!chatId || chatId === undefined || chatId === null) {
        console.error('selectChat: chatId не передан или равен null/undefined');
        showNotification('Ошибка: ID чата не указан', 'danger');
        return;
    }

    console.log('selectChat вызван с chatId:', chatId, 'тип:', typeof chatId);

    // Предотвращаем стандартное поведение ссылки
    if (event) event.preventDefault();

    // Проверяем, не выбран ли уже этот чат
    if (currentChatId === chatId) {
        console.log('Чат уже выбран');
        return;
    }

    isSelectingChat = true;

    try {
        // Проверяем, существует ли элемент чата в DOM
        const chatElement = element || document.querySelector(`[data-chat-id="${chatId}"]`);
        if (!chatElement) {
            console.error('Чат с ID', chatId, 'не найден в DOM');
            showNotification('Чат не найден', 'warning');
            return;
        }

        // Выходим из предыдущего чата в SignalR
        if (currentChatId) {
            await leaveChatSignalR(currentChatId);
        }

        // Обновляем URL без перезагрузки страницы
        const url = new URL(window.location);
        url.searchParams.set('chatId', chatId);
        window.history.pushState({}, '', url);

        // Убираем активный класс у всех чатов
        document.querySelectorAll('.chat-item').forEach(el => {
            el.classList.remove('active');
        });

        // Добавляем активный класс выбранному
        chatElement.classList.add('active');

        // Устанавливаем currentChatId и обновляем видимость
        currentChatId = chatId;
        updateChatVisibility();

        // Показываем индикатор загрузки
        document.getElementById('chatTitle').textContent = 'Загрузка...';
        document.getElementById('chatMembers').textContent = '';
        document.getElementById('messagesList').innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
                <p class="mt-2 text-muted">Загрузка чата...</p>
            </div>
        `;

        // Загружаем информацию о чате
        const chatInfo = await loadChatInfo(chatId);
        
        // Присоединяемся к чату в SignalR
        await joinChat(chatId);
        
        // ✅ ЗАГРУЖАЕМ ГОЛОСОВАНИЯ ДЛЯ ЧАТА (ВАЖНО!)
        await loadVotesForChat(chatId);
        
        // Если чат не найден или нет доступа - возвращаемся к заглушке
        if (!chatInfo || !chatInfo.success) {
            console.log('Чат недоступен, возвращаемся к списку');

            // Сбрасываем currentChatId
            currentChatId = null;
            updateChatVisibility();

            // Убираем активный класс
            chatElement.classList.remove('active');

            // Удаляем chatId из URL
            removeChatFromUrl();

            // Показываем уведомление об ошибке
            showNotification(chatInfo?.message || 'Чат недоступен', 'warning');
            return;
        }

        // Загружаем сообщения (они будут использовать загруженные голосования)
        if (typeof loadChatMessages === 'function') {
            console.log('Загружаем сообщения...');
            await loadChatMessages(chatId);
            await loadPinnedMessages(chatId);

            // Отмечаем все сообщения как прочитанные
            await markMessagesAsRead(chatId);
            await checkAndUpdateAdminStatus(chatId);
        } else {
            console.error('Функция loadChatMessages не определена!');
            showNotification('Ошибка: функция загрузки сообщений не найдена', 'danger');
        }

        // Начинаем периодическое обновление сообщений
        startMessagesRefresh(chatId);

    } catch (error) {
        console.error('Ошибка при выборе чата:', error);
        showNotification('Ошибка при загрузке чата: ' + error.message, 'danger');

        // В случае ошибки возвращаемся к заглушке
        if (currentChatId === chatId) {
            currentChatId = null;
            updateChatVisibility();
            removeChatFromUrl();
        }
    } finally {
        // Сбрасываем флаг выбора чата через небольшую задержку
        setTimeout(() => {
            isSelectingChat = false;
        }, 500);
    }
}

                                async function loadChatMessages(chatId) {
    try {
        console.log('Загрузка сообщений чата:', chatId);
        
        // ✅ СНАЧАЛА загружаем голосования для этого чата
        await loadVotesForChat(chatId);
        
        const response = await fetch(`/Chats/GetChatMessages?chatId=${chatId}`);
        const data = await response.json();
        console.log('Сообщения чата (сырые):', data);

        if (data.success) {
            // Создаем карту голосований для быстрого доступа
            const votesMap = new Map();
            if (window.votesData && window.votesData.length) {
                window.votesData.forEach(vote => {
                    votesMap.set(vote.id, vote);
                    console.log(`Vote ${vote.id} has options:`, vote.options);
                });
            }
            console.log('votesMap:', votesMap);

            // Обрабатываем сообщения
            const processedMessages = data.data.map(msg => {
                const isVote = msg.attachmentType === 'vote';
                console.log(`Сообщение ${msg.id}: isVote=${isVote}`);

                if (isVote && msg.attachmentsJson) {
                    try {
                        let voteInfo;
                        if (typeof msg.attachmentsJson === 'string') {
                            voteInfo = JSON.parse(msg.attachmentsJson);
                        } else {
                            voteInfo = msg.attachmentsJson;
                        }

                        console.log('Найдено голосование в сообщении:', voteInfo);
                        console.log('voteInfo.voteId:', voteInfo.voteId);

                        const fullVote = votesMap.get(voteInfo.voteId);
                        console.log('Полные данные голосования из votesMap:', fullVote);

                        if (fullVote && fullVote.options && fullVote.options.length > 0) {
                            return {
                                ...msg,
                                isVoteMessage: true,
                                text: msg.text || `📊 Голосование: ${fullVote.question}`,
                                voteData: {
                                    voteId: fullVote.id,
                                    question: fullVote.question,
                                    options: fullVote.options,
                                    expiresAt: fullVote.expiresAt,
                                    isExpired: fullVote.isExpired,
                                    userHasVoted: fullVote.userHasVoted,
                                    userVoteOptionId: fullVote.userVoteOptionId
                                }
                            };
                        } else {
                            console.warn('Голосование не найдено в votesMap или нет options');
                            return {
                                ...msg,
                                isVoteMessage: true,
                                voteData: {
                                    voteId: voteInfo.voteId,
                                    question: voteInfo.question,
                                    options: [],
                                    expiresAt: voteInfo.expiresAt,
                                    isExpired: voteInfo.expiresAt ? new Date(voteInfo.expiresAt) < new Date() : false,
                                    userHasVoted: false,
                                    userVoteOptionId: null
                                }
                            };
                        }
                    } catch (e) {
                        console.error('Error parsing vote data:', e);
                        return msg;
                    }
                }
                return msg;
            });

            console.log('Обработанные сообщения:', processedMessages);
            renderMessages(processedMessages);

            if (data.data && data.data.length > 0) {
                lastMessageId = Math.max(...data.data.map(m => m.id));
            }

            markMessagesAsRead(chatId);
            return { success: true };
        } else {
            console.error('Ошибка загрузки сообщений:', data.message);
            return { success: false, message: data.message };
        }
    } catch (error) {
        console.error('Ошибка загрузки сообщений:', error);
        return { success: false, message: error.message };
    }
}
        async function loadChatInfo(chatId) {
    try {
