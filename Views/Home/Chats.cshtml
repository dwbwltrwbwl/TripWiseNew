            } else {
                console.log('User not logged in');
            }

            if (currentUserId) {
            initSignalR();
        }
        });
        async function initSignalR() {
        if (connection) {
        try {
        await connection.stop();
        } catch(e) { console.log(e); }
        }

        connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub", {
        accessTokenFactory: () => {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
        }
        })
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();

        // Обработка входящих сообщений
        connection.on("ReceiveMessage", (message) => {
        console.log("SignalR получил сообщение:", message);

        // Если это текущий чат, добавляем сообщение в UI
        if (currentChatId === message.chatId) {
        appendMessageToUI(message);
        markMessagesAsRead(currentChatId);

        // Обновляем lastMessageId
        if (message.id > lastMessageId) {
        lastMessageId = message.id;
        }
        } else {
        // Если сообщение из другого чата, обновляем список чатов
        loadUserChats();
        showNotification(`Новое сообщение от ${message.senderName}`, 'info');
        }
        });

        connection.onreconnecting((error) => {
        console.log("SignalR переподключение...", error);
        });

        connection.onreconnected((connectionId) => {
        console.log("SignalR переподключен:", connectionId);
        // После переподключения присоединяемся к текущему чату
        if (currentChatId) {
        connection.invoke("JoinChat", currentChatId).catch(err => console.error(err));
        }
        });

        connection.onclose((error) => {
        console.log("SignalR отключен:", error);
        });

        try {
        await connection.start();
        console.log("SignalR подключен");

        // Если есть текущий чат, присоединяемся к нему
        if (currentChatId) {
        await connection.invoke("JoinChat", currentChatId);
        }
        } catch (err) {
        console.error("SignalR ошибка подключения:", err);
        setTimeout(() => initSignalR(), 5000);
        }
        }

