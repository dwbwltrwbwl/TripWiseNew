                const response = await fetch('/Chats/RenameChat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        chatId: chatId,
                        newName: newName.trim()
                    })
                });

                const data = await response.json();

                if (data.success) {
                    textElement.textContent = newName.trim();
                    showNotification('Название изменено', 'success');

                    // Если это текущий открытый чат, обновляем и заголовок
                    if (currentChatId === chatId) {
