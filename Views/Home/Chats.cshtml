                                async function deleteMessage(messageId, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            // Сначала проверяем, не закреплено ли это сообщение
            try {
                const pinnedResponse = await fetch(`/Chats/CheckMessagePinned?messageId=${messageId}`);
                const pinnedData = await pinnedResponse.json();

                if (pinnedData.success && pinnedData.isPinned) {
                    let confirmMessage = '';

                    if (pinnedData.pinType === 'global') {
                        confirmMessage = 'Это сообщение закреплено для всех участников. Сначала нужно его открепить. Хотите открепить сейчас?';
                    } else if (pinnedData.pinType === 'user') {
                        confirmMessage = 'Это сообщение закреплено в вашем личном чате. Сначала нужно его открепить. Хотите открепить сейчас?';
                    } else if (pinnedData.pinType === 'both') {
                        confirmMessage = 'Это сообщение закреплено для всех и в вашем личном чате. Сначала нужно его открепить. Хотите открепить сейчас?';
                    }

                    if (confirm(confirmMessage)) {
                        if (pinnedData.pinType === 'global' || pinnedData.pinType === 'both') {
                            await unpinMessage(currentChatId, true, event);
                        }
                        if (pinnedData.pinType === 'user' || pinnedData.pinType === 'both') {
                            await unpinMessage(currentChatId, false, event);
                        }
                        setTimeout(() => deleteMessage(messageId, event), 500);
                    }
                    return;
                }
            } catch (error) {
                console.error('Ошибка при проверке закрепления:', error);
            }

            if (!confirm('Вы уверены, что хотите удалить это сообщение?')) {
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/DeleteMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ messageId: messageId })
                });

                const data = await response.json();
                console.log('Результат удаления сообщения:', data);

                if (data.success) {
                    showNotification('Сообщение удалено', 'success');

                    // Удаляем сообщение из DOM
                    const messageElement = document.querySelector(`.message[data-message-id="${messageId}"]`);
                    if (messageElement) {
                        messageElement.remove();

                        // ОЧИЩАЕМ ПУСТЫЕ РАЗДЕЛИТЕЛИ ДАТ
                        cleanEmptyDateSeparators();

                        // Если после удаления не осталось сообщений, показываем заглушку
                        const messagesList = document.getElementById('messagesList');
                        if (messagesList && messagesList.children.length === 0) {
                            messagesList.innerHTML = `
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-comment-dots fa-3x mb-3"></i>
                                    <p>Здесь пока нет сообщений</p>
                                    <p class="small">Напишите что-нибудь, чтобы начать общение</p>
                                </div>
                            `;
                        }
                    }

                    // Обновляем закрепленные сообщения
                    await loadPinnedMessages(currentChatId);
                } else {
                    showNotification(data.message || 'Ошибка при удалении сообщения', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при удалении сообщения:', error);
                showNotification('Не удалось удалить сообщение: ' + error.message, 'danger');
            }
        }
