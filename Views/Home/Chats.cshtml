                            <a href="${file.fileUrl}" download="${fileName}" class="btn btn-sm btn-link text-muted p-0" title="Скачать" onclick="event.stopPropagation()">
                                <i class="fas fa-download"></i>
                            </a>
                        </div>
                    </div>
                `;
            }

            // Для файлов - горизонтальная карточка
            let fileIcon = 'fa-file';
            let fileColor = '';

            if (fileType.includes('pdf') || fileExt === 'pdf') {
                fileIcon = 'fa-file-pdf';
                fileColor = 'text-danger';
            } else if (fileType.includes('doc') || ['doc', 'docx'].includes(fileExt)) {
                fileIcon = 'fa-file-word';
