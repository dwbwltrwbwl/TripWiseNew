// Функция для обновления видимости пунктов меню в зависимости от типа чата и прав
function updateChatMenuVisibility(chatType, isAdmin) {
    const addMembersMenuItem = document.querySelector('.dropdown-item[onclick="addMembersToChat()"]');
    const renameMenuItem = document.querySelector('.dropdown-item[onclick="renameChat()"]');
    const avatarMenuItems = document.querySelectorAll('.dropdown-item[onclick*="ChatAvatar"]');
    const deleteChatMenuItem = document.querySelector('.dropdown-item[onclick="deleteChat()"]');
    
    // Для личных чатов скрываем админские пункты
    if (chatType === 'private') {
        if (addMembersMenuItem) addMembersMenuItem.style.display = 'none';
        if (renameMenuItem) renameMenuItem.style.display = 'none';
        avatarMenuItems.forEach(item => item.style.display = 'none');
        if (deleteChatMenuItem) deleteChatMenuItem.style.display = 'none';
    } else {
        // Для групповых чатов показываем в зависимости от прав
        if (addMembersMenuItem) addMembersMenuItem.style.display = isAdmin ? '' : 'none';
        if (renameMenuItem) renameMenuItem.style.display = isAdmin ? '' : 'none';
        avatarMenuItems.forEach(item => item.style.display = isAdmin ? '' : 'none');
        if (deleteChatMenuItem) deleteChatMenuItem.style.display = isAdmin ? '' : 'none';
    }
}
                async function removeMemberFromChat(chatId, userIdToRemove, userName) {
    if (!confirm(`Вы уверены, что хотите удалить пользователя "${userName}" из этого чата?`)) {
        return;
    }

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const response = await fetch('/Chats/RemoveMember', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                chatId: chatId,
                userIdToRemove: userIdToRemove
            })
        });

        const data = await response.json();

        if (data.success) {
            showNotification(`Пользователь "${userName}" удален из чата`, 'success');

            // Обновляем информацию о чате (вдруг изменился состав участников)
            await loadChatInfo(chatId);
            
            // Обновляем список чатов (обновится количество участников)
            await loadUserChats();
            
            // Если удалили участника из текущего открытого чата, обновляем модальное окно
            if (currentChatId === chatId) {
                // Обновляем список участников в модальном окне
                if (chatInfoModal && chatInfoModal._isShown) {
                    await showChatInfoModal();
                }
                
                // Проверяем, не стал ли текущий пользователь администратором
                // (если удалили всех других админов, а текущий остался)
                await checkAndUpdateAdminStatus(chatId);
            }
        } else {
            showNotification(data.message || 'Ошибка при удалении участника', 'danger');
        }
    } catch (error) {
        console.error('Ошибка при удалении участника:', error);
        showNotification('Не удалось удалить участника: ' + error.message, 'danger');
    }
}

