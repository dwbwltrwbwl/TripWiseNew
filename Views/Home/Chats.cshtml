@{
    ViewData["Title"] = "Чаты";
    var userId = Context.Session.GetInt32("UserId");
}
<div class="mobile-header-spacer d-block d-lg-none" style="height: 70px;"></div>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы с выделением -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-comments text-white"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Чаты
                    </h1>
                    <p class="page-subtitle">Общайтесь с попутчиками, планируйте совместные путешествия и находите новых друзей</p>
                </div>
            </div>

            @if (userId == null)
            {
                <div class="alert alert-info">
                    <h5>Войдите в аккаунт</h5>
                    <p>Чтобы использовать чаты и находить попутчиков, войдите в свой аккаунт.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Войти</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Зарегистрироваться</a>
                </div>
            }
            else
            {
                <!-- Основной контент чатов -->
                <div class="row">
                    <!-- Левая колонка: Список чатов и система друзей -->
                    <div class="col-md-4">
                        <!-- Карточка со списком чатов -->
                        <div class="card shadow-sm mb-4" style="height: 400px;">
                            <div class="card-header bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0" style="font-family: 'Nunito', sans-serif;">
                                        <i class="fas fa-comments me-2"></i>Мои чаты
                                    </h5>
                                    <button class="btn btn-sm btn-primary" onclick="openNewChatModal()">
                                        <i class="fas fa-plus me-1"></i>Новый
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-0" style="overflow-y: auto;">
                                <!-- Поиск по чатам -->
                                <div class="p-3 border-bottom">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Поиск по чатам..."
                                               id="chatSearch"
                                               onkeyup="filterChats()">
                                    </div>
                                </div>

                                <!-- Список чатов - загружается динамически -->
                                <div id="chatsList" class="list-group list-group-flush">
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Загрузка...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Вкладки для друзей и запросов -->
                        <ul class="nav nav-tabs mb-3" id="friendsTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="friends-tab" data-bs-toggle="tab" data-bs-target="#friends" type="button" role="tab">
                                    <i class="fas fa-user-friends me-1"></i>Мои друзья
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="requests-tab" data-bs-toggle="tab" data-bs-target="#requests" type="button" role="tab">
                                    <i class="fas fa-user-clock me-1"></i>Запросы
                                    <span id="friendRequestsBadge" class="badge bg-danger ms-1" style="display: none;">0</span>
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="friendsTabContent">
                            <!-- Вкладка "Мои друзья" -->
                            <div class="tab-pane fade show active" id="friends" role="tabpanel">
                                <div class="card shadow-sm" style="height: 300px;">
                                    <div class="card-body p-0" style="overflow-y: auto;">
                                        <div id="friendsList" class="list-group list-group-flush">
                                            <div class="text-center p-3">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Загрузка...</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Вкладка "Запросы в друзья" -->
                            <div class="tab-pane fade" id="requests" role="tabpanel">
                                <div class="card shadow-sm" style="height: 300px;">
                                    <div class="card-body p-0" style="overflow-y: auto;">
                                        <div id="friendRequests" class="list-group list-group-flush">
                                            <div class="text-center p-3">
                                                <div class="spinner-border text-warning" role="status">
                                                    <span class="visually-hidden">Загрузка...</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Поиск пользователей -->
                        <div class="card shadow-sm mt-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0" style="font-family: 'Nunito', sans-serif;">
                                    <i class="fas fa-search me-2"></i>Поиск пользователей
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <input type="text"
                                           class="form-control"
                                           id="searchUsersInput"
                                           placeholder="Введите имя или email..."
                                           autocomplete="off">
                                </div>
                                <div id="searchResults" style="max-height: 200px; overflow-y: auto;">
                                    <div class="text-center text-muted py-3">
                                        <i class="fas fa-user-plus fa-2x mb-2"></i>
                                        <p class="small">Начните вводить имя для поиска</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Правая колонка: Окно чата -->
                    <div class="col-md-8">
                        <!-- Контейнер чата (скрыт по умолчанию) -->
                        <div class="card shadow-sm" style="height: 700px; display: none;" id="chatContainer">
                            <!-- Шапка чата -->
                            <div class="card-header bg-light" id="chatHeader">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center" id="chatInfo">
                                        <!-- Информация о чате загружается динамически -->
                                        <div class="chat-avatar me-3">
                                            <div class="avatar-circle bg-primary" id="chatAvatar">
                                                <i class="fas fa-users"></i>
                                            </div>
                                        </div>
                                        <div style="min-width: 0; max-width: 300px;">
                                            <h5 class="mb-0" id="chatTitle" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Выберите чат</h5>
                                            <small class="text-muted" id="chatMembers" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;"></small>
                                        </div>
                                    </div>
                                    <div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
        <i class="fas fa-ellipsis-v"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="#" onclick="showChatInfoModal()"><i class="fas fa-info-circle me-2"></i>Информация</a></li>
        <li><a class="dropdown-item admin-only" href="#" onclick="renameChat()"><i class="fas fa-edit me-2"></i>Переименовать</a></li>
        <li><a class="dropdown-item admin-only" href="#" onclick="changeChatAvatar()"><i class="fas fa-camera me-2"></i>Изменить аватар</a></li>
        <li><a class="dropdown-item admin-only" href="#" onclick="deleteChatAvatar()"><i class="fas fa-trash-alt me-2"></i>Удалить аватар</a></li>
        <li><a class="dropdown-item admin-only" href="#" onclick="addMembersToChat()" id="addMembersMenuItem"><i class="fas fa-user-plus me-2"></i>Добавить участников</a></li>
        <li><hr class="dropdown-divider admin-only"></li>
        <li><a class="dropdown-item admin-only text-danger" href="#" onclick="deleteChat()"><i class="fas fa-trash me-2"></i>Удалить чат</a></li>
        <li><a class="dropdown-item text-danger" href="#" onclick="leaveChat()"><i class="fas fa-sign-out-alt me-2"></i>Покинуть чат</a></li>
    </ul>
</div>
                                </div>
                            </div>

                            <!-- Область сообщений -->
                            <div class="card-body p-0" style="overflow-y: auto; height: 550px; background-color: #f8f9fa;" id="messagesArea">
                                <div class="p-3" id="messagesList">
                                    <!-- Сообщения загружаются динамически -->
                                    <div class="text-center text-muted py-5">
                                        <i class="fas fa-comments fa-3x mb-3"></i>
                                        <p>Выберите чат для просмотра сообщений</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Поле ввода сообщения -->
                            <div class="card-footer" id="messageInputContainer" style="display: none;">
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary" type="button" onclick="attachFile()">
                                        <i class="fas fa-paperclip"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" type="button" onclick="showCreateVoteModal()">
                                        <i class="fas fa-poll"></i>
                                    </button>
                                    <input type="text"
       class="form-control"
       placeholder="Введите сообщение..."
       id="messageInput"
       maxlength="1000"
       onkeypress="handleMessageKeyPress(event)"
       style="flex: 1 1 auto; min-width: 0;">
                                    <button class="btn btn-primary" type="button" onclick="sendMessage()">
                                        <i class="fas fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Заглушка, когда чат не выбран (показана по умолчанию) -->
                        <div class="card shadow-sm d-flex align-items-center justify-content-center"
                             style="height: 700px; background-color: #f8f9fa;"
                             id="noChatSelected">
                            <div class="text-center">
                                <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">Чат не выбран</h4>
                                <p class="text-muted">Выберите чат из списка слева или создайте новый</p>
                                <button class="btn btn-primary" onclick="openNewChatModal()">
                                    <i class="fas fa-plus me-2"></i>Новый чат
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно создания нового чата -->
<div class="modal fade" id="newChatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-users me-2 text-primary"></i>Создать новый чат
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        <i class="fas fa-user-plus me-1 text-primary"></i>Выберите участников
                    </label>
                    <div class="mb-2">
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text"
                                   class="form-control"
                                   id="newChatUserSearch"
                                   placeholder="Поиск по имени или email..."
                                   onkeyup="searchUsersForChat()">
                        </div>
                        <div class="mt-1">
                            <small class="text-primary">
                                <i class="fas fa-user-friends me-1"></i>
                                <strong>Внимание:</strong> Добавлять можно только друзей
                            </small>
                        </div>
                    </div>
                    <div id="userSearchResults" class="mt-2" style="max-height: 200px; overflow-y: auto;">
                        <!-- Результаты поиска пользователей -->
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-search fa-2x mb-2"></i>
                            <p class="small">Введите имя друга для поиска</p>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        <i class="fas fa-check-circle me-1 text-success"></i>Выбранные участники
                    </label>
                    <div id="selectedUsersList" class="d-flex flex-wrap gap-2 p-3 border rounded bg-light min-height-50" style="min-height: 60px;">
                        <span class="text-muted">Никто не выбран</span>
                    </div>
                    <small class="text-muted">Выберите из списка выше</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        <i class="fas fa-tag me-1 text-secondary"></i>Название чата (необязательно)
                    </label>
                    <input type="text"
                           class="form-control"
                           id="newChatName"
                           maxlength="200"
                           placeholder="Будет создано автоматически из имен участников">
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">Максимум 200 символов</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Отмена
                </button>
                <button type="button" class="btn btn-primary" onclick="createNewChat()" id="createChatBtn">
                    <i class="fas fa-plus me-1"></i>Создать чат
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно добавления участников -->
<div class="modal fade" id="addMembersModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить участников</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="addMembersChatId">
                <div class="mb-3">
                    <label class="form-label">Поиск друзей</label>
                    <input type="text"
                           class="form-control"
                           id="addMembersSearch"
                           placeholder="Введите имя или email друга..."
                           onkeyup="searchUsersToAdd()">
                    <small class="text-muted text-primary">
                        <i class="fas fa-user-friends me-1"></i>Добавлять можно только друзей
                    </small>
                </div>
                <div id="addMembersResults" class="mt-3" style="max-height: 300px; overflow-y: auto;">
                    <!-- Результаты поиска -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для требований авторизации (оставляем для совместимости) -->
<div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-primary">
                    <i class="fas fa-lock me-2"></i>Требуется авторизация
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-comments text-primary mb-3" style="font-size: 3rem;"></i>
                <h4 class="mb-3">Войдите в аккаунт</h4>
                <p class="text-muted mb-4">
                    Для использования чатов и общения с друзьями необходимо авторизоваться.
                </p>
                <div class="d-grid gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                        <i class="fas fa-sign-in-alt me-2"></i>Войти
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-user-plus me-2"></i>Зарегистрироваться
                    </a>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <small class="text-muted">После авторизации вы сможете общаться с друзьями</small>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно информации о чате -->
<div class="modal fade" id="chatInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-info-circle text-primary me-2"></i>
                    Информация о чате
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="chatInfoContent">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно создания голосования -->
<div class="modal fade" id="createVoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-poll text-primary me-2"></i>
                    Создать голосование
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Вопрос <small class="text-muted">максимум 50 символов</small>
                    </label>
                    <input type="text"
                           class="form-control"
                           id="voteQuestion"
                           placeholder="Куда поедем?"
                           maxlength="50">
                    <div class="text-end mt-1">
                        <small class="text-muted" id="voteQuestionCounter">0 / 50</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold d-flex flex-wrap justify-content-between align-items-center">
                        <span>Варианты ответов</span>
                        <span>
                            <small class="text-muted" id="voteOptionsCounter">2 / 10</small>
                            <small class="text-muted ms-2">макс. 50 симв.</small>
                        </span>
                    </label>
                    <div id="voteOptionsContainer" style="width: 100%;">
                        <div class="vote-option-input mb-2">
    <div class="input-group">
        <input type="text" 
               class="form-control" 
               placeholder="Вариант ответа" 
               required
               maxlength="50">
        <button class="btn btn-outline-danger" type="button" onclick="removeVoteOption(this)">
            <i class="fas fa-times"></i>
        </button>
    </div>
</div>
                        <div class="vote-option-input mb-2">
                            <div class="input-group">
                                <input type="text" 
                                       class="form-control" 
                                       placeholder="Вариант ответа" 
                                       required
                                       maxlength="50">
                                <button class="btn btn-outline-danger" type="button" onclick="removeVoteOption(this)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary mt-2 w-100 w-sm-auto" onclick="addVoteOption()" style="width: auto;">
                        <i class="fas fa-plus me-1"></i>Добавить вариант
                    </button>
                    <small class="text-muted d-block mt-1">Максимум 10 вариантов</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Дата окончания (необязательно)</label>
                    <input type="datetime-local" class="form-control" id="voteExpiresAt">
                    <small class="text-muted">Оставьте пустым для бессрочного голосования</small>
                </div>
            </div>
            <div class="modal-footer border-0 d-flex flex-column flex-sm-row gap-2">
                <button type="button" class="btn btn-outline-secondary order-sm-1" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Отмена
                </button>
                <button type="button" class="btn btn-primary order-sm-2" onclick="createVote()">
                    <i class="fas fa-check me-2"></i>Создать голосование
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Стили для чатов - полная мобильная адаптация */
.chat-item {
    cursor: pointer;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
    padding: 12px 15px;
}

.chat-item:hover {
    background-color: #f8f9fa;
    border-left-color: #dee2e6;
}

.chat-item.active {
    background-color: #e7f1ff;
    border-left-color: #0379D9;
}

.chat-avatar .avatar-circle {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 18px;
}

.avatar-circle-sm {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    font-weight: 500;
}

.truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
}

/* Стили для сообщений */
.message {
    margin-bottom: 15px;
    display: flex;
}

.message.message-outgoing {
    justify-content: flex-end;
}

.message.message-incoming {
    justify-content: flex-start;
}

.message-content {
    max-width: 70%;
    padding: 10px 15px;
    border-radius: 15px;
    position: relative;
    word-break: break-word;
}

.message-outgoing .message-content {
    background-color: #0379D9;
    color: white;
    border-bottom-right-radius: 5px;
}

.message-incoming .message-content {
    background-color: white;
    color: #333;
    border-bottom-left-radius: 5px;
    border: 1px solid #e9ecef;
}

.message-sender {
    font-weight: 600;
    font-size: 0.85em;
    margin-bottom: 3px;
    color: #666;
}

.message-incoming .message-sender {
    color: #0379D9;
}

.message-text {
    margin-bottom: 5px;
}

.message-time {
    font-size: 0.75em;
    opacity: 0.7;
    text-align: right;
}

.message-outgoing .message-time {
    color: rgba(255, 255, 255, 0.8);
}

/* Стили для системы друзей */
.friend-item, .request-item, .search-result-item {
    padding: 12px 15px;
    border-bottom: 1px solid #e9ecef;
    transition: all 0.2s ease;
}

.friend-item:hover, .request-item:hover, .search-result-item:hover {
    background-color: #f8f9fa;
}

.friend-item:last-child, .request-item:last-child, .search-result-item:last-child {
    border-bottom: none;
}

.friend-avatar, .request-avatar {
    flex-shrink: 0;
}

.friend-action-buttons {
    display: flex;
    gap: 5px;
}

.friend-status-accepted {
    border-left: 3px solid #28a745;
}

.friend-status-pending-sent {
    border-left: 3px solid #ffc107;
}

.friend-status-pending-received {
    border-left: 3px solid #17a2b8;
}

.add-user-btn {
    margin-left: auto;
}

.selected-user-tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    background-color: #e7f1ff;
    border-radius: 20px;
    font-size: 0.9em;
}

.selected-user-tag .btn-close {
    margin-left: 8px;
    font-size: 0.7em;
}

.min-height-50 {
    min-height: 50px;
}

/* Уведомления */
.friends-notification {
    animation: slideIn 0.3s ease-out;
}

@@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* Анимация для сообщений */
.message {
    animation: messageAppear 0.3s ease;
}

@@keyframes messageAppear {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Стили для даты разделителя */
.date-separator {
    position: relative;
    text-align: center;
    margin: 20px 0;
}

.date-separator span {
    background-color: #e9ecef;
    padding: 5px 15px;
    border-radius: 20px;
    font-size: 0.85em;
    color: #6c757d;
}

/* Стили для вложений */
.attachment-container {
    max-width: 100%;
}

.attachment-actions {
    display: flex;
    gap: 5px;
}

.attachment-actions .btn {
    padding: 2px 8px;
    font-size: 0.8rem;
}

.image-preview {
    display: block;
    position: relative;
}

.image-preview:hover::after {
    content: '👁️';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 2rem;
    background: rgba(0,0,0,0.5);
    color: white;
    padding: 10px;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.file-attachment {
    color: #333;
    transition: all 0.2s ease;
    border: 1px solid #dee2e6;
}

.file-attachment:hover {
    background-color: #e9ecef !important;
    text-decoration: none;
    color: #0379D9;
}

/* Иконки для разных типов файлов */
.fa-file-pdf { color: #dc3545; }
.fa-file-word { color: #0d6efd; }
.fa-file-excel { color: #198754; }
.fa-file-image { color: #6f42c1; }
.fa-file-archive { color: #fd7e14; }
.fa-file-alt { color: #6c757d; }

/* Стили для нескольких файлов */
.selected-files-indicator {
    animation: slideIn 0.3s ease-out;
    border: 1px solid #dee2e6;
    border-radius: 5px;
}

.file-list {
    max-height: 200px;
    overflow-y: auto;
}

.file-list div:last-child {
    border-bottom: none !important;
}

.message-attachments {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.message-attachments .attachment-container {
    margin-bottom: 5px;
}

/* Стили для меню сообщения */
/* Стили для меню сообщения - всегда видимое */
.message-content .dropdown {
    /* Убираем opacity: 0 */
    opacity: 1;
}

/* Для исходящих сообщений - точки всегда белые */
.message-outgoing .dropdown-toggle,
.message-outgoing .dropdown-toggle i {
    color: white !important;
}

/* Для входящих сообщений - точки темные (серые) */
.message-incoming .dropdown-toggle,
.message-incoming .dropdown-toggle i {
    color: #6c757d !important;
}

/* При наведении можно сделать немного ярче */
.message-outgoing .dropdown-toggle:hover i {
    color: rgba(255, 255, 255, 0.8) !important;
}

.message-incoming .dropdown-toggle:hover i {
    color: #0379D9 !important;
}

.message-content:hover .dropdown {
    opacity: 1;
}

.dropdown-item.text-danger:hover {
    background-color: #dc3545;
    color: white !important;
}

.dropdown-item.text-danger:hover i {
    color: white !important;
}

.dropdown-menu {
    min-width: 120px;
    font-size: 0.9rem;
}

/* Стили для закрепленных сообщений */
.pinned-message-container {
    animation: slideDown 0.3s ease-out;
    border-left: 3px solid;
}

.pinned-message-container.global-pin {
    border-left-color: #0379D9;
}

.pinned-message-container.user-pin {
    border-left-color: #28a745;
}

.pinned-message-container:not(:last-child) {
    border-bottom: 1px solid #dee2e6 !important;
}

@@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.pinned-message-container .fa-thumbtack {
    font-size: 1.1rem;
}

.pinned-message-container {
    background-color: #f8f9fa;
    padding: 8px 12px;
    transition: background-color 0.2s ease;
    cursor: pointer;
}

.pinned-message-container:hover {
    background-color: #e9ecef !important;
}

/* Стиль для подсветки сообщения при переходе */
.message.highlight {
    animation: highlightPulse 2s ease;
}

@@keyframes highlightPulse {
    0% { background-color: rgba(3, 121, 217, 0.2); }
    50% { background-color: rgba(3, 121, 217, 0.1); }
    100% { background-color: transparent; }
}

/* Стили для модального окна информации о чате */
#chatInfoModal .modal-body {
    padding: 1.5rem;
}

#chatInfoModal .chat-info h4 {
    font-weight: 700;
    color: #1e293b;
}

#chatInfoModal .avatar-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0379D9, #40B624);
    border-radius: 50%;
    color: white;
}

#chatInfoModal .members-list {
    background-color: #f8f9fa;
    border-radius: 8px;
    padding: 0.5rem;
}

#chatInfoModal .members-list .d-flex {
    padding: 8px 12px;
    border-radius: 6px;
    transition: background-color 0.2s ease;
}

#chatInfoModal .members-list .d-flex:hover {
    background-color: #e9ecef;
}

#chatInfoModal table {
    margin-bottom: 0;
}

#chatInfoModal table td {
    padding: 0.5rem 0;
    border: none;
}

#chatInfoModal hr {
    margin: 1rem 0;
    border-color: #e9ecef;
}

/* Стили для голосований */
.vote-message {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 12px;
    margin: 4px 0;
    border-left: 4px solid #0379D9;
    display: block !important;
}

.vote-question {
    font-weight: 700;
    margin-bottom: 12px;
    font-size: 1rem;
    color: #1e293b;
}

.vote-option {
    padding: 8px 12px;
    margin: 4px 0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    background: white;
    border: 1px solid #e9ecef;
}

.vote-option:hover:not(.disabled) {
    border-color: #0379D9;
    background: #f0f7ff;
    transform: translateX(2px);
}

.vote-option.selected {
    border-color: #28a745;
    background: #e8f5e9;
}

.vote-option.disabled {
    cursor: default;
    opacity: 0.8;
}

.vote-option .option-text {
    font-weight: 500;
    margin-bottom: 4px;
    font-size: 0.95rem;
}

.vote-option .progress {
    height: 6px;
    margin: 6px 0;
    background-color: #e9ecef;
    border-radius: 3px;
    overflow: hidden;
}

.vote-option .progress-bar {
    border-radius: 3px;
    transition: width 0.3s ease;
}

.vote-option .vote-count {
    font-size: 0.75rem;
    color: #6c757d;
}

.vote-expired {
    font-size: 0.75rem;
    color: #dc3545;
}

.vote-total {
    font-size: 0.75rem;
    color: #6c757d;
    margin-top: 8px;
    text-align: right;
}

/* Модальное окно создания голосования */
#voteOptionsContainer {
    max-height: 300px;
    overflow-y: auto;
}

.vote-option-input {
    width: 100%;
}

.vote-option-input .input-group {
    display: flex;
    flex-wrap: nowrap;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
}

.vote-option-input .form-control {
    flex: 1 1 auto;
    width: 1%;
    min-width: 0;
    border-radius: 8px 0 0 8px !important;
}

.vote-option-input .btn-outline-danger {
    flex: 0 0 auto;
    border-radius: 0 8px 8px 0 !important;
    margin: 0 !important;
    padding: 8px 16px;
}

/* Убираем конфликтующие стили */
.vote-option-input .btn-outline-danger {
    margin-left: 0 !important;
    position: static !important;
}

/* Стили для галереи вложений */
.message-attachments {
    margin-top: 8px;
    margin-bottom: 4px;
}

.attachments-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
}

.attachment-item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #f0f2f5;
    transition: all 0.2s ease;
}

.attachment-item.image-item {
    width: 180px;
    height: 180px;
}

.attachment-item.file-item {
    width: auto;
    min-width: 200px;
    max-width: 260px;
}

.attachment-preview {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
    overflow: hidden;
}

.attachment-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
}

.attachment-preview:hover img {
    transform: scale(1.05);
}

.attachment-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
    color: white;
}

.attachment-preview:hover .attachment-overlay {
    opacity: 1;
}

.attachment-overlay i {
    font-size: 24px;
}

.file-preview {
    display: flex;
    align-items: center;
    padding: 12px;
    background: #f0f2f5;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease;
}

.file-preview:hover {
    background: #e4e6e9;
    text-decoration: none;
    color: inherit;
}

.file-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 8px;
    margin-right: 12px;
}

.file-icon i {
    font-size: 20px;
}

.file-info {
    flex: 1;
    min-width: 0;
}

.file-name {
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-size {
    font-size: 0.7rem;
    color: #6c757d;
}

.file-download {
    margin-left: 8px;
    opacity: 0.6;
    transition: opacity 0.2s ease;
}

.file-preview:hover .file-download {
    opacity: 1;
}

.attachment-count-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    border-radius: 20px;
    padding: 4px 8px;
    font-size: 0.7rem;
    font-weight: 500;
    backdrop-filter: blur(4px);
}

.attachment-item {
    animation: attachmentAppear 0.2s ease-out;
}

@@keyframes attachmentAppear {
    from {
        opacity: 0;
        transform: scale(0.9);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* Стили для заголовка страницы */
.page-header-section {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 25px 30px;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    margin-bottom: 30px;
    position: relative;
    overflow: hidden;
}

.page-header-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: linear-gradient(to bottom, #0379D9, #40B624);
}

.page-header-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #0379D9, #40B624);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 2rem;
    box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
    flex-shrink: 0;
}

.page-title {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 2.5rem;
    color: #0379D9;
    margin: 0 0 8px 0;
    line-height: 1.2;
}

.page-subtitle {
    color: #64748b;
    font-size: 1.1rem;
    margin: 0;
    max-width: 600px;
}

/* Стили для голосований в исходящих сообщениях */
.message-outgoing .vote-message {
    background: rgba(3, 121, 217, 0.1);
    border-left-color: #0379D9;
}

.message-outgoing .vote-option {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.3);
}

.message-outgoing .vote-option .option-text {
    color: #333;
}

.message-outgoing .vote-option .vote-count {
    color: #666;
}

.message-outgoing .vote-total {
    color: rgba(255, 255, 255, 0.7);
}

.message-outgoing .vote-option.selected {
    background: rgba(40, 167, 69, 0.2);
    border-color: #28a745;
}

/* Стили для голосований во входящих сообщениях */
.message-incoming .vote-message {
    background: #f8f9fa;
    border-left-color: #40B624;
}

.message-incoming .vote-option {
    background: white;
    border-color: #e9ecef;
}

.message-incoming .vote-option .option-text {
    color: #333;
}

.message-incoming .vote-option .vote-count {
    color: #6c757d;
}

.message-incoming .vote-option.selected {
    background: #e8f5e9;
    border-color: #28a745;
}

.vote-option .progress-bar {
    background-color: #0379D9;
}

/* Стили для модального окна деталей голосования */
#voteDetailsModal .voters-list {
    max-height: 300px;
    overflow-y: auto;
}

#voteDetailsModal .list-group-item {
    border-left: none;
    border-right: none;
}

#voteDetailsModal .list-group-item:first-child {
    border-top: none;
}

#voteDetailsModal .list-group-item:last-child {
    border-bottom: none;
}

/* ==================== МОБИЛЬНАЯ АДАПТАЦИЯ ==================== */

/* Планшеты (768px - 991px) */
@@media (max-width: 991px) {
    .container {
        padding-left: 20px;
        padding-right: 20px;
    }
    
    .chat-avatar .avatar-circle {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }
    
    .chat-item {
        padding: 10px 12px;
    }
    
    .chat-item h6 {
        font-size: 0.95rem;
        max-width: 120px !important;
    }
    
    .chat-item .small.text-muted {
        font-size: 0.7rem;
    }
    
    .message-content {
        max-width: 75%;
        font-size: 0.95rem;
    }
}

/* Мобильные устройства (576px - 767px) */
@@media (max-width: 767px) {
    .container {
        padding-left: 15px;
        padding-right: 15px;
    }
    
    /* Заголовок страницы - сохраняем горизонтальное расположение как на десктопе */
    .page-header-section {
        flex-direction: row;
        text-align: left;
        padding: 20px;
        gap: 15px;
    }
    
    .page-header-section::before {
        width: 6px;
        height: 100%;
        top: 0;
        left: 0;
        background: linear-gradient(to bottom, #0379D9, #40B624);
    }
    
    .page-header-icon {
        width: 55px;
        height: 55px;
        font-size: 1.5rem;
    }
    
    .page-title {
        font-size: 1.6rem;
        margin-bottom: 4px;
    }
    
    .page-subtitle {
        font-size: 0.85rem;
    }
    
    /* Кнопки действий */
    .btn {
        font-size: 0.85rem;
        padding: 8px 12px;
    }
    
    /* Последовательность окон: чаты, окно чата, друзья, поиск */
    .row {
        display: flex;
        flex-direction: column;
    }
    
    /* 1. Мои чаты - сверху */
    .row > .col-md-4:first-child {
        order: 1;
        margin-bottom: 20px;
    }
    
    /* 2. Окно чата - под чатами */
    .row > .col-md-8 {
        order: 2;
        margin-bottom: 20px;
    }
    
    /* Левая колонка - перестраиваем внутренний порядок */
    .col-md-4 {
        display: flex;
        flex-direction: column;
    }
    
    /* Карточка чатов - первая */
    .col-md-4 .card:first-child {
        order: 1;
        margin-bottom: 20px;
        height: auto !important;
        min-height: 350px;
        max-height: 400px;
    }
    
    /* Вкладки друзей - вторая */
    .col-md-4 .nav-tabs {
        order: 2;
        margin-bottom: 15px;
    }
    
    /* Контент вкладок - третий */
    .col-md-4 .tab-content {
        order: 3;
        margin-bottom: 20px;
    }
    
    /* Поиск пользователей - четвертый */
    .col-md-4 .card:last-child {
        order: 4;
        margin-bottom: 0;
    }
    
    /* Список чатов */
    .chat-item {
        padding: 10px;
    }
    
    .chat-item .chat-avatar {
        margin-right: 10px !important;
    }
    
    .chat-item .chat-avatar .avatar-circle {
        width: 36px;
        height: 36px;
        font-size: 14px;
    }
    
    .chat-item h6 {
        font-size: 0.85rem;
        max-width: 100px !important;
    }
    
    .chat-item .small.text-muted {
        font-size: 0.65rem;
    }
    
    .chat-item p.small {
        font-size: 0.7rem;
        max-width: 130px !important;
    }
    
    .chat-item .badge {
        font-size: 0.65rem;
        padding: 2px 6px;
    }
    
    /* Правая колонка - чат */
    .col-md-8 .card {
        height: 550px !important;
    }
    
    /* Шапка чата */
    #chatHeader .d-flex {
        flex-wrap: wrap;
        gap: 10px;
    }
    
    #chatInfo {
        flex: 1;
        min-width: 0;
    }
    
    #chatInfo .chat-avatar {
        margin-right: 10px !important;
    }
    
    #chatInfo .chat-avatar .avatar-circle {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }
    
    #chatTitle {
        font-size: 1rem;
        max-width: 180px !important;
    }
    
    #chatMembers {
        font-size: 0.7rem;
    }
    
    /* Область сообщений */
    #messagesArea {
        height: 400px !important;
    }
    
    /* Сообщения */
    .message-content {
        max-width: 85%;
        padding: 8px 12px;
        font-size: 0.85rem;
    }
    
    .message-sender {
        font-size: 0.7rem;
    }
    
    .message-time {
        font-size: 0.65rem;
    }
    
    /* Дата разделитель */
    .date-separator span {
        font-size: 0.7rem;
        padding: 3px 10px;
    }
    
    /* Поле ввода сообщения - РАСТЯГИВАЕМ */
    .card-footer {
        padding: 10px;
    }
    
    .input-group {
        flex-wrap: nowrap;
        width: 100%;
    }
    
    .input-group button {
        padding: 10px 12px;
        flex-shrink: 0;
    }
    
    .input-group button i {
        font-size: 1rem;
    }
    
    #messageInput {
        font-size: 1rem;
        padding: 10px 12px;
        width: 100%;
        min-width: 0;
    }
    
    /* Убираем скролл Telegram стиля для поля ввода */
    #messageInput::-webkit-scrollbar {
        display: none;
    }
    
    /* Вкладки друзей */
    .nav-tabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    
    .nav-tabs .nav-link {
        padding: 8px 12px;
        font-size: 0.8rem;
        white-space: nowrap;
    }
    
    .nav-tabs .nav-link i {
        margin-right: 4px;
    }
    
    /* Карточки друзей и запросов */
    .friend-item, .request-item {
        padding: 10px;
