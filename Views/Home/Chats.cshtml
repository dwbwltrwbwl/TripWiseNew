                function cleanEmptyDateSeparators() {
            const messagesList = document.getElementById('messagesList');
            if (!messagesList) return;

            // Находим все разделители дат
            const dateSeparators = messagesList.querySelectorAll('.date-separator');

            dateSeparators.forEach(separator => {
                // Проверяем, есть ли сообщения между этим разделителем и следующим
                let hasMessages = false;
                let nextElement = separator.nextElementSibling;

                while (nextElement && !nextElement.classList.contains('date-separator')) {
                    if (nextElement.classList.contains('message')) {
                        hasMessages = true;
                        break;
                    }
                    nextElement = nextElement.nextElementSibling;
                }

                // Если нет сообщений после этого разделителя, удаляем его
                if (!hasMessages) {
                    separator.remove();
                }
            });

            // Также удаляем первый разделитель, если после него нет сообщений
            const firstSeparator = messagesList.querySelector('.date-separator');
            if (firstSeparator) {
                let hasMessagesAfter = false;
                let next = firstSeparator.nextElementSibling;
                while (next) {
                    if (next.classList.contains('message')) {
                        hasMessagesAfter = true;
                        break;
                    }
                    next = next.nextElementSibling;
                }
                if (!hasMessagesAfter) {
                    firstSeparator.remove();
                }
            }
        }
                // Отправить голос
        async function submitVote(voteId, optionId) {
