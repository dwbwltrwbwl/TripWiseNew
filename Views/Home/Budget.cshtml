                                // Отображение расходов
        function renderExpenses(expenses) {
            const container = document.getElementById('expensesContainer');

            if (!expenses || expenses.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Нет расходов</p>
                        <p class="small">Добавьте первый расход, используя форму справа</p>
                    </div>
                `;
                return;
            }

            let html = '';
            expenses.forEach(exp => {
                const date = new Date(exp.expenseDate);
                const formattedDate = date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short', year: 'numeric' });

                // Обрезаем длинное имя плательщика (максимум 20 символов)
                let paidByName = exp.paidByName || 'Пользователь';
                const truncatedPaidByName = paidByName.length > 20 ? paidByName.substring(0, 18) + '...' : paidByName;

                // Обрезаем длинное название поездки
                let tripName = exp.tripName || 'Поездка';
                const truncatedTripName = tripName.length > 25 ? tripName.substring(0, 23) + '...' : tripName;

                // ========== ПРОВЕРКА НА "ЗАКРЫТЫЙ" РАСХОД ==========
                let isReadOnly = false;

                // 1. Используем поле isDebtPayment из данных
                const isDebtPayment = exp.isDebtPayment === true ||
                                      (exp.title && exp.title.startsWith('💰') && exp.categoryName === 'Другое');

                // 2. Проверяем, все ли доли оплачены
                let isFullyPaid = false;
                if (exp.shares && exp.shares.length > 0) {
                    const participantsWhoOwe = exp.shares.filter(s => s.userId !== exp.paidById && s.amount > 0.01);
                    if (participantsWhoOwe.length > 0) {
                        const allPaid = participantsWhoOwe.every(s => s.isPaid === true);
                        if (allPaid) {
                            isFullyPaid = true;
                        }
                    }
                }

                if (isDebtPayment || isFullyPaid) {
                    isReadOnly = true;
                }

                html += `
                    <div class="expense-item d-flex justify-content-between align-items-center border-bottom">
                        <div class="expense-main d-flex justify-content-between align-items-center flex-grow-1" onclick="showExpenseDetails(${exp.id})">
