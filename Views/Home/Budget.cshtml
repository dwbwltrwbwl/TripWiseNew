</style>
@section Scripts {
    <script>
        let currentUserId = @Json.Serialize(userId);
        let budgetData = null;
        let selectedTripId = 'all';
        let currentExpenseSort = 'date_desc';
        let currentExpenseCategoryFilter = 'all';
        let editCategoryModal = null;

        // Переменные для блокировки повторных нажатий
        let isProcessingDebt = false;
        let processingDebts = new Set();

        document.addEventListener('DOMContentLoaded', function() {
            console.log('Budget page loaded');
            if (currentUserId) {
                loadBudgetData();
                loadTripsForSelect();
                loadExpenseFilterCategories();
            }

            // Исправление смещения при открытии модального окна
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                modal.addEventListener('show.bs.modal', function() {
                    const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
                    if (scrollbarWidth > 0) {
                        document.body.style.paddingRight = scrollbarWidth + 'px';
                    }
                    document.body.style.overflow = 'hidden';
                });

                modal.addEventListener('hidden.bs.modal', function() {
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                });
            });

            // Обработчики сортировки и фильтрации расходов
            const expenseSortOrder = document.getElementById('expenseSortOrder');
            if (expenseSortOrder) {
                expenseSortOrder.addEventListener('change', function(e) {
                    currentExpenseSort = e.target.value;
                    renderBudgetData();
                });
            }

            const expenseCategoryFilter = document.getElementById('expenseCategoryFilter');
            if (expenseCategoryFilter) {
                expenseCategoryFilter.addEventListener('change', function(e) {
                    currentExpenseCategoryFilter = e.target.value;
                    renderBudgetData();
                });
            }
                    const expenseTrip = document.getElementById('expenseTrip');
        if (expenseTrip) {
            expenseTrip.addEventListener('change', function(e) {
                if (e.target.value) {
                    loadTripParticipants(e.target.value);
                    loadTripDateRange(e.target.value);
                    loadCategoriesForSelect(); // ПЕРЕЗАГРУЖАЕМ КАТЕГОРИИ ПРИ СМЕНЕ ПОЕЗДКИ
                } else {
                    document.getElementById('participantsContainer').innerHTML = '<div class="text-muted text-center py-2">Сначала выберите поездку</div>';
                }
            });
        }
            // Валидация полей
            const expenseTitle = document.getElementById('expenseTitle');
            if (expenseTitle) {
                expenseTitle.addEventListener('input', function() {
                    const maxLength = 50;
                    let value = this.value;
                    const counter = document.getElementById('titleCounter');
                    if (value.length > maxLength) {
                        this.value = value.substring(0, maxLength);
                        showNotification('Описание не может превышать 50 символов', 'warning');
                    }
                    if (counter) {
                        counter.textContent = `${this.value.length}/50`;
                    }
                });
            }

            const editExpenseTitle = document.getElementById('editExpenseTitle');
            if (editExpenseTitle) {
                editExpenseTitle.addEventListener('input', function() {
                    const maxLength = 50;
                    let value = this.value;
                    const counter = document.getElementById('editTitleCounter');
                    if (value.length > maxLength) {
                        this.value = value.substring(0, maxLength);
                        showNotification('Описание не может превышать 50 символов', 'warning');
                    }
                    if (counter) {
                        counter.textContent = `${this.value.length}/50`;
                    }
                });
            }

                    const expenseAmount = document.getElementById('expenseAmount');
        if (expenseAmount) {
            expenseAmount.addEventListener('input', function() {
                validateExpenseAmount(this);

                // Если включено неравное распределение - обновляем общую сумму
                const unequalCheckbox = document.getElementById('unequalSplitCheckbox');
                if (unequalCheckbox && unequalCheckbox.checked) {
                    const totalAmount = parseFloat(this.value) || 0;
                    updateSharesTotal(totalAmount);
                }
            });
        }

            const editExpenseAmount = document.getElementById('editExpenseAmount');
            if (editExpenseAmount) {
                editExpenseAmount.addEventListener('input', function() {
                    validateExpenseAmount(this);
                });
            }

            const categoryName = document.getElementById('categoryName');
            if (categoryName) {
                categoryName.addEventListener('input', function() {
                    const maxLength = 50;
                    let value = this.value;
                    const counter = document.getElementById('categoryNameCounter');
                    if (value.length > maxLength) {
                        this.value = value.substring(0, maxLength);
                        showNotification('Название категории не может превышать 50 символов', 'warning');
                    }
                    if (counter) {
                        counter.textContent = `${this.value.length}/50`;
                    }
                });
            }

            const editCategoryName = document.getElementById('editCategoryName');
            if (editCategoryName) {
                editCategoryName.addEventListener('input', function() {
                    const maxLength = 50;
                    let value = this.value;
                    const counter = document.getElementById('editCategoryCounter');
                    if (value.length > maxLength) {
                        this.value = value.substring(0, maxLength);
                        showNotification('Название категории не может превышать 50 символов', 'warning');
                    }
                    if (counter) {
                        counter.textContent = `${this.value.length}/50`;
                    }
                });
            }
                    const addCategoryModal = document.getElementById('addCategoryModal');
        if (addCategoryModal) {
            addCategoryModal.addEventListener('show.bs.modal', function() {
                setCurrentTripForCategory();
            });
        }
            // Чекбокс неравного распределения
            const unequalSplitCheckbox = document.getElementById('unequalSplitCheckbox');
            if (unequalSplitCheckbox) {
                unequalSplitCheckbox.addEventListener('change', function(e) {
                    toggleUnequalSplit(e.target.checked);
                });
            }
                    const saveCategoryBtn = document.getElementById('saveCategoryBtn');
        if (saveCategoryBtn) {
            saveCategoryBtn.addEventListener('click', function(e) {
                addCategory(e);
            });
        }
        });

        // Загрузка данных бюджета
                        async function loadBudgetData() {
            try {
                selectedTripId = document.getElementById('tripFilter').value;
                console.log('Loading budget data for trip:', selectedTripId);

                const response = await fetch('/Budget/GetSummary');
                const data = await response.json();

                if (data.success) {
                    budgetData = data.data;
                    console.log('Data loaded, categories count:', budgetData.categories?.length);

                    // Сначала рендерим данные
                    renderBudgetData();

                    // Потом обновляем селекты (НЕ ДЕЛАЕМ НОВЫЕ ЗАПРОСЫ!)
                    updateCategoriesForCurrentTrip();
                    updateFilterCategories();

                    // Загружаем поездки для селектов (если нужно)
                    if (document.getElementById('expenseTrip').options.length <= 1) {
                        await loadTripsForSelect();
                    }
                    if (document.getElementById('categoryTripId').options.length <= 1) {
                        await loadTripsForCategoryModal();
                    }
                } else {
                    console.error('API Error:', data.message);
                    showNotification(data.message || 'Ошибка загрузки данных', 'danger');
                    showEmptyState();
                }
            } catch (error) {
                console.error('Error loading budget data:', error);
                showNotification('Не удалось загрузить данные бюджета', 'danger');
                showEmptyState();
            }
        }
                        function updateFilterCategories() {
            if (!budgetData) return;

            const filterSelect = document.getElementById('expenseCategoryFilter');
            if (!filterSelect) return;

            let options = '<option value="all">Все категории</option>';

            budgetData.categories.forEach(cat => {
                if (cat.id > 0) {  // Исключаем id = 0
                    options += `<option value="${cat.id}">${escapeHtml(cat.name)}</option>`;
                }
            });

            filterSelect.innerHTML = options;
        }
                        function updateCategoriesForCurrentTrip() {
            if (!budgetData) return;

            const currentTripId = document.getElementById('expenseTrip').value;
            const categorySelect = document.getElementById('expenseCategory');
            let options = '<option value="">Выберите категорию</option>';

            budgetData.categories.forEach(cat => {
                if (cat.id > 0) {  // Исключаем id = 0
                    if (!currentTripId || currentTripId === '' || currentTripId === 'all') {
                        options += `<option value="${cat.id}">${escapeHtml(cat.name)}</option>`;
                    } else {
                        if (cat.tripId === null || cat.tripId === parseInt(currentTripId)) {
                            options += `<option value="${cat.id}">${escapeHtml(cat.name)}</option>`;
                        }
                    }
                }
            });

            if (categorySelect) {
                categorySelect.innerHTML = options;
            }
        }
        function showEmptyState() {
            const container = document.getElementById('categoriesContainer');
            if (container) {
                container.innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-exclamation-triangle fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Не удалось загрузить данные</p>
                    </div>
                `;
            }
        }
                                function toggleUnequalSplit(enabled) {
            const container = document.getElementById('unequalSplitContainer');
            if (container) {
                container.style.display = enabled ? 'block' : 'none';
            }

            if (enabled) {
                // Проверяем, есть ли сумма
                const totalAmount = parseFloat(document.getElementById('expenseAmount').value) || 0;
                if (totalAmount === 0) {
                    showNotification('Сначала укажите сумму расхода', 'warning');
                }
                loadUnequalSplitInputs();
            }
        }

                                        function loadUnequalSplitInputs() {
            const container = document.getElementById('unequalSplitParticipants');
            const checkboxes = document.querySelectorAll('#participantsContainer input[type="checkbox"]:checked');
            let totalAmount = parseFloat(document.getElementById('expenseAmount').value) || 0;

            // Получаем ВСЕХ участников поездки (не только выбранных)
            const allTripParticipants = [];
            const participantElements = document.querySelectorAll('#participantsContainer .participant-checkbox');

            // Добавляем текущего пользователя
            allTripParticipants.push({
                userId: currentUserId,
                name: 'Я (плательщик)',
                isCurrentUser: true,
                isSelected: true // плательщик всегда участвует
            });

            // Добавляем ВСЕХ участников из списка
            participantElements.forEach(el => {
                const checkbox = el.querySelector('input[type="checkbox"]');
                if (checkbox) {
                    const userId = parseInt(checkbox.value);
                    if (userId !== currentUserId) {
                        const label = el.querySelector('.form-check-label');
                        let name = 'Участник';
                        if (label) {
                            const textDiv = label.querySelector('.d-flex');
                            if (textDiv) {
                                const text = textDiv.childNodes[textDiv.childNodes.length - 1];
                                name = text ? text.textContent.trim() : 'Участник';
                            }
                        }
                        const isChecked = checkbox.checked;
                        allTripParticipants.push({
                            userId: userId,
                            name: name,
                            isCurrentUser: false,
                            isSelected: isChecked
                        });
                    }
                }
            });

            if (allTripParticipants.length === 0) {
                container.innerHTML = '<div class="text-muted">Нет участников для распределения</div>';
                return;
            }

            let html = '';
            const isAmountZero = totalAmount === 0;

            allTripParticipants.forEach((participant) => {
                // Для невыбранных участников сумма должна быть 0
                const defaultValue = participant.isSelected ? '0' : '0';
                const isDisabled = isAmountZero || !participant.isSelected;

                html += `
                    <div class="input-group mb-2">
                        <span class="input-group-text" style="width: 160px; background-color: ${participant.isCurrentUser ? '#e3f2fd' : (participant.isSelected ? '#f8f9fa' : '#f8f9fa')};">
                            ${escapeHtml(participant.name)}
                            ${participant.isCurrentUser ? '<span class="badge bg-primary ms-2">Вы</span>' : ''}
                            ${!participant.isSelected ? '<span class="badge bg-secondary ms-2">Не участвует</span>' : ''}
                        </span>
                        <input type="number" class="form-control share-amount-input"
                               data-user-id="${participant.userId}"
                               data-is-current="${participant.isCurrentUser}"
                               data-is-selected="${participant.isSelected}"
                               placeholder="Сумма" step="0.01" min="0"
                               value="${defaultValue}"
                               ${isDisabled ? 'disabled' : `oninput="validateShareAmount(this, ${totalAmount})"`}>
                        <span class="input-group-text">₽</span>
                    </div>
                `;
            });

            container.innerHTML = html;

            // Обновляем отображение итога
            const totalDiv = document.createElement('div');
            totalDiv.id = 'unequalSplitTotal';
            totalDiv.className = 'mt-2 text-end';

            if (isAmountZero) {
                totalDiv.innerHTML = `<small class="text-muted">Сначала укажите сумму расхода</small>`;
            } else {
                totalDiv.innerHTML = `<small>Итого: <span id="sharesTotal">0</span> ₽ из ${formatMoney(totalAmount)} ₽</small>`;
            }

            const oldTotal = document.getElementById('unequalSplitTotal');
            if (oldTotal) oldTotal.remove();

            container.appendChild(totalDiv);

            console.log('Loaded participants for unequal split:', allTripParticipants);
        }
                        function validateShareAmount(input, totalAmount) {
            let value = parseFloat(input.value) || 0;

            // Проверяем, что totalAmount определен и больше 0
            if (!totalAmount || totalAmount <= 0) {
                input.value = 0;
                showNotification('Сначала укажите сумму расхода', 'warning');
                return;
            }

            // Не может быть больше общей суммы
            if (value > totalAmount) {
                input.value = totalAmount;
                value = totalAmount;
                showNotification('Сумма не может превышать общую сумму расхода', 'warning');
            }

            // Не может быть отрицательной
            if (value < 0) {
                input.value = 0;
                value = 0;
            }

            updateSharesTotal(totalAmount);
        }

                function updateSharesTotal(totalAmount) {
            const inputs = document.querySelectorAll('#unequalSplitParticipants .share-amount-input');
            let total = 0;

            inputs.forEach(input => {
                const val = parseFloat(input.value) || 0;
                total += val;
            });

            const sharesTotalSpan = document.getElementById('sharesTotal');
            if (sharesTotalSpan) {
                sharesTotalSpan.textContent = formatMoney(total);
                if (totalAmount && totalAmount > 0) {
                    sharesTotalSpan.className = Math.abs(total - totalAmount) > 0.01 ? 'text-danger' : 'text-success';
                }
            }
        }
                function updateCategoriesForTrip(tripId) {
            if (!budgetData) return;

            const categorySelect = document.getElementById('expenseCategory');
            let options = '<option value="">Выберите категорию</option>';

            // Фильтруем категории: показываем только те, что привязаны к этой поездке или глобальные
            budgetData.categories.forEach(cat => {
                if (cat.id > 0 && (cat.tripId === null || cat.tripId === tripId)) {
                    options += `<option value="${cat.id}">${escapeHtml(cat.name)}</option>`;
                }
            });

            categorySelect.innerHTML = options;
        }
        function renderBudgetData() {
            if (!budgetData) return;

            let totalBudget = budgetData.totalBudget;
            let totalSpent = budgetData.totalSpent;
            let categories = [...budgetData.categories];
            let recentExpenses = [...budgetData.recentExpenses];

            // Если выбрана конкретная поездка (не "все")
            if (selectedTripId !== 'all') {
                const tripId = parseInt(selectedTripId);
                const selectedTrip = budgetData.trips.find(t => t.id === tripId);

                if (selectedTrip) {
                    totalBudget = selectedTrip.totalBudget;
                    totalSpent = selectedTrip.totalSpent;
                    const tripExpenses = budgetData.recentExpenses.filter(e => e.tripId === tripId);
                    recentExpenses = tripExpenses;

                    // Пересчет категорий для выбранной поездки
                    const categoryMap = new Map();
                    budgetData.categories.forEach(cat => {
                        categoryMap.set(cat.id, {
                            id: cat.id,
                            name: cat.name,
                            budget: 0,
                            spent: 0,
                            color: cat.color,
                            expenseCount: 0
                        });
                    });

                    tripExpenses.forEach(exp => {
                        let catId = exp.categoryId || 0;
                        if (categoryMap.has(catId)) {
                            const cat = categoryMap.get(catId);
                            cat.spent += exp.amount;
                            cat.expenseCount++;
                        } else {
                            const otherCat = categoryMap.get(0);
                            if (otherCat) {
                                otherCat.spent += exp.amount;
                                otherCat.expenseCount++;
                            }
                        }
                    });

                    categories = Array.from(categoryMap.values())
                        .filter(cat => cat.spent > 0)
                        .sort((a, b) => b.spent - a.spent);
                }
            }

            // Обновляем статистику
            document.getElementById('totalBudget').textContent = formatMoney(totalBudget);
            document.getElementById('totalSpent').textContent = formatMoney(totalSpent);
            document.getElementById('remainingBudget').textContent = formatMoney(totalBudget - totalSpent);

            // Отображаем категории
            renderCategories(categories);

            // Фильтруем и сортируем расходы
            let filteredExpenses = filterExpensesByCategory(recentExpenses, currentExpenseCategoryFilter);
            let sortedExpenses = sortExpenses(filteredExpenses, currentExpenseSort);

            // Отображаем расходы
            renderExpenses(sortedExpenses);

            // Отображаем долги для выбранной поездки
            if (selectedTripId !== 'all') {
                renderDebts(parseInt(selectedTripId));
            } else {
                document.getElementById('debtsContainer').innerHTML = `
                    <div class="text-center py-3">
                        <i class="fas fa-calculator fa-2x text-muted mb-2"></i>
                        <p class="text-muted mb-0">Выберите поездку для просмотра долгов</p>
                    </div>
                `;
            }
        }

                async function loadExpenseFilterCategories() {
            try {
                if (!budgetData) return;

                const filterSelect = document.getElementById('expenseCategoryFilter');
                if (!filterSelect) return;

                let options = '<option value="all">Все категории</option>';

                budgetData.categories.forEach(cat => {
                    if (cat.id > 0) {
                        options += `<option value="${cat.id}">${escapeHtml(cat.name)}</option>`;
                    }
                });

                filterSelect.innerHTML = options;
            } catch (error) {
                console.error('Error loading filter categories:', error);
            }
        }

        // Функция сортировки расходов
        function sortExpenses(expenses, sortOrder) {
            const sorted = [...expenses];
            switch(sortOrder) {
                case 'date_asc':
                    return sorted.sort((a, b) => new Date(a.expenseDate) - new Date(b.expenseDate));
                case 'amount_desc':
                    return sorted.sort((a, b) => b.amount - a.amount);
                case 'amount_asc':
                    return sorted.sort((a, b) => a.amount - b.amount);
                case 'name_asc':
                    return sorted.sort((a, b) => a.title.localeCompare(b.title));
                case 'name_desc':
                    return sorted.sort((a, b) => b.title.localeCompare(a.title));
                default: // date_desc
                    return sorted.sort((a, b) => new Date(b.expenseDate) - new Date(a.expenseDate));
            }
        }

        // Функция фильтрации расходов по категории
        function filterExpensesByCategory(expenses, categoryId) {
            if (categoryId === 'all') return expenses;
            return expenses.filter(exp => exp.categoryId === parseInt(categoryId));
        }

                // Отображение категорий
        function renderCategories(categories) {
