                let options = '<option value="">Выберите категорию</option>';
                const currentTripId = document.getElementById('expenseTrip').value;

                // ИСПОЛЬЗУЕМ budgetData, а не новый запрос
                budgetData.categories.forEach(cat => {
                    if (cat.id > 0) {
