                        async function loadCategoriesForSelect() {
            try {
                // НЕ ДЕЛАЕМ ЗАПРОС, ЕСЛИ НЕТ budgetData
                if (!budgetData) {
                    console.log('No budget data yet, skipping category load');
                    return;
                }

