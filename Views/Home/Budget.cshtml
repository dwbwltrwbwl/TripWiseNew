        // Функция пересчёта долей из общей суммы (пропорционально)
        function recalcSharesFromTotal() {
            const newTotal = parseFloat(document.getElementById('editExpenseAmount').value) || 0;
            const proportions = window.editExpenseProportions || new Map();

            if (proportions.size === 0) return;

            const shareInputs = document.querySelectorAll('#editParticipantsContainer .share-amount-input');
            shareInputs.forEach(input => {
                const userId = parseInt(input.dataset.userId);
                const proportion = proportions.get(userId) || 0;
                const newAmount = (newTotal * proportion).toFixed(2);
                input.value = newAmount;
            });

            updateExpenseTotal();
        }

        // Функция для расчёта общей суммы из долей
        function updateExpenseTotal() {
            const shareInputs = document.querySelectorAll('#editParticipantsContainer .share-amount-input');
            let total = 0;
            shareInputs.forEach(input => {
                const val = parseFloat(input.value) || 0;
                total += val;
            });

            // Обновляем поле общей суммы
            const amountInput = document.getElementById('editExpenseAmount');
            if (amountInput) {
                amountInput.value = total.toFixed(2);
            }
        }

        // Функция для равного распределения суммы
        function resetSharesToEqual() {
            const total = parseFloat(document.getElementById('editExpenseAmount').value) || 0;
            const shareInputs = document.querySelectorAll('#editParticipantsContainer .share-amount-input');
            const count = shareInputs.length;

            if (count === 0) return;

            const equalShare = total / count;
            shareInputs.forEach(input => {
                input.value = equalShare.toFixed(2);
            });

            updateExpenseTotal();
        }

                                                        async function updateExpense(event) {
            event.preventDefault();

            const expenseId = parseInt(document.getElementById('editExpenseId').value);
            let amount = parseFloat(document.getElementById('editExpenseAmount').value);
            const categoryId = parseInt(document.getElementById('editExpenseCategory').value);
            let title = document.getElementById('editExpenseTitle').value.trim();
            const date = document.getElementById('editExpenseDate').value;

            // Собираем доли из полей ввода
            let shares = [];
            const shareInputs = document.querySelectorAll('#editParticipantsContainer .share-amount-input');

            shareInputs.forEach(input => {
                const userId = parseInt(input.dataset.userId);
                const shareAmount = parseFloat(input.value) || 0;
                if (shareAmount > 0) {
                    shares.push({ userId: userId, amount: shareAmount });
                }
            });

            // ========== ВАЛИДАЦИЯ ==========
            if (isNaN(amount) || amount <= 0) {
                showNotification('Введите корректную сумму (больше 0)', 'warning');
                return;
            }

            if (amount > 9999999999) {
                showNotification('Сумма не может превышать 9 999 999 999', 'warning');
                return;
            }

            if (!title) {
                showNotification('Введите описание расхода', 'warning');
                return;
            }

            if (title.length > 50) {
                showNotification('Описание не может превышать 50 символов', 'warning');
                title = title.substring(0, 50);
            }

            if (!categoryId) {
                showNotification('Выберите категорию', 'warning');
                return;
            }

            if (!date) {
                showNotification('Выберите дату', 'warning');
                return;
            }

            // Проверка даты...
            const expense = budgetData?.recentExpenses?.find(e => e.id === expenseId);
            if (expense) {
                const trip = budgetData?.trips?.find(t => t.id === expense.tripId);
                if (trip) {
                    const expenseDate = new Date(date);
                    const startDate = new Date(trip.startDate);
                    const endDate = new Date(trip.endDate);
                    startDate.setHours(0, 0, 0, 0);
                    endDate.setHours(23, 59, 59, 999);

                    if (expenseDate < startDate || expenseDate > endDate) {
                        showNotification(`Расход можно добавить только в период поездки: ${new Date(trip.startDate).toLocaleDateString()} - ${new Date(trip.endDate).toLocaleDateString()}`, 'warning');
                        return;
                    }
                }
            }

            const submitBtn = document.querySelector('#editExpenseModal .btn-primary');
            const originalBtnText = submitBtn ? submitBtn.innerHTML : 'Сохранить';

            try {
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Сохранение...';
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const requestBody = {
                    expenseId: expenseId,
                    amount: amount,
                    categoryId: categoryId,
                    title: title,
                    expenseDate: new Date(date).toISOString(),
                    sharedWith: [],
                    shares: shares
                };

                const response = await fetch('/Budget/UpdateExpense', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(requestBody)
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Расход обновлен', 'success');
                    const modal = bootstrap.Modal.getInstance(document.getElementById('editExpenseModal'));
                    modal.hide();
                    await loadBudgetData();
                } else {
                    showNotification(data.message || 'Ошибка при обновлении', 'danger');
                }
            } catch (error) {
                console.error('Error updating expense:', error);
                showNotification('Не удалось обновить расход: ' + error.message, 'danger');
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                }
            }
        }

