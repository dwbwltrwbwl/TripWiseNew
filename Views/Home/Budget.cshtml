        // ============ РАСХОДЫ ============

                // Добавление расхода с проверкой даты и неравным распределением
        async function addExpense(event) {
            event.preventDefault();

            // Получаем значения из формы
            const tripId = document.getElementById('expenseTrip').value;
            let amount = parseFloat(document.getElementById('expenseAmount').value);
            const categoryId = parseInt(document.getElementById('expenseCategory').value);
            let title = document.getElementById('expenseTitle').value.trim();
            const date = document.getElementById('expenseDate').value;
            const unequalSplit = document.getElementById('unequalSplitCheckbox')?.checked || false;

            // ========== ВАЛИДАЦИЯ ==========
            if (!tripId) {
                showNotification('Выберите поездку', 'warning');
                return;
            }

            if (isNaN(amount) || amount <= 0) {
                showNotification('Введите корректную сумму (больше 0)', 'warning');
                return;
            }

            if (amount > 9999999999) {
                showNotification('Сумма не может превышать 9 999 999 999', 'warning');
                return;
            }

            if (!title) {
                showNotification('Введите описание расхода', 'warning');
                return;
            }

            if (title.length > 50) {
                title = title.substring(0, 50);
                showNotification('Описание сокращено до 50 символов', 'warning');
            }

            if (!categoryId) {
                showNotification('Выберите категорию', 'warning');
                return;
            }

            if (!date) {
                showNotification('Выберите дату', 'warning');
                return;
            }

            // ========== ПРОВЕРКА ДАТЫ НА КЛИЕНТЕ ==========
            const trip = budgetData?.trips?.find(t => t.id === parseInt(tripId));
            if (trip) {
                const expenseDate = new Date(date);
                const startDate = new Date(trip.startDate);
                const endDate = new Date(trip.endDate);
                startDate.setHours(0, 0, 0, 0);
                endDate.setHours(23, 59, 59, 999);

                if (expenseDate < startDate || expenseDate > endDate) {
                    showNotification(`Расход можно добавить только в период поездки: ${new Date(trip.startDate).toLocaleDateString()} - ${new Date(trip.endDate).toLocaleDateString()}`, 'warning');
                    return;
                }
            }

            // ========== СБОР ДАННЫХ ДЛЯ РАСПРЕДЕЛЕНИЯ ==========
            console.log('=== ОТЛАДКА ===');
            console.log('unequalSplit:', unequalSplit);
            console.log('amount:', amount);

            let shares = [];
            let sharedWith = [];

            if (unequalSplit) {
                // НЕРАВНОЕ РАСПРЕДЕЛЕНИЕ
                const shareInputs = document.querySelectorAll('#unequalSplitParticipants .share-amount-input');

                if (shareInputs.length === 0) {
                    showNotification('Нет участников для распределения', 'warning');
                    return;
                }

                let totalShares = 0;
                shares = [];

                shareInputs.forEach(input => {
                    const userId = parseInt(input.dataset.userId);
                    const shareAmount = parseFloat(input.value) || 0;
                    // Добавляем ВСЕХ участников, даже с нулевой суммой
                    shares.push({ userId: userId, amount: shareAmount });
                    totalShares += shareAmount;
                });

                // Проверка суммы долей
                if (Math.abs(totalShares - amount) > 0.01) {
                    showNotification(`Сумма долей (${formatMoney(totalShares)}) не равна общей сумме (${formatMoney(amount)})`, 'warning');
                    return;
                }

                if (shares.length === 0) {
                    showNotification('Укажите суммы для участников', 'warning');
                    return;
                }
            } else {
                // РАВНОЕ РАСПРЕДЕЛЕНИЕ
                const checkboxes = document.querySelectorAll('#participantsContainer input[type="checkbox"]:checked');

                if (checkboxes.length === 0) {
                    showNotification('Выберите хотя бы одного участника для разделения расхода', 'warning');
                    return;
                }

                checkboxes.forEach(cb => {
                    sharedWith.push(parseInt(cb.value));
                });
            }

            console.log('shares before send:', shares);
            console.log('sharedWith before send:', sharedWith);

            // ========== ОТПРАВКА ЗАПРОСА ==========
            try {
                // Показываем индикатор загрузки на кнопке
                const submitBtn = document.querySelector('#addExpenseForm button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Добавление...';
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Budget/AddExpense', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({
                        tripId: parseInt(tripId),
                        title: title,
                        amount: amount,
                        categoryId: categoryId,
                        expenseDate: new Date(date).toISOString(),
                        sharedWith: sharedWith,
                        shares: shares
                    })
                });

                const data = await response.json();

                if (data.success) {
