        async function updateCategory(event) {
            event.preventDefault();

            const categoryId = parseInt(document.getElementById('editCategoryId').value);
            let newName = document.getElementById('editCategoryName').value.trim();

            if (!newName) {
                showNotification('Введите название категории', 'warning');
                return;
            }

            if (newName.length > 50) {
                showNotification('Название категории не может превышать 50 символов', 'warning');
                newName = newName.substring(0, 50);
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Budget/UpdateCategory', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        categoryId: categoryId,
                        name: newName
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Категория обновлена', 'success');
                    editCategoryModal.hide();
                    await loadBudgetData();
                    await loadCategoriesForSelect();
                } else {
                    showNotification(data.message || 'Ошибка при обновлении', 'danger');
                }
            } catch (error) {
                console.error('Error updating category:', error);
                showNotification('Не удалось обновить категорию', 'danger');
            }
        }

        // Удаление категории с проверкой расходов
        async function deleteCategory(categoryId, categoryName, expenseCount) {
            console.log('deleteCategory called with:', {
                categoryId: categoryId,
                categoryName: categoryName,
                expenseCount: expenseCount,
                type: typeof expenseCount
            });

            if (expenseCount > 0) {
                showNotification(`Нельзя удалить категорию "${categoryName}", так как она используется в ${expenseCount} расходах`, 'warning');
