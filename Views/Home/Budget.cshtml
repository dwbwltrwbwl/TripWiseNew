                        <p class="text-success mb-0">Нет долгов!</p>
                    </div>
                `;
                return;
            }

            let html = '';
            debtsList.forEach(debt => {
                const isCurrentUserOwes = debt.from === currentUserId;
                const isCurrentUserGets = debt.to === currentUserId;

                let debtText = '';
                if (isCurrentUserOwes) {
                    debtText = `<strong>Вы должны</strong> ${escapeHtml(debt.toName)}`;
                } else if (isCurrentUserGets) {
