                        currentShares.forEach(share => {
                            sharesMap.set(share.userId, share.amount);
                        });
                    }

                    // Сохраняем пропорции для последующего пересчёта
                    const totalOld = currentExpense.amount;
                    const proportions = new Map();
                    if (totalOld > 0) {
                        for (const [userId, amount] of sharesMap) {
                            proportions.set(userId, amount / totalOld);
                        }
                    }

                    // Сохраняем пропорции в глобальную переменную
                    window.editExpenseProportions = proportions;

                    let html = '<div class="mb-2"><strong>Распределение сумм:</strong></div>';

                    data.data.forEach(p => {
                        let currentAmount = sharesMap.get(p.idUser) || 0;
