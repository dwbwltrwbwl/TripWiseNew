                                    <span class="badge" style="background-color: ${getCategoryColor(exp.categoryName)}; color: white; flex-shrink: 0;">${escapeHtml(exp.categoryName)}</span>
                                    ${isReadOnly ? '<span class="badge bg-secondary ms-1 flex-shrink-0">Закрыт</span>' : ''}
                                </div>
                                <small class="text-muted">
                                    <i class="fas fa-map-marker-alt me-1"></i><span title="${escapeHtml(tripName)}">${escapeHtml(truncatedTripName)}</span>
                                    <span class="mx-2">•</span>
                                    <i class="far fa-calendar me-1"></i>${formattedDate}
                                </small>
                            </div>
                            <div class="text-end ms-3 flex-shrink-0">
                                <div class="fw-bold text-danger">-${formatMoney(exp.amount)} ₽</div>
                                <small class="text-muted" title="${escapeHtml(paidByName)}">
                                    <i class="fas fa-user me-1"></i>${escapeHtml(truncatedPaidByName)}
                                </small>
                            </div>
                        </div>
                        <div class="expense-actions flex-shrink-0 ms-2">
                            ${!isReadOnly ? `
                                <button class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation(); openEditExpenseModal(${exp.id})" title="Редактировать">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteExpense(${exp.id})" title="Удалить">
                                    <i class="fas fa-trash-alt"></i>
