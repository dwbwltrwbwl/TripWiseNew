                        <div class="mt-3">
                            <button class="btn btn-sm btn-success mark-debt-btn"
                                    onclick="markDebtAsPaid(${debt.from}, ${debt.to}, ${debt.amount}, ${tripId})"
                                    data-debt-key="${debt.from}_${debt.to}_${tripId}">
                                <i class="fas fa-check-circle me-1"></i>Отметить как оплачено
