                                async function loadEditParticipants(tripId, currentShares) {
            if (!tripId) return;

            try {
                const response = await fetch(`/Budget/GetTripParticipants?tripId=${tripId}`);
                const data = await response.json();

                if (data.success) {
                    const container = document.getElementById('editParticipantsContainer');
                    const currentExpense = budgetData.recentExpenses.find(e => e.id === parseInt(document.getElementById('editExpenseId').value));

                    if (!currentExpense) return;

                    // Сохраняем исходные доли для вычисления пропорций
                    const sharesMap = new Map();
