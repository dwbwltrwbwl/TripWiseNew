        function getCategoryColor(categoryName) {
            const colors = {
                'Транспорт': '#0379D9',
                'Проживание': '#40B624',
                'Питание': '#FF6B6B',
                'Развлечения': '#FFC107',
                'Шоппинг': '#6F42C1',
                'Экскурсии': '#17A2B8',
                'Долги': '#DC3545',
                'Другое': '#6c757d'
            };
            return colors[categoryName] || '#6c757d';
        }

        function validateExpenseAmount(input) {
            let value = input.value;
            value = value.replace(/[^\d.]/g, '');
            if (value.length > 10) {
                value = value.slice(0, 10);
            }
            if (parseFloat(value) < 0) {
                value = '0';
            }
            input.value = value;
        }

        // ============ КАТЕГОРИИ ============

        // Добавление категории с привязкой к поездке
                        async function addCategory(event) {
            event.preventDefault();

            const tripId = document.getElementById('categoryTripId').value;
            let name = document.getElementById('categoryName').value.trim();

            if (!tripId) {
                showNotification('Выберите поездку', 'warning');
                return;
            }

            if (!name) {
                showNotification('Введите название категории', 'warning');
                return;
            }

            if (name.length > 50) {
                name = name.substring(0, 50);
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Budget/AddCategory', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ name: name, tripId: parseInt(tripId) })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Категория добавлена', 'success');

                    // Закрываем модальное окно
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addCategoryModal'));
                    modal.hide();

                    // Сбрасываем форму
                    document.getElementById('categoryName').value = '';
                    document.getElementById('categoryTripId').value = '';

                    // ТОЛЬКО ОДИН РАЗ ПЕРЕЗАГРУЖАЕМ ДАННЫЕ
                    // loadBudgetData уже обновляет все категории и фильтры
                    await loadBudgetData();

                    // НЕ НУЖНО вызывать отдельно loadCategoriesForSelect и loadExpenseFilterCategories
                    // loadBudgetData уже вызывает updateCategoriesForCurrentTrip() и updateFilterCategories()
                } else {
                    showNotification(data.message || 'Ошибка при добавлении', 'danger');
                }
            } catch (error) {
                console.error('Error adding category:', error);
                showNotification('Не удалось добавить категорию', 'danger');
            }
        }

        // Редактирование категории
        async function editCategory(categoryId, categoryName) {
            document.getElementById('editCategoryId').value = categoryId;
            document.getElementById('editCategoryName').value = categoryName;

            const counter = document.getElementById('editCategoryCounter');
            if (counter) {
                counter.textContent = `${categoryName.length}/50`;
            }

            if (!editCategoryModal) {
                editCategoryModal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
