                function getUserNameFromTrip(tripId, userId) {
            if (!budgetData || !budgetData.recentExpenses) return `Участник ${userId}`;

            // Ищем имя в расходах
            for (const exp of budgetData.recentExpenses) {
                if (exp.shares) {
                    const share = exp.shares.find(s => s.userId === userId);
                    if (share && share.userName) return share.userName;
                }
                if (exp.paidById === userId && exp.paidByName) return exp.paidByName;
            }

            return `Участник ${userId}`;
        }

        function calculateSimplifiedDebts(balances, userNames) {
            const debtors = [];
            const creditors = [];

            for (const [userId, balance] of balances) {
                if (balance < -0.01) {
                    debtors.push({ userId, balance: Math.abs(balance), userName: userNames.get(userId) || `Участник ${userId}` });
                } else if (balance > 0.01) {
                    creditors.push({ userId, balance, userName: userNames.get(userId) || `Участник ${userId}` });
                }
            }

            debtors.sort((a, b) => b.balance - a.balance);
            creditors.sort((a, b) => b.balance - a.balance);

            const debts = [];
            let i = 0, j = 0;

            while (i < debtors.length && j < creditors.length) {
                const debtor = debtors[i];
                const creditor = creditors[j];
                const amount = Math.min(debtor.balance, creditor.balance);

                if (amount > 0.01) {
                    debts.push({
                        from: debtor.userId,
                        fromName: debtor.userName,
                        to: creditor.userId,
                        toName: creditor.userName,
                        amount: amount
                    });
                }

                debtor.balance -= amount;
                creditor.balance -= amount;

                if (debtor.balance < 0.01) i++;
                if (creditor.balance < 0.01) j++;
            }

            return debts;
        }

        // Отметка долга как оплаченного с блокировкой повторных нажатий
                // Отметка долга как оплаченного с блокировкой повторных нажатий
        async function markDebtAsPaid(fromUserId, toUserId, amount, tripId) {
            console.log('=== markDebtAsPaid ВЫЗВАН ===');
            console.log('Параметры:', { fromUserId, toUserId, amount, tripId });

            const debtKey = `${fromUserId}_${toUserId}_${tripId}`;

            if (processingDebts.has(debtKey)) {
                console.log('Операция уже выполняется, пропускаем');
                showNotification('Операция уже выполняется, подождите...', 'warning');
                return;
            }

            const buttons = document.querySelectorAll(`.mark-debt-btn[data-debt-key="${debtKey}"]`);
            const originalTexts = [];

            buttons.forEach(btn => {
                originalTexts.push(btn.innerHTML);
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Обработка...';
            });

            processingDebts.add(debtKey);

            console.log('Отправка запроса на сервер...');

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                console.log('Token найден:', token ? 'Да' : 'Нет');

                const requestBody = {
                    fromUserId: fromUserId,
                    toUserId: toUserId,
                    amount: amount,
                    tripId: tripId
                };
                console.log('Тело запроса:', requestBody);

                const response = await fetch('/Budget/MarkDebtAsPaid', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(requestBody)
                });

                console.log('Ответ получен, статус:', response.status);

                const data = await response.json();
                console.log('Данные ответа:', data);

                if (data.success) {
                    console.log('Успех! Долг отмечен как оплаченный');
                    showNotification('Долг отмечен как оплаченный', 'success');
                    await loadBudgetData();
                } else {
                    console.error('Ошибка от сервера:', data.message);
                    showNotification(data.message || 'Ошибка при отметке долга', 'danger');
                    buttons.forEach((btn, idx) => {
                        btn.disabled = false;
                        btn.innerHTML = originalTexts[idx];
                    });
                }
            } catch (error) {
                console.error('Ошибка при выполнении запроса:', error);
                showNotification('Не удалось отметить долг: ' + error.message, 'danger');
                buttons.forEach((btn, idx) => {
                    btn.disabled = false;
                    btn.innerHTML = originalTexts[idx];
                });
            } finally {
                processingDebts.delete(debtKey);
                console.log('Операция завершена');
            }
        }

