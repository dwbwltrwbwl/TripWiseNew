            const directDebts = new Map(); // ключ: "fromUserId_toUserId"

            tripExpenses.forEach(exp => {
                if (exp.shares && exp.shares.length > 0) {
                    // Плательщик - тот, кому должны
                    const creditorId = exp.paidById;

                            exp.shares.forEach(share => {
            // Если участник НЕ плательщик, его доля > 0 И доля НЕ ОПЛАЧЕНА
            if (share.userId !== creditorId && share.amount > 0.01 && share.isPaid === false) {
                const key = `${share.userId}_${creditorId}`;
                const currentDebt = directDebts.get(key) || 0;
                directDebts.set(key, currentDebt + share.amount);
            }
        });
                }
            });

            console.log('=== ПРЯМЫЕ ДОЛГИ ===');
            const debtsList = [];
            for (const [key, amount] of directDebts.entries()) {
                const [fromUserId, toUserId] = key.split('_');
                const fromName = getUserNameFromTrip(tripId, parseInt(fromUserId));
                const toName = getUserNameFromTrip(tripId, parseInt(toUserId));
                debtsList.push({
                    from: parseInt(fromUserId),
                    fromName: fromName,
                    to: parseInt(toUserId),
                    toName: toName,
                    amount: amount
                });
                console.log(`${fromName} должен ${toName}: ${amount} ₽`);
            }

            if (debtsList.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-3">
