@section Scripts {
    <script>
        // ==================== ФУНКЦИИ ДЛЯ АВИАБИЛЕТОВ ====================
        function applyFlightFilters() {
            const direction = document.getElementById('flightDirectionFilter')?.value;
            const airline = document.getElementById('flightAirlineFilter')?.value;
            const sort = document.getElementById('flightSortFilter')?.value;

            const items = document.querySelectorAll('.flight-item');
            let visibleCount = 0;

            items.forEach(item => {
                const itemDirection = item.getAttribute('data-direction');
                const itemAirline = item.getAttribute('data-airline');

                const directionMatch = !direction || itemDirection === direction;
                const airlineMatch = !airline || itemAirline === airline;

                if (directionMatch && airlineMatch) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Сортировка
            const container = document.getElementById('flightFavoritesList');
            if (container && sort) {
                const visibleItems = Array.from(items)
                    .filter(item => item.style.display !== 'none')
                    .sort((a, b) => {
                        switch(sort) {
                            case 'price_asc':
                                return parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price'));
                            case 'price_desc':
                                return parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price'));
                            case 'date_asc':
                                return parseInt(a.getAttribute('data-departure')) - parseInt(b.getAttribute('data-departure'));
                            default: // date
                                return parseInt(b.getAttribute('data-date')) - parseInt(a.getAttribute('data-date'));
                        }
                    });
                visibleItems.forEach(item => container.appendChild(item));
            }

            // Обновляем счетчики
            const totalSpan = document.getElementById('flightTotalCount');
            const visibleSpan = document.getElementById('flightVisibleCount');
            const totalItems = items.length;

            if (visibleSpan) visibleSpan.textContent = visibleCount;
            if (totalSpan) {
                totalSpan.textContent = totalItems;
                // Меняем цвет бейджа если показаны не все
                if (visibleCount === totalItems) {
                    totalSpan.className = 'badge bg-primary';
                } else {
                    totalSpan.className = 'badge bg-info';
                }
            }
        }
        function resetFlightFilters() {
            if (document.getElementById('flightDirectionFilter')) document.getElementById('flightDirectionFilter').value = '';
            if (document.getElementById('flightAirlineFilter')) document.getElementById('flightAirlineFilter').value = '';
            if (document.getElementById('flightSortFilter')) document.getElementById('flightSortFilter').value = 'date';
            applyFlightFilters();
        }
        // Удаление авиабилета из избранного
        document.addEventListener('click', async function(e) {
            if (e.target.closest('.remove-flight-favorite')) {
                e.preventDefault();

                const button = e.target.closest('.remove-flight-favorite');
                const flightId = button.getAttribute('data-flight-id');

                if (!flightId) {
                    alert('Ошибка: идентификатор рейса не найден');
                    return;
                }

                if (confirm('Удалить рейс из избранного?')) {
                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                    try {
                        const response = await fetch('/api/favorites/remove', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            credentials: 'include',
                            body: JSON.stringify({ flightId: flightId })
                        });

                        const result = await response.json();

                        if (result.success) {
                            const card = button.closest('.flight-item');
                            card.style.transition = 'opacity 0.3s';
                            card.style.opacity = '0';

                            setTimeout(() => {
                                card.remove();
                                updateCounters();
                                if (document.querySelectorAll('.flight-item').length === 0 &&
                                    document.querySelectorAll('.train-item').length === 0 &&
                                    document.querySelectorAll('.hotel-item').length === 0) {
                                    location.reload();
                                }
                            }, 300);
                        } else {
                            alert(result.message || 'Ошибка при удалении рейса');
                            button.disabled = false;
                            button.innerHTML = '<i class="fas fa-trash"></i>';
                        }
                    } catch (error) {
                        console.error('Ошибка удаления:', error);
                        alert('Ошибка при удалении рейса');
                        button.disabled = false;
                        button.innerHTML = '<i class="fas fa-trash"></i>';
                    }
                }
            }
        });

        // ==================== ФУНКЦИИ ДЛЯ ЖД БИЛЕТОВ ====================
        function applyTrainFilters() {
            const direction = document.getElementById('trainDirectionFilter')?.value;
            const sort = document.getElementById('trainSortFilter')?.value;

            const items = document.querySelectorAll('.train-item');
            let visibleCount = 0;

            items.forEach(item => {
                const itemDirection = item.getAttribute('data-direction');
                const directionMatch = !direction || itemDirection === direction;
                if (directionMatch) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Сортировка
            const container = document.getElementById('trainFavoritesList');
            if (container && sort) {
                const visibleItems = Array.from(items)
                    .filter(item => item.style.display !== 'none')
                    .sort((a, b) => {
                        switch(sort) {
                            case 'price_asc':
                                return parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price'));
                            case 'price_desc':
                                return parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price'));
                            case 'date_asc':
                                return parseInt(a.getAttribute('data-departure')) - parseInt(b.getAttribute('data-departure'));
                            default:
                                return parseInt(b.getAttribute('data-date')) - parseInt(a.getAttribute('data-date'));
                        }
                    });
                visibleItems.forEach(item => container.appendChild(item));
            }

            // Обновляем счетчики
            const totalSpan = document.getElementById('trainTotalCount');
            const visibleSpan = document.getElementById('trainVisibleCount');
            const totalItems = items.length;

            if (visibleSpan) visibleSpan.textContent = visibleCount;
            if (totalSpan) {
                totalSpan.textContent = totalItems;
                if (visibleCount === totalItems) {
                    totalSpan.className = 'badge bg-primary';
                } else {
                    totalSpan.className = 'badge bg-info';
                }
            }
        }
        function resetTrainFilters() {
            if (document.getElementById('trainDirectionFilter')) document.getElementById('trainDirectionFilter').value = '';
            if (document.getElementById('trainSortFilter')) document.getElementById('trainSortFilter').value = 'date';
            applyTrainFilters();
        }
        // Удаление ЖД билета из избранного
        document.addEventListener('click', async function(e) {
            if (e.target.closest('.remove-train-favorite')) {
                e.preventDefault();

                const button = e.target.closest('.remove-train-favorite');
                const trainGroupId = button.getAttribute('data-train-group-id');

                if (!trainGroupId) {
                    alert('Ошибка: идентификатор поезда не найден');
                    return;
                }

                if (confirm('Удалить поезд из избранного?')) {
                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                    try {
                        const response = await fetch('/api/favorites/train/remove', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            credentials: 'include',
                            body: JSON.stringify({ trainGroupId: trainGroupId })
                        });

                        const result = await response.json();

                        if (result.success) {
                            const card = button.closest('.train-item');
                            card.style.transition = 'opacity 0.3s';
                            card.style.opacity = '0';

                            setTimeout(() => {
                                card.remove();
                                updateCounters();
                                if (document.querySelectorAll('.flight-item').length === 0 &&
                                    document.querySelectorAll('.train-item').length === 0 &&
                                    document.querySelectorAll('.hotel-item').length === 0) {
                                    location.reload();
                                }
                            }, 300);
                        } else {
                            alert(result.message || 'Ошибка при удалении поезда');
                            button.disabled = false;
                            button.innerHTML = '<i class="fas fa-trash"></i>';
                        }
                    } catch (error) {
                        console.error('Ошибка удаления:', error);
                        alert('Ошибка при удалении поезда');
                        button.disabled = false;
                        button.innerHTML = '<i class="fas fa-trash"></i>';
                    }
                }
            }
        });

        // ==================== ФУНКЦИИ ДЛЯ ОТЕЛЕЙ ====================
        function applyHotelFilters() {
            const type = document.getElementById('hotelTypeFilter')?.value;
            const sort = document.getElementById('hotelSortFilter')?.value;

            const items = document.querySelectorAll('.hotel-item');
            let visibleCount = 0;

            items.forEach(item => {
                const itemType = item.getAttribute('data-type');
                const typeMatch = !type || itemType === type;
                if (typeMatch) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Сортировка
            const container = document.getElementById('hotelFavoritesList');
            if (container && sort) {
                const visibleItems = Array.from(items)
                    .filter(item => item.style.display !== 'none')
                    .sort((a, b) => {
                        switch(sort) {
                            case 'price_asc':
                                return parseFloat(a.getAttribute('data-price') || 0) - parseFloat(b.getAttribute('data-price') || 0);
                            case 'price_desc':
                                return parseFloat(b.getAttribute('data-price') || 0) - parseFloat(a.getAttribute('data-price') || 0);
                            case 'name':
                                return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
                            default:
                                return parseInt(b.getAttribute('data-date')) - parseInt(a.getAttribute('data-date'));
                        }
                    });
                visibleItems.forEach(item => container.appendChild(item));
            }

            // Обновляем счетчики
            const totalSpan = document.getElementById('hotelTotalCount');
            const visibleSpan = document.getElementById('hotelVisibleCount');
            const totalItems = items.length;

            if (visibleSpan) visibleSpan.textContent = visibleCount;
            if (totalSpan) {
                totalSpan.textContent = totalItems;
                if (visibleCount === totalItems) {
                    totalSpan.className = 'badge bg-primary';
                } else {
                    totalSpan.className = 'badge bg-info';
                }
            }
        }
        function resetHotelFilters() {
            if (document.getElementById('hotelTypeFilter')) document.getElementById('hotelTypeFilter').value = '';
            if (document.getElementById('hotelSortFilter')) document.getElementById('hotelSortFilter').value = 'date';
            applyHotelFilters();
        }
        // Удаление отеля из избранного
        document.addEventListener('click', async function(e) {
            if (e.target.closest('.remove-hotel-favorite')) {
                e.preventDefault();

                const button = e.target.closest('.remove-hotel-favorite');
                const hotelId = button.getAttribute('data-hotel-id');

                if (!hotelId) {
                    alert('Ошибка: идентификатор отеля не найден');
                    return;
                }

                if (confirm('Удалить отель из избранного?')) {
                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                    try {
                        const response = await fetch('/api/favorites/hotel/remove', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            credentials: 'include',
                            body: JSON.stringify({ hotelId: hotelId })
                        });

                        const result = await response.json();

                        if (result.success) {
                            const card = button.closest('.hotel-item');
                            card.style.transition = 'opacity 0.3s';
                            card.style.opacity = '0';

                            setTimeout(() => {
                                card.remove();
                                updateCounters();
                                if (document.querySelectorAll('.flight-item').length === 0 &&
                                    document.querySelectorAll('.train-item').length === 0 &&
                                    document.querySelectorAll('.hotel-item').length === 0) {
                                    location.reload();
                                }
                            }, 300);
                        } else {
                            alert(result.message || 'Ошибка при удалении отеля');
                            button.disabled = false;
                            button.innerHTML = '<i class="fas fa-trash"></i>';
                        }
                    } catch (error) {
                        console.error('Ошибка удаления:', error);
                        alert('Ошибка при удалении отеля');
                        button.disabled = false;
                        button.innerHTML = '<i class="fas fa-trash"></i>';
                    }
                }
            }
        });

        // ==================== ОБЩИЕ ФУНКЦИИ ====================
        function updateCounters() {
            const flightCount = document.querySelectorAll('.flight-item').length;
            const trainCount = document.querySelectorAll('.train-item').length;
            const hotelCount = document.querySelectorAll('.hotel-item').length;

            const flightTab = document.getElementById('flights-tab');
            const trainTab = document.getElementById('trains-tab');
            const hotelTab = document.getElementById('hotels-tab');

            if (flightTab) {
                const badge = flightTab.querySelector('.badge');
                if (badge) badge.textContent = flightCount;
                if (flightCount === 0) flightTab.disabled = true;
            }

            if (trainTab) {
                const badge = trainTab.querySelector('.badge');
                if (badge) badge.textContent = trainCount;
                if (trainCount === 0) trainTab.disabled = true;
            }

            if (hotelTab) {
                const badge = hotelTab.querySelector('.badge');
                if (badge) badge.textContent = hotelCount;
                if (hotelCount === 0) hotelTab.disabled = true;
            }
        }

        // Кнопка "Показать еще" для авиабилетов
                // Кнопка "Показать еще" и инициализация фильтров
        document.addEventListener('DOMContentLoaded', function() {
            // ========== АВИАБИЛЕТЫ ==========
            const flightItems = document.querySelectorAll('.flight-item');
            const loadMoreFlightsBtn = document.getElementById('loadMoreFlightsBtn');

            if (loadMoreFlightsBtn && flightItems.length > 10) {
                flightItems.forEach((item, index) => {
                    if (index >= 10) item.style.display = 'none';
                });

                loadMoreFlightsBtn.addEventListener('click', function() {
                    const hiddenItems = document.querySelectorAll('.flight-item[style*="display: none"]');
                    const toShow = Math.min(10, hiddenItems.length);

                    for (let i = 0; i < toShow; i++) {
                        hiddenItems[i].style.display = '';
                    }

                    if (document.querySelectorAll('.flight-item[style*="display: none"]').length === 0) {
                        loadMoreFlightsBtn.style.display = 'none';
                    }
                });
            }

            // ========== ЖД БИЛЕТЫ ==========
            const trainItems = document.querySelectorAll('.train-item');
            const loadMoreTrainsBtn = document.getElementById('loadMoreTrainsBtn');

            if (loadMoreTrainsBtn && trainItems.length > 10) {
                trainItems.forEach((item, index) => {
                    if (index >= 10) item.style.display = 'none';
                });

                loadMoreTrainsBtn.addEventListener('click', function() {
                    const hiddenItems = document.querySelectorAll('.train-item[style*="display: none"]');
                    const toShow = Math.min(10, hiddenItems.length);

                    for (let i = 0; i < toShow; i++) {
                        hiddenItems[i].style.display = '';
                    }

                    if (document.querySelectorAll('.train-item[style*="display: none"]').length === 0) {
                        loadMoreTrainsBtn.style.display = 'none';
                    }
                });
            }

            // ========== ОТЕЛИ ==========
            const hotelItems = document.querySelectorAll('.hotel-item');
            const loadMoreHotelsBtn = document.getElementById('loadMoreHotelsBtn');

            if (loadMoreHotelsBtn && hotelItems.length > 10) {
                hotelItems.forEach((item, index) => {
                    if (index >= 10) item.style.display = 'none';
                });

                loadMoreHotelsBtn.addEventListener('click', function() {
                    const hiddenItems = document.querySelectorAll('.hotel-item[style*="display: none"]');
                    const toShow = Math.min(10, hiddenItems.length);

                    for (let i = 0; i < toShow; i++) {
                        hiddenItems[i].style.display = '';
                    }

                    if (document.querySelectorAll('.hotel-item[style*="display: none"]').length === 0) {
                        loadMoreHotelsBtn.style.display = 'none';
                    }
                });
            }

            // ========== АВТОМАТИЧЕСКИЕ ФИЛЬТРЫ ==========
            // Фильтры для авиабилетов
            const flightDirectionFilter = document.getElementById('flightDirectionFilter');
            const flightAirlineFilter = document.getElementById('flightAirlineFilter');
            const flightSortFilter = document.getElementById('flightSortFilter');

            if (flightDirectionFilter) flightDirectionFilter.addEventListener('change', applyFlightFilters);
            if (flightAirlineFilter) flightAirlineFilter.addEventListener('change', applyFlightFilters);
            if (flightSortFilter) flightSortFilter.addEventListener('change', applyFlightFilters);

            // Фильтры для ЖД билетов
            const trainDirectionFilter = document.getElementById('trainDirectionFilter');
            const trainSortFilter = document.getElementById('trainSortFilter');

            if (trainDirectionFilter) trainDirectionFilter.addEventListener('change', applyTrainFilters);
            if (trainSortFilter) trainSortFilter.addEventListener('change', applyTrainFilters);

            // Фильтры для отелей
            const hotelTypeFilter = document.getElementById('hotelTypeFilter');
            const hotelSortFilter = document.getElementById('hotelSortFilter');

            if (hotelTypeFilter) hotelTypeFilter.addEventListener('change', applyHotelFilters);
            if (hotelSortFilter) hotelSortFilter.addEventListener('change', applyHotelFilters);

            // Применяем фильтры при загрузке страницы
            if (typeof applyFlightFilters === 'function') applyFlightFilters();
            if (typeof applyTrainFilters === 'function') applyTrainFilters();
            if (typeof applyHotelFilters === 'function') applyHotelFilters();
        });

        // Функция показа уведомлений
        function showNotification(message, type = 'info') {
            const oldNotifications = document.querySelectorAll('.notification-alert');
            oldNotifications.forEach(notification => notification.remove());

            const notification = document.createElement('div');
            notification.className = `notification-alert alert alert-${type} alert-dismissible fade show position-fixed`;
            notification.style.cssText = `
                top: 20px;
                right: 20px;
                z-index: 9999;
                min-width: 300px;
            `;

            notification.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-info-circle'} me-2"></i>
                    <div>${message}</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            `;

            document.body.appendChild(notification);
            setTimeout(() => {
                if (notification.parentElement) notification.remove();
            }, 5000);
        }
    </script>
}