@using TripWise.Models
@model Tuple<List<FavoriteFlight>, List<FavoriteTrain>, List<FavoriteHotel>>
@{
    ViewData["Title"] = "Избранное";
    var flights = Model?.Item1 ?? new List<FavoriteFlight>();
    var trains = Model?.Item2 ?? new List<FavoriteTrain>();
    var hotels = Model?.Item3 ?? new List<FavoriteHotel>();
    var userId = Context.Session.GetInt32("UserId");
}
<div class="mobile-header-spacer d-block d-lg-none" style="height: 70px;"></div>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы с выделением -->
            <div class="page-header-section mb-5">
    <div class="page-header-icon">
        <i class="fas fa-heart text-white"></i>
    </div>
    <div class="page-header-content">
        <h1 class="page-title">Избранное</h1>
        <p class="page-subtitle">Сохраненные авиабилеты, ЖД билеты и отели</p>
    </div>
</div>

            @if (!userId.HasValue)
            {
                <div class="card shadow-lg border-0">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-lock text-muted mb-3" style="font-size: 3rem;"></i>
                        <h4 class="mb-3">Доступ ограничен</h4>
                        <p class="text-muted mb-4">
                            Для просмотра избранного необходимо войти в систему.
                        </p>
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4">
                                <i class="fas fa-sign-in-alt me-2"></i>Войти
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4">
                                <i class="fas fa-user-plus me-2"></i>Зарегистрироваться
                            </a>
                        </div>
                    </div>
                </div>
            }
            else if (flights.Count == 0 && trains.Count == 0 && hotels.Count == 0)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-heart text-muted mb-3" style="font-size: 3rem;"></i>
                        <h5>Пока ничего нет в избранном</h5>
                        <p class="text-muted mb-4">
                            Сохраняйте понравившиеся направления, нажимая на сердечко<br>
                            при поиске билетов и отелей.
                        </p>
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a asp-controller="Flights" asp-action="Index" class="btn btn-primary btn-lg">
                                <i class="fas fa-plane me-2"></i>Найти авиабилеты
                            </a>
                            <a asp-controller="Home" asp-action="Railway" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-train me-2"></i>Найти ЖД билеты
                            </a>
                            <a asp-controller="Home" asp-action="Hotels" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-hotel me-2"></i>Найти отели
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Вкладки для переключения -->
                <ul class="nav nav-tabs mb-4" id="favoritesTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(flights.Count > 0 ? "active" : "")"
                                id="flights-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#flights"
                                type="button"
                                role="tab"
                        @(flights.Count == 0 ? "disabled" : "")>
                            <i class="fas fa-plane me-2"></i>
                            Авиабилеты
                            <span class="badge bg-primary ms-2">@flights.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(flights.Count == 0 && trains.Count > 0 ? "active" : "")"
                                id="trains-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#trains"
                                type="button"
                                role="tab"
                        @(trains.Count == 0 ? "disabled" : "")>
                            <i class="fas fa-train me-2"></i>
                            ЖД билеты
                            <span class="badge bg-primary ms-2">@trains.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(flights.Count == 0 && trains.Count == 0 && hotels.Count > 0 ? "active" : "")"
                                id="hotels-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#hotels"
                                type="button"
                                role="tab"
                        @(hotels.Count == 0 ? "disabled" : "")>
                            <i class="fas fa-hotel me-2"></i>
                            Отели
                            <span class="badge bg-primary ms-2">@hotels.Count</span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="favoritesTabContent">
                    <!-- Вкладка с авиабилетами -->
                    <div class="tab-pane fade @(flights.Count > 0 ? "show active" : "")"
                         id="flights"
                         role="tabpanel"
                         aria-labelledby="flights-tab">

                        @if (flights.Count > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <p class="lead mb-0">Сохраненные рейсы</p>
                            </div>

                            <div class="row">
                                <!-- Фильтры для авиабилетов -->
                                <div class="col-md-3 mb-4">
                                    <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                                        <div class="card-body">
                                            <h6 class="card-title mb-3">
                                                <i class="fas fa-filter me-2"></i>Фильтры
                                            </h6>

                                            <div class="mb-3">
                                                <label class="form-label small text-muted mb-2">Направления</label>
                                                <select class="form-select" id="flightDirectionFilter">
                                                    <option value="">Все направления</option>
                                                    @foreach (var direction in flights.Select(f => $"{f.DepartureCity} → {f.ArrivalCity}").Distinct())
                                                    {
                                                        <option value="@direction">@direction</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small text-muted mb-2">Авиакомпании</label>
                                                <select class="form-select" id="flightAirlineFilter">
                                                    <option value="">Все авиакомпании</option>
                                                    @foreach (var airline in flights.Select(f => f.Airline).Distinct())
                                                    {
                                                        <option value="@airline">@airline</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small text-muted mb-2">Сортировка</label>
                                                <select class="form-select" id="flightSortFilter">
                                                    <option value="date">По дате добавления</option>
                                                    <option value="price_asc">По цене (дешевые)</option>
                                                    <option value="price_desc">По цене (дорогие)</option>
                                                    <option value="date_asc">По дате вылета</option>
                                                </select>
                                            </div>

                                            <button class="btn btn-outline-secondary w-100" onclick="resetFlightFilters()">
                                                <i class="fas fa-undo-alt me-2"></i>Сбросить
                                            </button>

                                            <hr class="my-3">

                                            <div class="small text-muted">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span>Всего рейсов:</span>
                                                    <strong id="flightTotalCount">@flights.Count</strong>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <span>Показано:</span>
                                                    <strong id="flightVisibleCount">@flights.Count</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Список избранных рейсов -->
                                <div class="col-md-9">
                                    <div id="flightFavoritesList">
                                        @foreach (var flight in flights)
                                        {
                                            <div class="card shadow-sm border-0 mb-3 flight-item"
                                                 data-direction="@($"{flight.DepartureCity} → {flight.ArrivalCity}")"
                                                 data-airline="@flight.Airline"
                                                 data-price="@flight.Price"
                                                 data-date="@flight.AddedDate.Ticks"
                                                 data-departure="@flight.DepartureTime.Ticks"
                                                 data-flight-id="@flight.FlightId">
                                                <div class="card-body">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-8">
                                                            <div class="d-flex align-items-start">
                                                                <div class="me-3">
                                                                    @if (flight.IsReturn)
                                                                    {
                                                                        <span class="badge bg-success">Обратно</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-primary">Туда</span>
                                                                    }
                                                                </div>
                                                                <div>
                                                                    <h5 class="mb-1">
                                                                        @flight.DepartureCity → @flight.ArrivalCity
                                                                    </h5>
                                                                    <div class="d-flex align-items-center mb-2">
                                                                        <span class="me-3">
                                                                            <i class="fas fa-plane text-muted me-1"></i>
                                                                            @flight.Airline (@flight.FlightNumber)
                                                                        </span>
                                                                        <span class="me-3">
                                                                            <i class="fas fa-chair text-muted me-1"></i>
                                                                            @flight.Aircraft
                                                                        </span>
                                                                        <span>
                                                                            <i class="fas fa-exchange-alt text-muted me-1"></i>
                                                                            @(flight.Transfers == 0 ? "Прямой" : $"{flight.Transfers} пересадки")
                                                                        </span>
                                                                    </div>
                                                                    <div class="d-flex align-items-center text-muted small">
                                                                        <span class="me-3">
                                                                            <i class="far fa-calendar me-1"></i>
                                                                            @flight.DepartureTime.ToString("dd.MM.yyyy")
                                                                        </span>
                                                                        <span class="me-3">
                                                                            <i class="far fa-clock me-1"></i>
                                                                            @flight.DepartureTime.ToString("HH:mm") → @flight.ArrivalTime.ToString("HH:mm")
                                                                        </span>
                                                                        <span>
                                                                            <i class="fas fa-hourglass-half me-1"></i>
                                                                            @(flight.Duration / 60)ч @(flight.Duration % 60)м
                                                                        </span>
                                                                    </div>
                                                                    <div class="mt-2">
                                                                        <small class="text-muted">
                                                                            <i class="far fa-calendar-plus me-1"></i>
                                                                            Добавлен: @flight.AddedDate.ToString("dd.MM.yyyy")
                                                                        </small>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-4">
                                                            <div class="d-flex flex-column align-items-end">
                                                                <div class="mb-3 text-end">
                                                                    <h4 class="text-primary mb-0">@flight.Price.ToString("N0") @flight.Currency</h4>
                                                                    <small class="text-muted">за пассажира</small>
                                                                </div>
                                                                <div class="d-flex gap-2">
                                                                    <a href="@Url.Action("Book", "FlightBooking", new {
    flightId = flight.FlightId,
    airline = flight.Airline,
    airlineCode = flight.AirlineCode ?? "",
    airlineLogo = "",
    flightNumber = flight.FlightNumber,
    departureCity = flight.DepartureCity,
    arrivalCity = flight.ArrivalCity,
    departureAirport = flight.DepartureAirport ?? "MOW",
    arrivalAirport = flight.ArrivalAirport ?? "LED",
    departureDateTime = flight.DepartureTime.ToString("yyyy-MM-ddTHH:mm:ss"),
    arrivalDateTime = flight.ArrivalTime.ToString("yyyy-MM-ddTHH:mm:ss"),
    price = flight.Price,
    duration = flight.Duration,
    transfers = flight.Transfers,
    aircraft = flight.Aircraft ?? "Boeing 737",
    baggage = "1x23кг",
    handLuggage = "1x10кг",
    meal = "Включено",
    flightClass = "Economy",
    isRoundTrip = flight.IsReturn,
    passengers = 1,
    returnFlightId = "",
    returnAirline = "",
    returnFlightNumber = "",
    returnDepartureDateTime = "",
    returnArrivalDateTime = "",
    returnDuration = 0,
    returnTransfers = 0
})" class="btn btn-primary">
                                                                        <i class="fas fa-shopping-cart me-2"></i>Купить
                                                                    </a>
                                                                    <button class="btn btn-outline-danger remove-flight-favorite"
                                                                            data-flight-id="@flight.FlightId">
                                                                        <i class="fas fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @if (flights.Count > 10)
                                    {
                                        <div class="text-center mt-4">
                                            <button class="btn btn-outline-primary" id="loadMoreFlightsBtn">
                                                <i class="fas fa-chevron-down me-2"></i>Показать еще
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Вкладка с ЖД билетами -->
                    <div class="tab-pane fade @(flights.Count == 0 && trains.Count > 0 ? "show active" : "")"
                         id="trains"
                         role="tabpanel"
                         aria-labelledby="trains-tab">

                        @if (trains.Count > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <p class="lead mb-0">Сохраненные поезда</p>
                            </div>

                            <div class="row">
                                <!-- Фильтры для ЖД билетов -->
                                <div class="col-md-3 mb-4">
                                    <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                                        <div class="card-body">
                                            <h6 class="card-title mb-3">
                                                <i class="fas fa-filter me-2"></i>Фильтры
                                            </h6>

                                            <div class="mb-3">
                                                <label class="form-label small text-muted mb-2">Направления</label>
                                                <select class="form-select" id="trainDirectionFilter">
                                                    <option value="">Все направления</option>
                                                    @foreach (var direction in trains.Select(t => $"{t.DepartureStation} → {t.ArrivalStation}").Distinct())
                                                    {
                                                        <option value="@direction">@direction</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small text-muted mb-2">Сортировка</label>
                                                <select class="form-select" id="trainSortFilter">
                                                    <option value="date">По дате добавления</option>
                                                    <option value="price_asc">По цене (дешевые)</option>
                                                    <option value="price_desc">По цене (дорогие)</option>
                                                    <option value="date_asc">По дате отправления</option>
                                                </select>
                                            </div>

                                            <button class="btn btn-outline-secondary w-100" onclick="resetTrainFilters()">
                                                <i class="fas fa-undo-alt me-2"></i>Сбросить
                                            </button>

                                            <hr class="my-3">

                                            <div class="small text-muted">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span>Всего поездов:</span>
                                                    <strong id="trainTotalCount">@trains.Count</strong>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <span>Показано:</span>
                                                    <strong id="trainVisibleCount">@trains.Count</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Список избранных поездов -->
                                <div class="col-md-9">
                                    <div id="trainFavoritesList">
                                        @foreach (var train in trains)
                                        {
                                            // ПРИНУДИТЕЛЬНАЯ КОНВЕРТАЦИЯ ДАТ ИЗ UTC В ЛОКАЛЬНОЕ ВРЕМЯ
                                            DateTime departureLocal;
                                            DateTime arrivalLocal;
                                            DateTime addedLocal;

                                            try
                                            {
                                                departureLocal = TimeZoneInfo.ConvertTimeFromUtc(train.DepartureDateTime, TimeZoneInfo.Local);
                                            }
                                            catch
                                            {
                                                departureLocal = train.DepartureDateTime;
                                            }

                                            try
                                            {
                                                arrivalLocal = TimeZoneInfo.ConvertTimeFromUtc(train.ArrivalDateTime, TimeZoneInfo.Local);
                                            }
                                            catch
                                            {
                                                arrivalLocal = train.ArrivalDateTime;
                                            }

                                            try
                                            {
                                                addedLocal = TimeZoneInfo.ConvertTimeFromUtc(train.AddedDate, TimeZoneInfo.Local);
                                            }
                                            catch
                                            {
                                                addedLocal = train.AddedDate;
                                            }

                                            DateTime? returnDepartureLocal = null;
                                            DateTime? returnArrivalLocal = null;

                                            if (train.ReturnDepartureDateTime.HasValue)
                                            {
                                                try
                                                {
                                                    returnDepartureLocal = TimeZoneInfo.ConvertTimeFromUtc(train.ReturnDepartureDateTime.Value, TimeZoneInfo.Local);
                                                }
                                                catch
                                                {
                                                    returnDepartureLocal = train.ReturnDepartureDateTime.Value;
                                                }
                                            }

                                            if (train.ReturnArrivalDateTime.HasValue)
                                            {
                                                try
                                                {
                                                    returnArrivalLocal = TimeZoneInfo.ConvertTimeFromUtc(train.ReturnArrivalDateTime.Value, TimeZoneInfo.Local);
                                                }
                                                catch
                                                {
                                                    returnArrivalLocal = train.ReturnArrivalDateTime.Value;
                                                }
                                            }

                                            <div class="card shadow-sm border-0 mb-3 train-item"
                                                 data-direction="@($"{train.DepartureStation} → {train.ArrivalStation}")"
                                                 data-price="@train.Price"
                                                 data-date="@train.AddedDate.Ticks"
                                                 data-departure="@train.DepartureDateTime.Ticks"
                                                 data-train-group-id="@train.TrainGroupId">
                                                <div class="card-body">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-8">
                                                            <div class="d-flex align-items-start">
                                                                <div class="me-3">
                                                                    @if (train.IsRoundTrip)
                                                                    {
                                                                        <span class="badge bg-success">Туда и обратно</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-primary">В одну сторону</span>
                                                                    }
                                                                </div>
                                                                <div>
                                                                    <h5 class="mb-1">
                                                                        @train.DepartureStation → @train.ArrivalStation
                                                                    </h5>
                                                                    <div class="d-flex align-items-center mb-2">
                                                                        <span class="me-3">
                                                                            <i class="fas fa-train text-muted me-1"></i>
                                                                            Поезд № @train.ForwardTrainNumber
                                                                            @if (!string.IsNullOrEmpty(train.ReturnTrainNumber))
                                                                            {
                                                                                <span>и № @train.ReturnTrainNumber</span>
                                                                            }
                                                                        </span>
                                                                        @if (train.IsFirm)
                                                                        {
                                                                            <span class="badge bg-warning">Фирменный</span>
                                                                        }
                                                                    </div>
                                                                    <div class="d-flex align-items-center text-muted small">
                                                                        <span class="me-3">
                                                                            <i class="far fa-calendar me-1"></i>
                                                                            @departureLocal.ToString("dd.MM.yyyy HH:mm")
                                                                        </span>
                                                                        <span class="me-3">
                                                                            <i class="fas fa-arrow-right me-1"></i>
                                                                            @arrivalLocal.ToString("dd.MM.yyyy HH:mm")
                                                                        </span>
                                                                        <span>
                                                                            <i class="fas fa-hourglass-half me-1"></i>
                                                                            @(train.Duration / 60)ч @(train.Duration % 60)м
                                                                        </span>
                                                                    </div>
                                                                    @if (train.IsRoundTrip && returnDepartureLocal.HasValue)
                                                                    {
                                                                        <div class="d-flex align-items-center text-muted small mt-1">
                                                                            <span class="me-3">
                                                                                <i class="fas fa-undo me-1"></i>
                                                                                Обратно: @returnDepartureLocal.Value.ToString("dd.MM.yyyy HH:mm")
                                                                            </span>
                                                                        </div>
                                                                    }
                                                                    <div class="mt-2">
                                                                        <small class="text-muted">
                                                                            <i class="far fa-calendar-plus me-1"></i>
                                                                            Добавлен: @addedLocal.ToString("dd.MM.yyyy")
                                                                        </small>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-4">
                                                            <div class="d-flex flex-column align-items-end">
                                                                <div class="mb-3 text-end">
                                                                    <h4 class="text-primary mb-0">@train.Price.ToString("N0") @train.Currency</h4>
                                                                    <small class="text-muted">за пассажира</small>
                                                                </div>
                                                                <div class="d-flex gap-2">
                                                                    <a href="@Url.Action("Book", "TrainBooking", new {
    trainNumber = train.ForwardTrainNumber,
    returnTrainNumber = train.ReturnTrainNumber,
    departureStationId = train.DepartureStationId,
    departureStationName = train.DepartureStation,
    arrivalStationId = train.ArrivalStationId,
    arrivalStationName = train.ArrivalStation,
    departureDateTime = departureLocal.ToString("yyyy-MM-ddTHH:mm:ss"),
    arrivalDateTime = arrivalLocal.ToString("yyyy-MM-ddTHH:mm:ss"),
    returnDepartureDateTime = (train.IsRoundTrip && returnDepartureLocal.HasValue) ? returnDepartureLocal.Value.ToString("yyyy-MM-ddTHH:mm:ss") : null,
    returnArrivalDateTime = (train.IsRoundTrip && returnArrivalLocal.HasValue) ? returnArrivalLocal.Value.ToString("yyyy-MM-ddTHH:mm:ss") : null,
    price = train.Price.ToString(System.Globalization.CultureInfo.InvariantCulture),
    passengers = train.Passengers,
    carType = "coupe",
    carClass = "2К",
    duration = train.Duration,
    returnDuration = train.ReturnDuration,
    isRoundTrip = train.IsRoundTrip,
    trainBrand = train.TrainBrand ?? "",
    carrier = train.Carrier ?? ""
})" class="btn btn-primary">
                                                                        <i class="fas fa-shopping-cart me-2"></i>Купить
                                                                    </a>
                                                                    <button class="btn btn-outline-danger remove-train-favorite"
                                                                            data-train-group-id="@train.TrainGroupId">
                                                                        <i class="fas fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @if (trains.Count > 10)
                                    {
                                        <div class="text-center mt-4">
                                            <button class="btn btn-outline-primary" id="loadMoreTrainsBtn">
                                                <i class="fas fa-chevron-down me-2"></i>Показать еще
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Вкладка с отелями -->
                    <div class="tab-pane fade @(flights.Count == 0 && trains.Count == 0 && hotels.Count > 0 ? "show active" : "")"
                         id="hotels"
                         role="tabpanel"
                         aria-labelledby="hotels-tab">

                        @if (hotels.Count > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <p class="lead mb-0">Сохраненные отели</p>
                            </div>

                            <div class="row">
                                <!-- Фильтры для отелей -->
                                <div class="col-md-3 mb-4">
                                    <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                                        <div class="card-body">
                                            <h6 class="card-title mb-3">
                                                <i class="fas fa-filter me-2"></i>Фильтры
                                            </h6>

                                            <div class="mb-3">
                                                <label class="form-label small text-muted mb-2">Тип жилья</label>
                                                <select class="form-select" id="hotelTypeFilter">
                                                    <option value="">Все типы</option>
                                                    @foreach (var type in hotels.Select(h => h.AccommodationType).Where(t => !string.IsNullOrEmpty(t)).Distinct())
                                                    {
                                                        <option value="@type">@type</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small text-muted mb-2">Сортировка</label>
                                                <select class="form-select" id="hotelSortFilter">
                                                    <option value="date">По дате добавления</option>
                                                    <option value="price_asc">По цене (дешевые)</option>
                                                    <option value="price_desc">По цене (дорогие)</option>
                                                    <option value="name">По названию</option>
                                                </select>
                                            </div>

                                            <button class="btn btn-outline-secondary w-100" onclick="resetHotelFilters()">
                                                <i class="fas fa-undo-alt me-2"></i>Сбросить
                                            </button>

                                            <hr class="my-3">

                                            <div class="small text-muted">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span>Всего отелей:</span>
                                                    <strong id="hotelTotalCount">@hotels.Count</strong>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <span>Показано:</span>
                                                    <strong id="hotelVisibleCount">@hotels.Count</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Список избранных отелей -->
                                <div class="col-md-9">
                                    <div id="hotelFavoritesList">
                                        @foreach (var hotel in hotels)
                                        {
                                            <div class="card shadow-sm border-0 mb-3 hotel-item"
                                                 data-hotel-id="@hotel.HotelId"
                                                 data-type="@hotel.AccommodationType"
                                                 data-price="@hotel.PricePerNight"
                                                 data-name="@hotel.HotelName"
                                                 data-date="@hotel.AddedDate.Ticks">
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-8">
                                                            <div class="d-flex align-items-start">
                                                                <div class="me-3">
                                                                    @if (!string.IsNullOrEmpty(hotel.AccommodationType))
                                                                    {
                                                                        <span class="badge bg-info">@hotel.AccommodationType</span>
                                                                    }
                                                                    @if (hotel.Stars.HasValue && hotel.Stars > 0)
                                                                    {
                                                                        <div class="mt-1">
                                                                            @for (int i = 0; i < hotel.Stars.Value; i++)
                                                                            {
                                                                                <i class="fas fa-star text-warning small"></i>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <div>
                                                                    <h5 class="mb-1">@hotel.HotelName</h5>
                                                                    @if (!string.IsNullOrEmpty(hotel.HotelAddress))
                                                                    {
                                                                        <p class="small text-muted mb-1">
                                                                            <i class="fas fa-map-marker-alt me-1"></i>@hotel.HotelAddress
                                                                        </p>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(hotel.Phone) && hotel.Phone != "Не указан")
                                                                    {
                                                                        <p class="small text-muted mb-1">
                                                                            <i class="fas fa-phone me-1"></i>@hotel.Phone
                                                                        </p>
                                                                    }
                                                                    @if (hotel.PricePerNight.HasValue)
                                                                    {
                                                                        <p class="fw-bold text-primary mt-2 mb-0">
                                                                            от @hotel.PricePerNight.Value.ToString("N0") @hotel.Currency / ночь
                                                                        </p>
                                                                    }
                                                                    <div class="mt-2">
                                                                        <small class="text-muted">
                                                                            <i class="far fa-calendar-plus me-1"></i>
                                                                            Добавлен: @hotel.AddedDate.ToString("dd.MM.yyyy")
                                                                        </small>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="d-flex flex-column align-items-end">
                                                                <div class="d-flex gap-2 mt-2 mt-md-0">
                                                                    @if (!string.IsNullOrEmpty(hotel.Website))
                                                                    {
                                                                        <a href="@hotel.Website" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                            <i class="fas fa-external-link-alt"></i>
                                                                        </a>
                                                                    }
                                                                    <!-- КНОПКА ЗАБРОНИРОВАТЬ - ведет на страницу бронирования отеля -->
                                                                    <a href="@Url.Action("Book", "HotelBooking", new {
    hotelId = hotel.HotelId,
    hotelName = hotel.HotelName,
    hotelAddress = hotel.HotelAddress,
    accommodationType = hotel.AccommodationType,
    stars = hotel.Stars,
    phone = hotel.Phone,
    website = hotel.Website,
    pricePerNight = hotel.PricePerNight,
    currency = hotel.Currency ?? "RUB",
    checkInDate = DateTime.Now.AddDays(1).ToString("yyyy-MM-dd"),
    checkOutDate = DateTime.Now.AddDays(3).ToString("yyyy-MM-dd"),
    guests = 2,
    rooms = 1,
    latitude = hotel.Latitude,
    longitude = hotel.Longitude
})" class="btn btn-primary">
                                                                        <i class="fas fa-calendar-check me-2"></i>Забронировать
                                                                    </a>
                                                                    <button class="btn btn-outline-danger remove-hotel-favorite"
                                                                            data-hotel-id="@hotel.HotelId">
                                                                        <i class="fas fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @if (hotels.Count > 10)
                                    {
                                        <div class="text-center mt-4">
                                            <button class="btn btn-outline-primary" id="loadMoreHotelsBtn">
                                                <i class="fas fa-chevron-down me-2"></i>Показать еще
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

