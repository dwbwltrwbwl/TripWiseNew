<div class="mobile-header-spacer d-block d-lg-none" style="height: 70px;"></div>

@{
    ViewData["Title"] = "Мои заказы";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-ticket-alt text-white"></i>
                </div>
                <div class="page-header-content">
                    <h1 class="page-title">
                        Мои заказы
                    </h1>
                    <p class="page-subtitle">История ваших бронирований авиабилетов, ж/д билетов и отелей</p>
                </div>
            </div>

            <!-- Вкладки для фильтрации по типу -->
            <div class="order-tabs-wrapper">
                <ul class="nav nav-tabs mb-4" id="orderTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab">
                            <i class="fas fa-list me-2"></i><span class="tab-text">Все заказы</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="flights-tab" data-bs-toggle="tab" data-bs-target="#flights" type="button" role="tab">
                            <i class="fas fa-plane me-2"></i><span class="tab-text">Авиабилеты</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="trains-tab" data-bs-toggle="tab" data-bs-target="#trains" type="button" role="tab">
                            <i class="fas fa-train me-2"></i><span class="tab-text">ЖД билеты</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="hotels-tab" data-bs-toggle="tab" data-bs-target="#hotels" type="button" role="tab">
                            <i class="fas fa-hotel me-2"></i><span class="tab-text">Отели</span>
                        </button>
                    </li>
                </ul>
            </div>

            <!-- Фильтр по статусам -->
            <div class="status-filter mb-4">
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn status-filter-btn active" data-status="all">
                        <i class="fas fa-list me-1"></i>Все
                    </button>
                    <button class="btn status-filter-btn" data-status="pending">
                        <i class="fas fa-clock me-1"></i>Ожидает оплаты
                    </button>
                    <button class="btn status-filter-btn" data-status="confirmed">
                        <i class="fas fa-check-circle me-1"></i>Подтверждены
                    </button>
                    <button class="btn status-filter-btn" data-status="cancelled">
                        <i class="fas fa-times-circle me-1"></i>Отменены
                    </button>
                </div>
            </div>

            <!-- Содержимое вкладок -->
            <div class="tab-content" id="orderTabsContent">
                <div class="tab-pane fade show active" id="all" role="tabpanel">
                    <div id="ordersContainerAll">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <p class="mt-3 text-muted">Загрузка ваших заказов...</p>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="flights" role="tabpanel">
                    <div id="ordersContainerFlights">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <p class="mt-3 text-muted">Загрузка авиабилетов...</p>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="trains" role="tabpanel">
                    <div id="ordersContainerTrains">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <p class="mt-3 text-muted">Загрузка ж/д билетов...</p>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="hotels" role="tabpanel">
                    <div id="ordersContainerHotels">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <p class="mt-3 text-muted">Загрузка бронирований отелей...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для оплаты -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #0379D9, #40B624);">
                <h5 class="modal-title text-white">
                    <i class="fas fa-credit-card me-2"></i>Оплата заказа
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="fw-bold fs-3 text-primary" id="paymentAmount">0 ₽</div>
                </div>

                <form id="paymentForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Номер карты</label>
                        <input type="text" class="form-control form-control-lg" id="cardNumber"
                               placeholder="0000 0000 0000 0000" maxlength="19">
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Срок действия</label>
                            <input type="text" class="form-control" id="cardExpiry"
                                   placeholder="ММ/ГГ" maxlength="5">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">CVV/CVC</label>
                            <input type="password" class="form-control" id="cardCvv"
                                   placeholder="***" maxlength="3">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Владелец карты</label>
                        <input type="text" class="form-control form-control-lg" id="cardHolder"
                               placeholder="ИМЯ ФАМИЛИЯ" maxlength="200">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Отмена
                </button>
                <button type="button" class="btn btn-success btn-lg" id="confirmPaymentBtn">
                    <i class="fas fa-check me-2"></i>Оплатить
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Стили для заголовка страницы (унифицированные) */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

        .page-header-icon i {
            color: white !important;
        }

    .page-header-content {
        flex: 1;
        min-width: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
        word-break: break-word;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        line-height: 1.4;
        word-break: break-word;
    }

    /* Стили для вкладок */
    .order-tabs-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 1rem;
    }

    .nav-tabs {
        display: flex;
        flex-wrap: nowrap;
        border-bottom: 2px solid #e2e8f0;
        gap: 8px;
        min-width: max-content;
    }

        .nav-tabs .nav-item {
            list-style: none;
        }

        .nav-tabs .nav-link {
            border: none;
            color: #64748b;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: 12px;
            transition: all 0.3s ease;
            font-family: 'Nunito', sans-serif;
            white-space: nowrap;
        }

            .nav-tabs .nav-link:hover {
                background-color: #f8fafc;
                color: #0379D9;
            }

            .nav-tabs .nav-link.active {
                background: linear-gradient(135deg, #0379D9, #40B624);
                color: white;
                box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
            }

    /* Стили для фильтра статусов */
    .status-filter {
        padding: 0 0 15px 0;
        border-bottom: 2px solid #e2e8f0;
        margin-bottom: 20px;
    }

    .status-filter-btn {
        background: white;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-weight: 600;
        padding: 8px 20px;
        border-radius: 30px;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

        .status-filter-btn:hover {
            background-color: #f8fafc;
            color: #0379D9;
            border-color: #0379D9;
        }

        .status-filter-btn.active {
            background: linear-gradient(135deg, #0379D9, #40B624);
            color: white;
            border-color: transparent;
        }

    /* Стили для карточек заказов */
    .order-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        margin-bottom: 20px;
        background: white;
    }

        .order-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

    .order-header {
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-radius: 16px 16px 0 0;
        padding: 16px 24px;
        border-bottom: 1px solid #e2e8f0;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-confirmed {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #842029;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 0.85rem;
        border-radius: 8px;
    }

    .btn-outline-primary {
        border: 1px solid #0379D9;
        color: #0379D9;
        background: transparent;
    }

        .btn-outline-primary:hover {
            background: #0379D9;
            color: white;
        }

    .btn-outline-danger {
        border: 1px solid #dc3545;
        color: #dc3545;
        background: transparent;
    }

        .btn-outline-danger:hover {
            background: #dc3545;
            color: white;
        }

    .btn-outline-secondary {
        border: 1px solid #6c757d;
        color: #6c757d;
        background: transparent;
    }

        .btn-outline-secondary:hover {
            background: #6c757d;
            color: white;
        }

    /* Мобильная адаптация для карточек */
    @@media (max-width: 768px) {
        .page-header-section {
            padding: 20px;
            gap: 15px;
        }

            .page-header-section::before {
                width: 100%;
                height: 6px;
                top: 0;
                left: 0;
                background: linear-gradient(to right, #0379D9, #40B624);
            }

        .page-header-icon {
            width: 55px;
            height: 55px;
            font-size: 1.5rem;
        }

        .page-title {
            font-size: 1.6rem;
            margin-bottom: 4px;
        }

        .page-subtitle {
            font-size: 0.95rem;
        }

        .order-header {
            flex-direction: column;
            text-align: center;
            gap: 10px;
            padding: 12px 16px;
        }

        .order-card .p-4 {
            padding: 1rem !important;
        }

        .order-card .row {
            flex-direction: column;
            gap: 15px;
        }

        .order-card .col-md-8 {
            text-align: center;
        }

        .order-card .col-md-4 {
            text-align: center !important;
        }

        .fs-4 {
            font-size: 1.3rem !important;
        }

        .nav-tabs .nav-link {
            padding: 8px 16px;
            font-size: 0.85rem;
        }

            .nav-tabs .nav-link i {
                font-size: 0.9rem;
            }

        .status-filter-btn {
            padding: 6px 14px;
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .page-header-section {
            padding: 15px;
            gap: 12px;
        }

        .page-header-icon {
            width: 48px;
            height: 48px;
            font-size: 1.3rem;
        }

        .page-title {
            font-size: 1.4rem;
        }

        .page-subtitle {
            font-size: 0.85rem;
        }

        .order-header h5 {
            font-size: 1rem;
        }

        .order-header small {
            font-size: 0.7rem;
        }

        .status-badge {
            padding: 4px 10px;
            font-size: 0.7rem;
        }

        .fw-semibold {
            font-size: 0.9rem;
        }

        .text-muted.small {
            font-size: 0.7rem;
        }

        .btn-sm {
            padding: 5px 10px;
            font-size: 0.75rem;
        }

        .nav-tabs .nav-link {
            padding: 6px 12px;
            font-size: 0.8rem;
        }

        .status-filter-btn {
            padding: 4px 10px;
            font-size: 0.7rem;
        }
    }
    /* Стили для поля владельца карты */
    #cardHolder.is-invalid {
        border-color: #dc3545;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
</style>

@section Scripts {
    <script>
        let allOrdersData = [];
        let flightOrdersData = [];
        let trainOrdersData = [];
        let hotelOrdersData = [];
        let currentStatusFilter = 'all';
        let currentTypeTab = 'all';

        // Инициализация страницы
        document.addEventListener('DOMContentLoaded', function() {
            console.log('MyOrders страница загружена');
            loadAllOrders();

            // Добавляем обработчики для вкладок типов
            document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
                tab.addEventListener('shown.bs.tab', function(e) {
                    const target = e.target.getAttribute('data-bs-target');
                    if (target === '#flights') {
                        currentTypeTab = 'flight';
                        if (flightOrdersData.length === 0) loadFlightOrders();
                        else applyFiltersAndRender('flights');
                    } else if (target === '#trains') {
                        currentTypeTab = 'train';
                        if (trainOrdersData.length === 0) loadTrainOrders();
                        else applyFiltersAndRender('trains');
                    } else if (target === '#hotels') {
                        currentTypeTab = 'hotel';
                        if (hotelOrdersData.length === 0) loadHotelOrders();
                        else applyFiltersAndRender('hotels');
                    } else {
                        currentTypeTab = 'all';
                        if (allOrdersData.length === 0) loadAllOrders();
                        else applyFiltersAndRender('all');
                    }
                });
            });

            // Добавляем обработчики для фильтра статусов
            document.querySelectorAll('.status-filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.status-filter-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentStatusFilter = this.getAttribute('data-status');
                    applyFiltersAndRender(getCurrentContainerId());
                });
            });
        });

        function getCurrentContainerId() {
            if (currentTypeTab === 'flight') return 'flights';
            if (currentTypeTab === 'train') return 'trains';
            if (currentTypeTab === 'hotel') return 'hotels';
            return 'all';
        }

        function applyFiltersAndRender(containerId) {
            let orders = [];

            if (containerId === 'flights') {
                orders = [...flightOrdersData];
            } else if (containerId === 'trains') {
                orders = [...trainOrdersData];
            } else if (containerId === 'hotels') {
                orders = [...hotelOrdersData];
            } else {
                orders = [...allOrdersData];
            }

            // Фильтрация по статусу
            if (currentStatusFilter !== 'all') {
                orders = orders.filter(order => order.status === currentStatusFilter);
            }

            const container = document.getElementById(`ordersContainer${containerId.charAt(0).toUpperCase() + containerId.slice(1)}`);
            if (orders.length === 0) {
                if (containerId === 'flights') container.innerHTML = getEmptyOrdersHtml('flight');
                else if (containerId === 'trains') container.innerHTML = getEmptyOrdersHtml('train');
                else if (containerId === 'hotels') container.innerHTML = getEmptyOrdersHtml('hotel');
                else container.innerHTML = getEmptyOrdersHtml();
                return;
            }

            renderOrders(orders, container);

            // Обновляем счетчики на кнопках фильтра
            updateStatusFilterCounters(containerId === 'all' ? allOrdersData :
                (containerId === 'flights' ? flightOrdersData :
                (containerId === 'trains' ? trainOrdersData : hotelOrdersData)));
        }

        function updateStatusFilterCounters(orders) {
            const pendingCount = orders.filter(o => o.status === 'pending').length;
            const confirmedCount = orders.filter(o => o.status === 'confirmed').length;
            const cancelledCount = orders.filter(o => o.status === 'cancelled').length;
            const totalCount = orders.length;

            const allBtn = document.querySelector('.status-filter-btn[data-status="all"]');
            const pendingBtn = document.querySelector('.status-filter-btn[data-status="pending"]');
            const confirmedBtn = document.querySelector('.status-filter-btn[data-status="confirmed"]');
            const cancelledBtn = document.querySelector('.status-filter-btn[data-status="cancelled"]');

            if (allBtn) allBtn.innerHTML = `<i class="fas fa-list me-1"></i>Все (${totalCount})`;
            if (pendingBtn) pendingBtn.innerHTML = `<i class="fas fa-clock me-1"></i>Ожидает оплаты (${pendingCount})`;
            if (confirmedBtn) confirmedBtn.innerHTML = `<i class="fas fa-check-circle me-1"></i>Подтверждены (${confirmedCount})`;
            if (cancelledBtn) cancelledBtn.innerHTML = `<i class="fas fa-times-circle me-1"></i>Отменены (${cancelledCount})`;
        }

                async function loadAllOrders() {
            const container = document.getElementById('ordersContainerAll');

            try {
                const response = await fetch('/api/flights/all-orders', {
                    credentials: 'include',
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) {
                    if (response.status === 401) {
                        container.innerHTML = getAuthRequiredHtml();
                        return;
                    }
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                console.log('All orders data:', data); // ← ДОБАВЬТЕ ЭТО
                allOrdersData = data.orders || [];

                updateTabCounters();
                updateStatusFilterCounters(allOrdersData);

                if (allOrdersData.length === 0) {
                    container.innerHTML = getEmptyOrdersHtml();
                    return;
                }

                applyFiltersAndRender('all');

            } catch (error) {
                console.error('Ошибка загрузки заказов:', error);
                container.innerHTML = getErrorHtml(error.message);
            }
        }

        // Загрузка только авиабилетов
        async function loadFlightOrders() {
            const container = document.getElementById('ordersContainerFlights');

            try {
                const response = await fetch('/api/flights/my-orders', {
                    credentials: 'include',
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                const data = await response.json();
                flightOrdersData = data.orders || [];

                if (flightOrdersData.length === 0) {
                    container.innerHTML = getEmptyOrdersHtml('flight');
                    return;
                }

                applyFiltersAndRender('flights');

            } catch (error) {
                console.error('Ошибка загрузки авиабилетов:', error);
                container.innerHTML = getErrorHtml(error.message);
            }
        }

        // Загрузка только ЖД билетов
        async function loadTrainOrders() {
            const container = document.getElementById('ordersContainerTrains');

            try {
                const response = await fetch('/api/flights/my-train-orders', {
                    credentials: 'include',
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                const data = await response.json();
                trainOrdersData = data.orders || [];

                if (trainOrdersData.length === 0) {
                    container.innerHTML = getEmptyOrdersHtml('train');
                    return;
                }

                applyFiltersAndRender('trains');

            } catch (error) {
                console.error('Ошибка загрузки ЖД билетов:', error);
                container.innerHTML = getErrorHtml(error.message);
            }
        }

        // Загрузка только отелей
        async function loadHotelOrders() {
            const container = document.getElementById('ordersContainerHotels');

            try {
                const response = await fetch('/api/flights/my-hotel-bookings', {
                    credentials: 'include',
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                const data = await response.json();
                hotelOrdersData = data.orders || [];

                if (hotelOrdersData.length === 0) {
                    container.innerHTML = getEmptyOrdersHtml('hotel');
                    return;
                }

                applyFiltersAndRender('hotels');

            } catch (error) {
                console.error('Ошибка загрузки отелей:', error);
                container.innerHTML = getErrorHtml(error.message);
            }
        }

        // Обновление счетчиков на вкладках типов
        function updateTabCounters() {
            const flightsCount = allOrdersData.filter(o => o.type === 'flight').length;
