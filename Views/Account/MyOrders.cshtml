                    <div class="d-flex justify-content-center gap-3 mt-3 flex-wrap">
                        <a href="/Home/Flights" class="btn btn-primary"><i class="fas fa-plane me-2"></i>Авиабилеты</a>
                        <a href="/Home/Railway" class="btn btn-primary"><i class="fas fa-train me-2"></i>ЖД билеты</a>
                        <a href="/Home/Hotels" class="btn btn-primary"><i class="fas fa-hotel me-2"></i>Отели</a>
                    </div>
                `;
            }

            return `
                <div class="text-center py-5">
                    <i class="fas ${icon} fa-4x text-muted mb-3"></i>
                    <h4>${title}</h4>
                    <p class="text-muted">Начните поиск и сделайте свой первый заказ!</p>
                    ${buttons}
                </div>
            `;
        }

        function getErrorHtml(message) {
            return `
                <div class="text-center py-5">
                    <i class="fas fa-exclamation-triangle fa-4x text-danger mb-3"></i>
                    <h4>Ошибка загрузки</h4>
                    <p class="text-muted">${message}</p>
                    <button class="btn btn-primary mt-3" onclick="location.reload()">
                        <i class="fas fa-sync-alt me-2"></i>Обновить
                    </button>
                </div>
            `;
        }

        // Просмотр деталей заказа
        async function viewOrderDetails(orderId, type) {
            let url = '';
            if (type === 'flight') {
                url = `/api/flights/order/${orderId}`;
            } else if (type === 'train') {
                url = `/api/flights/train-order/${orderId}`;
            } else if (type === 'hotel') {
                url = `/api/flights/hotel-booking/${orderId}`;
            }

            try {
                const response = await fetch(url, { credentials: 'include' });
                const data = await response.json();

                if (data.success) {
                    const order = data.order;
                    let details = '';

                    if (type === 'flight') {
                        details = `✈️ Детали авиабилета #${order.bookingNumber}\n\n` +
                                  `Авиакомпания: ${order.airline}\n` +
                                  `Рейс: ${order.flightNumber}\n` +
                                  `Маршрут: ${order.departureCity} → ${order.arrivalCity}\n` +
                                  `Вылет: ${new Date(order.departureDateTime).toLocaleString('ru-RU')}\n` +
                                  `Прилет: ${new Date(order.arrivalDateTime).toLocaleString('ru-RU')}\n` +
                                  `Сумма: ${order.price.toLocaleString('ru-RU')} ${order.currency}\n` +
                                  `Статус: ${getStatusText(order.status)}`;
                    } else if (type === 'train') {
                        details = `🚆 Детали ж/д билета #${order.orderNumber}\n\n` +
                                  `Поезд: ${order.trainNumber}\n` +
                                  `Маршрут: ${order.departureStation} → ${order.arrivalStation}\n` +
                                  `Отправление: ${new Date(order.departureDateTime).toLocaleString('ru-RU')}\n` +
                                  `Вагон: ${order.carNumber || '—'}\n` +
                                  `Места: ${order.seatNumbers || '—'}\n` +
                                  `Сумма: ${order.totalPrice.toLocaleString('ru-RU')} ${order.currency}\n` +
                                  `Статус: ${getStatusText(order.status)}`;
                    } else if (type === 'hotel') {
                        details = `🏨 Детали бронирования отеля #${order.bookingNumber}\n\n` +
                                  `Отель: ${order.hotelName}\n` +
                                  `Адрес: ${order.hotelAddress}\n` +
                                  `Заезд: ${new Date(order.checkInDate).toLocaleDateString('ru-RU')}\n` +
                                  `Выезд: ${new Date(order.checkOutDate).toLocaleDateString('ru-RU')}\n` +
                                  `Ночей: ${order.nights}\n` +
                                  `Сумма: ${order.totalPrice.toLocaleString('ru-RU')} ${order.currency}\n` +
                                  `Статус: ${getStatusText(order.status)}`;
                    }

                    alert(details);
                }
            } catch (error) {
                console.error('Error loading order details:', error);
                alert('Ошибка при загрузке деталей заказа');
            }
        }

        // Экспорт функций
        window.loadAllOrders = loadAllOrders;
        window.loadFlightOrders = loadFlightOrders;
        window.loadTrainOrders = loadTrainOrders;
        window.loadHotelOrders = loadHotelOrders;
        window.viewOrderDetails = viewOrderDetails;
        window.cancelOrder = cancelOrder;
        window.downloadTicket = downloadTicket;
    </script>
}

<script>
    // ==================== ОПЛАТА ЗАКАЗА ====================
    let currentPaymentOrder = null;

    function payOrder(orderId, type, amount, currency) {
        currentPaymentOrder = { orderId, type, amount, currency };
        document.getElementById('paymentAmount').innerText = `${amount.toLocaleString('ru-RU')} ${currency}`;

        // Очищаем поля формы
        document.getElementById('cardNumber').value = '';
        document.getElementById('cardExpiry').value = '';
        document.getElementById('cardCvv').value = '';
        document.getElementById('cardHolder').value = '';

        // Показываем модальное окно
        const modalElement = document.getElementById('paymentModal');
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }

    // Валидация имени владельца карты (только буквы, пробелы, дефисы, макс 200 символов)
    function validateCardHolder(name) {
        const value = name ? name.trim() : '';
        if (value.length === 0) {
            return { isValid: false, message: 'Введите имя владельца карты' };
        }
        if (value.length > 200) {
            return { isValid: false, message: 'Имя владельца карты не должно превышать 200 символов' };
        }
        if (/\d/.test(value)) {
            return { isValid: false, message: 'Имя владельца карты не может содержать цифры' };
        }
        if (!/^[a-zA-Zа-яА-ЯёЁ\s\-]+$/.test(value)) {
            return { isValid: false, message: 'Имя владельца карты может содержать только буквы, пробелы и дефисы' };
        }
        return { isValid: true, message: '' };
    }

    // Маски для полей карты
    function initPaymentMasks() {
        const cardNumberInput = document.getElementById('cardNumber');
        if (cardNumberInput) {
            cardNumberInput.addEventListener('input', function(e) {
                let value = this.value.replace(/\D/g, '');
                if (value.length > 16) value = value.slice(0, 16);
                let formatted = '';
                for (let i = 0; i < value.length; i++) {
                    if (i > 0 && i % 4 === 0) formatted += ' ';
                    formatted += value[i];
                }
                this.value = formatted;
            });
        }

        const cardExpiryInput = document.getElementById('cardExpiry');
        if (cardExpiryInput) {
            cardExpiryInput.addEventListener('input', function(e) {
                let value = this.value.replace(/\D/g, '');
                if (value.length > 4) value = value.slice(0, 4);
                if (value.length >= 3) {
                    this.value = value.slice(0, 2) + '/' + value.slice(2);
                } else {
                    this.value = value;
                }
            });
        }

        const cardCvvInput = document.getElementById('cardCvv');
        if (cardCvvInput) {
            cardCvvInput.addEventListener('input', function(e) {
                this.value = this.value.replace(/\D/g, '').slice(0, 3);
            });
        }

        // Валидация имени владельца карты при вводе
        const cardHolderInput = document.getElementById('cardHolder');
        if (cardHolderInput) {
            cardHolderInput.addEventListener('input', function(e) {
                // Удаляем цифры
                this.value = this.value.replace(/\d/g, '');
                // Ограничиваем длину 200 символами
                if (this.value.length > 200) {
                    this.value = this.value.slice(0, 200);
                }
                // Проверяем валидность
                const result = validateCardHolder(this.value);
                if (!result.isValid) {
                    this.classList.add('is-invalid');
                    if (this.nextElementSibling && this.nextElementSibling.classList.contains('invalid-feedback')) {
                        this.nextElementSibling.textContent = result.message;
                    }
                } else {
                    this.classList.remove('is-invalid');
                    if (this.nextElementSibling && this.nextElementSibling.classList.contains('invalid-feedback')) {
                        this.nextElementSibling.textContent = '';
                    }
                }
            });
        }
    }

    // Валидация полей карты
    function validatePaymentForm() {
        const cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
        const cardExpiry = document.getElementById('cardExpiry').value;
        const cardCvv = document.getElementById('cardCvv').value;
        const cardHolder = document.getElementById('cardHolder').value;

        if (!cardNumber || cardNumber.length !== 16) {
            alert('Введите корректный номер карты (16 цифр)');
            return false;
        }
        if (!cardExpiry || cardExpiry.length !== 5) {
            alert('Введите корректный срок действия (ММ/ГГ)');
            return false;
        }
        const [month, year] = cardExpiry.split('/');
        const currentYear = new Date().getFullYear() % 100;
        const currentMonth = new Date().getMonth() + 1;
        if (parseInt(month) < 1 || parseInt(month) > 12) {
            alert('Введите корректный месяц (01-12)');
            return false;
        }
        if (parseInt(year) < currentYear || (parseInt(year) === currentYear && parseInt(month) < currentMonth)) {
            alert('Срок действия карты истек');
            return false;
        }
        if (!cardCvv || cardCvv.length !== 3) {
            alert('Введите CVV код (3 цифры)');
            return false;
        }

        // Валидация имени владельца карты
        const cardHolderResult = validateCardHolder(cardHolder);
        if (!cardHolderResult.isValid) {
            alert(cardHolderResult.message);
            document.getElementById('cardHolder').focus();
            return false;
        }

        return true;
    }

    // Обработчик оплаты
    function initPaymentButton() {
        const confirmBtn = document.getElementById('confirmPaymentBtn');
        if (confirmBtn) {
            confirmBtn.addEventListener('click', async function() {
                if (!currentPaymentOrder) return;
                if (!validatePaymentForm()) return;

                const cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
                const cardHolder = document.getElementById('cardHolder').value;

                const btn = this;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Обработка...';

                setTimeout(async () => {
                    try {
                        const response = await fetch(`/api/flights/pay/${currentPaymentOrder.orderId}`, {
                            method: 'POST',
                            credentials: 'include',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                orderId: currentPaymentOrder.orderId,
                                type: currentPaymentOrder.type,
                                amount: currentPaymentOrder.amount,
                                cardNumber: cardNumber.slice(-4),
                                cardHolder: cardHolder
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert('✅ Оплата прошла успешно!');
                            const modalElement = document.getElementById('paymentModal');
                            const modal = bootstrap.Modal.getInstance(modalElement);
                            if (modal) modal.hide();

                            loadAllOrders();
                            loadFlightOrders();
                            loadTrainOrders();
                            loadHotelOrders();
                        } else {
                            alert(result.message || '❌ Ошибка при оплате');
                        }
                    } catch (error) {
                        console.error('Ошибка:', error);
                        alert('❌ Ошибка при оплате. Попробуйте позже.');
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-check me-2"></i>Оплатить';
                    }
                }, 2000);
            });
        }
    }

    // Инициализация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        initPaymentMasks();
        initPaymentButton();

        // Добавляем подсказку для поля владельца карты
        const cardHolderInput = document.getElementById('cardHolder');
        if (cardHolderInput && !cardHolderInput.nextElementSibling?.classList?.contains('invalid-feedback')) {
            const feedback = document.createElement('div');
            feedback.className = 'invalid-feedback';
            feedback.textContent = 'Только буквы, пробелы и дефисы. Максимум 200 символов.';
            cardHolderInput.parentNode.insertBefore(feedback, cardHolderInput.nextSibling);
        }

        // Добавляем подсказку с лимитом символов
        if (cardHolderInput && !document.getElementById('cardHolderHint')) {
            const hint = document.createElement('small');
            hint.id = 'cardHolderHint';
            hint.className = 'text-muted';
            hint.style.display = 'block';
            hint.style.marginTop = '5px';
            hint.innerHTML = 'Максимум 200 символов. Только буквы, пробелы и дефисы.';
            cardHolderInput.parentNode.insertBefore(hint, cardHolderInput.nextSibling?.nextSibling || null);

            // Счетчик символов
            const counter = document.createElement('small');
            counter.id = 'cardHolderCounter';
            counter.className = 'text-muted ms-2';
            counter.style.float = 'right';
            counter.textContent = '0/200';
            cardHolderInput.parentNode.insertBefore(counter, hint);

            cardHolderInput.addEventListener('input', function() {
                const length = this.value.length;
                const counterEl = document.getElementById('cardHolderCounter');
                if (counterEl) {
                    counterEl.textContent = `${length}/200`;
                    if (length > 200) {
                        counterEl.style.color = '#dc3545';
                    } else {
                        counterEl.style.color = '#6c757d';
                    }
                }
            });
        }
    });
</script>