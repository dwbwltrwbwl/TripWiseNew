@model TripWise.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Редактирование профиля";
}
<div class="mobile-header-spacer d-block d-lg-none" style="height: 70px;"></div>
<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <!-- Заголовок страницы (остается как на десктопе) -->
    <div class="page-header-section mb-5">
        <div class="page-header-icon">
            <i class="fas fa-user-edit text-white"></i>
        </div>
        <div class="page-header-content">
            <h1 class="page-title">
                Редактирование профиля
            </h1>
            <p class="page-subtitle">Обновите информацию о себе</p>
        </div>
    </div>

    <!-- ОДНА ФОРМА ДЛЯ ВСЕГО -->
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="row">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CurrentAvatarPath" />

        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <!-- Контейнер для аватара -->
                    <div class="avatar-upload-container mb-3">
                        <!-- Текущий аватар или инициалы -->
                        <div id="currentAvatarContainer">
                            @if (!string.IsNullOrEmpty(Model.CurrentAvatarPath))
                            {
                                <img src="@Model.CurrentAvatarPath" class="avatar-image" alt="Avatar" id="currentAvatar" />
                            }
                            else
                            {
                                <div class="avatar-circle-lg">
                                    <div class="avatar-initials-lg">
                                        @(Model.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "")@(Model.LastName?.Length > 0 ? Model.LastName[0].ToString().ToUpper() : "")
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Предпросмотр нового аватара (изначально скрыт) -->
                        <div id="avatarPreviewContainer" style="display: none;">
                            <img id="previewImage" src="#" alt="Preview" class="avatar-image preview-avatar" />
                            <div class="preview-badge">
                                <i class="fas fa-check-circle"></i> Новое фото
                            </div>
                        </div>

                        <!-- Кнопка загрузки -->
                        <label for="avatarInput" class="avatar-upload-btn" title="Загрузить новое фото">
                            <i class="fas fa-camera"></i>
                        </label>
                        <input type="file" id="avatarInput" name="Avatar" accept="image/*" style="display: none;" />
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CurrentAvatarPath))
                    {
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="RemoveAvatar" name="RemoveAvatar" value="true">
                            <label class="form-check-label small" for="RemoveAvatar">
                                <i class="fas fa-trash-alt me-1"></i>Удалить текущее фото
                            </label>
                        </div>
                    }

                    <p class="text-muted small mb-0 mt-2">
                        <i class="fas fa-info-circle me-1"></i>
                        Поддерживаемые форматы: JPG, PNG, GIF<br>
                        Макс. размер: 2 MB
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="section-subtitle mb-0">
                        <i class="fas fa-info-circle text-primary me-2"></i>
                        Основная информация
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4 mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold">
                                Фамилия <span class="text-danger">*</span>
                            </label>
                            <input asp-for="LastName" class="form-control form-control-lg"
                                   maxlength="100" placeholder="Иванов" />  <!-- Было 50, стало 100 -->
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                            <small class="text-muted" id="lastNameCounter">0/100</small>  <!-- Было 0/50, стало 0/100 -->
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold">
                                Имя <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FirstName" class="form-control form-control-lg"
                                   maxlength="100" placeholder="Иван" />  <!-- Было 50, стало 100 -->
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                            <small class="text-muted" id="firstNameCounter">0/100</small>  <!-- Было 0/50, стало 0/100 -->
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="MiddleName" class="form-label fw-semibold">
                                Отчество
                            </label>
                            <input asp-for="MiddleName" class="form-control form-control-lg"
                                   maxlength="100" placeholder="Иванович" />  <!-- Было 50, стало 100 -->
                            <span asp-validation-for="MiddleName" class="text-danger small"></span>
                            <small class="text-muted" id="middleNameCounter">0/100</small>  <!-- Было 0/50, стало 0/100 -->
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" class="form-control form-control-lg"
                                   type="email" maxlength="255" placeholder="example@mail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <small class="text-muted" id="emailCounter">0/255</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Age" class="form-label fw-semibold">
                                Возраст
                            </label>
                            <input asp-for="Age" type="number" class="form-control form-control-lg"
                                   min="1" max="120" step="1" placeholder="25" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                            <small class="text-muted">от 1 до 120 лет</small>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-0 py-3 px-4">
                    <div class="d-flex flex-wrap justify-content-between gap-3">
                        <a asp-action="Profile" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Назад
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="fas fa-save me-2"></i>Сохранить изменения
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
