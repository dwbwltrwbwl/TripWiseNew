            const handleResize = () => {
                if (modalTitle && doc.name) {
                    const newMaxLength = window.innerWidth < 768 ? 40 : 80;
                    const newDisplayName = doc.name.length > newMaxLength ? doc.name.substring(0, newMaxLength - 3) + '...' : doc.name;
                    modalTitle.textContent = newDisplayName;
                }
            };

            // Удаляем предыдущий обработчик, если он был
            window.removeEventListener('resize', handleResize);
            window.addEventListener('resize', handleResize);

            // Сохраняем обработчик для удаления при закрытии модального окна
            modal._element.addEventListener('hidden.bs.modal', function() {
                window.removeEventListener('resize', handleResize);
