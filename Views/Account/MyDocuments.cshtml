    async function moveDocument() {
        const folderSelect = document.getElementById('moveToFolderSelect');
        const newFolderId = folderSelect?.value ? parseInt(folderSelect.value) : null;

        if (!moveDocumentId) {
            showNotification('Ошибка: документ не выбран', 'danger');
            return;
        }

        // Показываем индикатор загрузки
        const moveBtn = document.querySelector('#moveDocumentModal .btn-primary');
        const originalText = moveBtn?.innerHTML;
        if (moveBtn) {
            moveBtn.disabled = true;
            moveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Перемещение...';
        }

        try {
            const response = await fetch('/Documents/MoveDocument', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ documentId: moveDocumentId, folderId: newFolderId })
            });

            // Проверяем статус ответа
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('moveDocumentModal'));
                if (modal) modal.hide();
                await loadDocuments();
                await loadFolders();
                showNotification(`Документ перемещен${newFolderId ? ' в папку' : ''}`, 'success');
            } else {
                showNotification(result.message || 'Ошибка при перемещении документа', 'danger');
            }
        } catch (error) {
            console.error('Ошибка перемещения:', error);
            showNotification('Произошла ошибка при перемещении документа. Проверьте подключение к серверу.', 'danger');
        } finally {
            if (moveBtn) {
                moveBtn.disabled = false;
                moveBtn.innerHTML = originalText;
            }
        }
    }

