    async function uploadDocument() {
        const form = document.getElementById('uploadDocumentForm');
        if (!form) return;

        const nameInput = document.querySelector('input[name="name"]');
        const fileInput = document.querySelector('input[name="file"]');
        const descriptionInput = document.querySelector('textarea[name="description"]');
        const numberInput = document.querySelector('input[name="documentNumber"]');
        const dateInput = document.querySelector('input[name="documentDate"]');
        const submitBtn = event?.target;

        const name = nameInput?.value.trim() || '';
        const file = fileInput?.files[0];
        const description = descriptionInput?.value || '';
        const docNumber = numberInput?.value || '';
        const docDate = dateInput?.value;

        // Валидация
        if (!name) { showNotification('Введите название документа', 'warning'); return; }
        if (name.length > 255) { showNotification('Название документа не может превышать 255 символов', 'warning'); return; }
        if (name.length < 2) { showNotification('Название документа должно содержать минимум 2 символа', 'warning'); return; }
        if (!file) { showNotification('Выберите файл для загрузки', 'warning'); return; }
        if (file.size > 10 * 1024 * 1024) { showNotification('Размер файла не должен превышать 10 МБ', 'warning'); return; }
        if (description.length > 500) { showNotification('Описание не может превышать 500 символов', 'warning'); return; }
        if (docNumber.length > 100) { showNotification('Номер документа не может превышать 100 символов', 'warning'); return; }
            if (docDate) {
        const selectedDate = new Date(docDate);
        const todayDate = new Date();

        // Сбрасываем время у обеих дат для корректного сравнения
        selectedDate.setHours(0, 0, 0, 0);
        todayDate.setHours(0, 0, 0, 0);

        if (selectedDate > todayDate) {
            showNotification('Дата документа не может быть в будущем', 'warning');
            return;
        }
    }

        const formData = new FormData(form);

        if (submitBtn) {
            submitBtn.disabled = true;
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Загрузка...';

            try {
                const response = await fetch('/Documents/UploadDocument', {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });

                const result = await response.json();
                if (result.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('uploadDocumentModal'));
                    if (modal) modal.hide();
                    form.reset();
                    // Восстанавливаем дату по умолчанию
                    const todayInput = document.querySelector('input[name="documentDate"]');
                    if (todayInput) todayInput.value = new Date().toISOString().split('T')[0];
                    await loadDocuments();
                    await loadFolders();
                    showNotification('Документ успешно загружен', 'success');
                } else {
                    showNotification(result.message || 'Ошибка при загрузке', 'danger');
                }
            } catch (error) {
                console.error('Ошибка загрузки:', error);
                showNotification('Произошла ошибка при загрузке', 'danger');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }
    }

