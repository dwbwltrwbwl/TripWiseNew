        const documentId = document.getElementById('deleteDocumentBtn')?.dataset.documentId;
        if (!documentId) return;

        try {
            const response = await fetch(`/Documents/DeleteDocument`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ id: parseInt(documentId) }) // Передаем id в теле
            });

            const result = await response.json();
            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('viewDocumentModal'));
                if (modal) modal.hide();
                await loadDocuments();
                await loadFolders();
                showNotification('Документ удален', 'success');
            } else {
                showNotification(result.message || 'Ошибка при удалении', 'danger');
            }
        } catch (error) {
            console.error('Ошибка удаления:', error);
            showNotification('Произошла ошибка при удалении документа', 'danger');
        }
    }

    // ==================== ВСПОМОГАТЕЛЬНЫЕ ====================
    function selectFolder(folderId, element) {
        document.querySelectorAll('.folder-item').forEach(el => el.classList.remove('active'));
        if (element) element.classList.add('active');
        currentFolderId = folderId;
        updateCurrentFolderTitle();
        loadDocuments();
    }

    function updateCurrentFolderTitle() {
        const titleEl = document.getElementById('currentFolderTitle');
        if (!titleEl) return;
        const activeFolder = document.querySelector('.folder-item.active .folder-name');
        titleEl.innerHTML = activeFolder ? `<i class="fas fa-folder text-primary me-2"></i>${activeFolder.textContent}` : `<i class="fas fa-files text-primary me-2"></i>Все документы`;
    }

    function openUploadModal() {
        loadFolderOptions();
        new bootstrap.Modal(document.getElementById('uploadDocumentModal')).show();
    }

    function getFileIcon(type) {
        const t = (type || '').toLowerCase();
        if (t === 'pdf' || t === 'application/pdf') return 'file-pdf';
        if (t === 'doc' || t === 'docx' || t === 'application/msword') return 'file-word';
        if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'image/jpeg', 'image/png'].includes(t)) return 'file-image';
        if (t === 'txt' || t === 'text/plain') return 'file-alt';
        if (t === 'xls' || t === 'xlsx') return 'file-excel';
        return 'file-alt';
    }

    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function getDocumentWord(count) {
        if (count % 10 === 1 && count % 100 !== 11) return 'документ';
        if ([2, 3, 4].includes(count % 10) && ![12, 13, 14].includes(count % 100)) return 'документа';
        return 'документов';
    }

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        notification.style.cssText = 'top:20px; right:20px; z-index:9999; min-width:280px; max-width:350px;';
        notification.innerHTML = `<div class="d-flex align-items-center"><i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i><div class="flex-grow-1">${message}</div><button type="button" class="btn-close ms-2" data-bs-dismiss="alert"></button></div>`;
        document.body.appendChild(notification);
        setTimeout(() => notification.remove(), 5000);
    }
</script>