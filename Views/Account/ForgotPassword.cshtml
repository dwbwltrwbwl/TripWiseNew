@{
    ViewData["Title"] = "Восстановление пароля";
}
<div class="mobile-header-spacer d-block d-lg-none" style="height: 70px;"></div>
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Шапка страницы (единый дизайн для всех устройств) -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-key text-white"></i>
                </div>
                <div class="page-header-content">
                    <h1 class="page-title">
                        Восстановление пароля
                    </h1>
                    <p class="page-subtitle">Мы поможем вам восстановить доступ к аккаунту</p>
                </div>
            </div>

            <!-- Шаг 1: Ввод email -->
            <div id="step1" class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-envelope text-primary me-2"></i>
                        Шаг 1: Введите email
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form id="emailForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold">
                                <i class="fas fa-at me-2"></i>Email адрес
                            </label>
                            <input type="email" class="form-control form-control-lg" id="email"
                                   name="email" required placeholder="ваш@email.com" maxlength="255">
                            <div class="mt-2">
                                <small class="text-muted">
                                    На этот email будет отправлен код подтверждения
                                </small>
                            </div>
                            <div id="emailError" class="text-danger d-none mt-2">
                                <i class="fas fa-exclamation-circle me-1"></i>
                                <span id="emailErrorMessage"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <a asp-action="Login" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Вернуться ко входу
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg" id="sendCodeBtn">
                                Отправить код
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Шаг 2: Ввод кода подтверждения -->
            <div id="step2" class="card border-0 shadow-sm d-none">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-shield-alt text-primary me-2"></i>
                        Шаг 2: Подтверждение по email
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-success border-0 rounded-lg mb-4">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-check-circle fa-2x text-success me-3 flex-shrink-0 mt-1"></i>
                            <div>
                                <h6 class="alert-heading mb-2">Код отправлен на ваш email</h6>
                                <p class="mb-0 small" id="emailDisplay"></p>
                                <p class="mb-0 small text-muted mt-1">
                                    Проверьте папку "Входящие" или "Спам"
                                </p>
                            </div>
                        </div>
                    </div>

                    <form id="codeForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="hiddenEmail" name="email" value="">

                        <div class="mb-4">
                            <label for="verificationCode" class="form-label fw-semibold">
                                <i class="fas fa-key me-2"></i>Код подтверждения
                            </label>
                            <input type="text" class="form-control form-control-lg text-center code-input"
                                   id="verificationCode" maxlength="6" required
                                   placeholder="Введите 6-значный код"
                                   autocomplete="off">
                            <div class="mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <small id="codeTimer" class="text-muted">
                                    <i class="far fa-clock me-1"></i>Код действителен: <span id="timer">15:00</span>
                                </small>
                                <div>
                                    <button type="button" class="btn btn-link p-0" id="resendCodeBtn" disabled>
                                        Отправить код повторно (<span id="resendTimer">60</span>)
                                    </button>
                                </div>
                            </div>
                            <div id="codeError" class="text-danger d-none mt-2">
                                <i class="fas fa-exclamation-circle me-1"></i>
                                <span id="codeErrorMessage"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <button type="button" class="btn btn-outline-secondary" id="backToStep1Btn">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg" id="verifyCodeBtn" disabled>
                                <i class="fas fa-check me-2"></i>Подтвердить код
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Шаг 3: Новый пароль -->
            <div id="step3" class="card border-0 shadow-sm d-none">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-lock text-primary me-2"></i>
                        Шаг 3: Установка нового пароля
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form id="newPasswordForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="resetEmail" name="email" value="">

                        <!-- Новый пароль -->
                        <div class="mb-4">
                            <label for="newPassword" class="form-label fw-semibold">
                                <i class="fas fa-key me-2"></i>Новый пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="newPassword"
                                       name="newPassword" required placeholder="Введите новый пароль"
                                       maxlength="50" minlength="6">
                                <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="password-strength mt-2">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" id="passwordStrengthBar" style="width: 0%"></div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <small class="text-muted" id="passwordStrengthText">Начните вводить пароль</small>
                                    <small class="text-muted" id="charCounter">0/50</small>
                                </div>
                            </div>

                            <!-- Требования к паролю -->
                            <div id="passwordRequirements" class="mt-2 p-3 bg-light rounded-3">
                                <small class="text-muted fw-semibold">Пароль должен содержать:</small>
                                <div class="row mt-2 g-2">
                                    <div class="col-md-6">
                                        <ul class="list-unstyled mb-0">
                                            <li id="reqLength" class="text-danger small">
                                                <i class="fas fa-times me-1"></i>Минимум 6 символов
                                            </li>
                                            <li id="reqMaxLength" class="text-success small">
                                                <i class="fas fa-check me-1"></i>Максимум 50 символов
                                            </li>
                                            <li id="reqUppercase" class="text-danger small">
                                                <i class="fas fa-times me-1"></i>Одну заглавную букву (A-Z)
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <ul class="list-unstyled mb-0">
                                            <li id="reqLowercase" class="text-danger small">
                                                <i class="fas fa-times me-1"></i>Одну строчную букву (a-z)
                                            </li>
                                            <li id="reqSpecial" class="text-danger small">
                                                <i class="fas fa-times me-1"></i>Один спецсимвол (!@@#$%^&*)
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Подтверждение пароля -->
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label fw-semibold">
                                <i class="fas fa-check-circle me-2"></i>Подтвердите новый пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="confirmPassword"
                                       required placeholder="Повторите новый пароль" maxlength="50">
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="mt-2">
                                <small id="passwordMatch" class="text-danger d-none">
                                    <i class="fas fa-times me-1"></i>Пароли не совпадают
                                </small>
                                <small id="passwordSuccess" class="text-success d-none">
                                    <i class="fas fa-check me-1"></i>Пароли совпадают
                                </small>
                            </div>
                        </div>

                        <!-- Рекомендации -->
                        <div class="alert alert-info border-0 rounded-lg mb-4">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-lightbulb fa-2x text-info me-3 flex-shrink-0"></i>
                                <div>
                                    <h6 class="alert-heading mb-2">Рекомендации по безопасности</h6>
                                    <ul class="mb-0 small ps-3">
                                        <li>Используйте уникальный пароль, который не применяется на других сайтах</li>
                                        <li>Используйте сочетание заглавных, строчных букв, цифр и спецсимволов</li>
                                        <li>Регулярно обновляйте пароль для повышения безопасности</li>
                                        <li>Не сообщайте пароль третьим лицам</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <button type="button" class="btn btn-outline-secondary" id="backToStep2Btn">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </button>
                            <button type="submit" class="btn btn-success btn-lg" id="resetPasswordBtn" disabled>
                                <i class="fas fa-save me-2"></i>Сохранить новый пароль
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Шаг 4: Успех -->
            <div id="step4" class="card border-0 shadow-sm d-none">
                <div class="card-body p-5 text-center">
                    <div class="display-1 text-success mb-4">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h2 class="h3 mb-3">Пароль успешно изменен!</h2>
                    <p class="text-muted mb-4">
                        Теперь вы можете войти в аккаунт с новым паролем
                    </p>
                    <a asp-action="Login" class="btn btn-primary btn-lg">
                        <i class="fas fa-sign-in-alt me-2"></i>Войти в аккаунт
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

    .page-header-content {
        flex: 1;
        min-width: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
        word-break: break-word;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        line-height: 1.4;
        word-break: break-word;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

    .form-control-lg {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 14px 18px;
        font-family: 'Nunito', sans-serif;
    }

        .form-control-lg:focus {
            border-color: #0379D9;
            box-shadow: 0 0 0 0.2rem rgba(3, 121, 217, 0.25);
        }

    .code-input {
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 10px;
        font-family: monospace;
        text-align: center;
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
        padding: 12px 24px;
    }

    .btn-primary {
        background: #0379D9;
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
    }

        .btn-primary:hover {
            background: #0356a8;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
        }

        .btn-primary:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .btn-success {
        background: #40B624;
        border: none;
        box-shadow: 0 4px 12px rgba(64, 182, 36, 0.2);
    }

        .btn-success:hover {
            background: #33991b;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(64, 182, 36, 0.3);
        }

        .btn-success:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .btn-outline-secondary {
        border: 2px solid #e2e8f0;
        color: #64748b;
        background: white;
    }

        .btn-outline-secondary:hover {
            background: #f8fafc;
            border-color: #94a3b8;
            color: #334155;
            transform: translateY(-2px);
        }

    .btn-lg {
        padding: 14px 30px;
        font-size: 1.1rem;
    }

    #timer {
        color: #d32f2f;
        font-weight: bold;
    }

    #resendTimer {
        color: #0379D9;
        font-weight: bold;
    }

    #passwordRequirements li.valid {
        color: #198754;
    }

        #passwordRequirements li.valid i {
            color: #198754;
        }

    .alert {
        border-radius: 12px;
    }

    .alert-success {
        background-color: #d1e7dd;
        border-color: #badbcc;
        color: #0f5132;
    }

    .alert-info {
        background-color: #e8f4fe;
        border-color: #b6d4fe;
        color: #084298;
    }

    .bg-light {
        background-color: #f8fafc !important;
    }

    .rounded-3 {
        border-radius: 12px !important;
    }

    /* Мобильная адаптация */
    @@media (max-width: 768px) {
        .page-header-section {
            padding: 20px;
            gap: 15px;
        }

            .page-header-section::before {
                width: 100%;
                height: 6px;
                top: 0;
                left: 0;
                background: linear-gradient(to right, #0379D9, #40B624);
            }

        .page-header-icon {
            width: 55px;
            height: 55px;
            font-size: 1.5rem;
        }

        .page-title {
            font-size: 1.6rem;
            margin-bottom: 4px;
        }

        .page-subtitle {
            font-size: 0.95rem;
        }

        .section-subtitle {
            font-size: 1.2rem;
        }

        .code-input {
            font-size: 20px;
            letter-spacing: 6px;
        }

        .btn {
            width: 100%;
        }

        .btn-lg {
            padding: 12px 20px;
            font-size: 1rem;
        }

        .d-flex.flex-wrap {
            flex-direction: column;
        }

            .d-flex.flex-wrap .btn {
                width: 100%;
            }

        .card-body {
            padding: 20px !important;
        }
    }

    @@media (max-width: 576px) {
        .page-header-section {
            padding: 15px;
            gap: 12px;
        }

        .page-header-icon {
            width: 48px;
            height: 48px;
            font-size: 1.3rem;
        }

        .page-title {
            font-size: 1.4rem;
        }

        .page-subtitle {
            font-size: 0.85rem;
        }

        .section-subtitle {
            font-size: 1.1rem;
        }

        .code-input {
            font-size: 16px;
            letter-spacing: 4px;
        }

        .form-control-lg {
            padding: 10px 14px;
            font-size: 0.95rem;
        }

        .alert .d-flex {
            flex-direction: column;
            text-align: center;
        }

            .alert .d-flex i {
                margin-bottom: 10px;
            }

        #passwordRequirements .row {
            display: block;
        }

        #passwordRequirements .col-md-6 {
            width: 100%;
        }
    }
    @@media (max-width: 768px) {
        .input-group

    {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        align-items: center !important;
        width: 100%;
    }

    .input-group-text {
        display: flex !important;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .input-group .form-control {
        display: block !important;
        flex: 1 1 auto !important;
        width: 100% !important;
        min-width: 0 !important;
    }

    .input-group > * {
        margin: 0 !important;
    }

    }
</style>

@section Scripts {
    <script src="~/js/account-forgot-password.js"></script>
}